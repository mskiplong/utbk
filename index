function buildRekap(){
  const db=getDB();const rawData=db.rawData||[];
  if(!rawData.length){toast('Belum ada data! Upload file terlebih dahulu.','warning');return;}
  const map={};
  rawData.forEach(row=>{
    const va=String(row.no_rek_va||'').trim();const sk=String(row.kode_satker||'').trim();
    const key=`${row._bank}|${row._year}|${row._month}|${va||sk||row._id}`;
    if(!map[key]){map[key]={_bank:row._bank,_year:row._year,_month:row._month,
      kode_ba:'',nama_ba:'',kode_eselon:'',nama_eselon:'',kode_kanwil:'',kode_kppn:'',
      kode_satker:'',nama_satker:'',no_rek_induk:'',nama_rek_induk:'',
      no_rek_va:'',nama_rek_va:'',saldo_va:0,
      jml_cms:0,nilai_cms:0,jml_debit:0,nilai_debit:0,jml_teller:0,nilai_teller:0,status:''};}
    const r=map[key];
    FIELDS.forEach(f=>{
      if(f.type==='number'){if(f.key==='saldo_va'){if(pN(row[f.key])>0)r[f.key]=pN(row[f.key]);}else r[f.key]+=pN(row[f.key]);}
      else{if(!r[f.key]&&row[f.key])r[f.key]=String(row[f.key]).trim();}
    });
  });
  G.rekapData=Object.values(map).filter(r=>r.no_rek_va||r.kode_satker);
  G.rekapData.sort((a,b)=>String(a._bank).localeCompare(String(b._bank))||String(a._year).localeCompare(String(b._year))||String(a._month).localeCompare(String(b._month)));
  G.rekapDisp=[...G.rekapData];G.rPage=1;
  const db2=getDB();db2.rekap=G.rekapData;setDB(db2);
  refreshRekapFilters();renderRekap();
  toast(`Rekap berhasil! ${G.rekapData.length} baris.`,'success');
}

