<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Monitoring Deviasi Halaman III DIPA Satker</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script>
window.__SAMPLE__=[];
</script>
<style>
:root{
  --brand:#0d9488; --brand2:#0f766e; --brand-soft:#ccfbf1;
  --green:#059669; --green-bg:#d1fae5; --green-ink:#065f46;
  --amber:#d97706; --amber-bg:#fef3c7; --amber-ink:#92400e;
  --red:#dc2626;   --red-bg:#fee2e2;   --red-ink:#991b1b;
  --slate:#64748b;
  --bg:#f0fdfa; --panel:#ffffff; --panel-2:#f6fbfa;
  --ink:#0f172a; --ink-2:#475569; --muted:#94a3b8;
  --line:#e3eeec;
  --radius:18px; --radius-sm:12px;
  --shadow-sm:0 1px 3px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04);
  --shadow:0 12px 28px -8px rgba(15,23,42,.16), 0 4px 10px -4px rgba(15,23,42,.08);
  --shadow-lg:0 28px 60px -16px rgba(13,148,136,.30);
  --grad:linear-gradient(135deg,#0d9488 0%,#0891b2 55%,#0ea5e9 130%);
  --t:.25s cubic-bezier(.4,0,.2,1);
}
html[data-theme="dark"]{
  --bg:#04130f; --panel:#0c1a18; --panel-2:#0a1513;
  --ink:#f1f5f9; --ink-2:#cbd5e1; --muted:#64748b;
  --line:#16302b; --brand-soft:#053b34;
  --green-bg:#052e22; --amber-bg:#3a2a06; --red-bg:#3a0d0d;
  --green-ink:#6ee7b7; --amber-ink:#fcd34d; --red-ink:#fca5a5;
  --shadow:0 12px 30px -10px rgba(0,0,0,.6); --shadow-sm:0 1px 3px rgba(0,0,0,.4);
}
*{box-sizing:border-box} html,body{margin:0;padding:0}
body{font-family:'Inter','Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif;
  background:var(--bg);color:var(--ink);min-height:100vh;line-height:1.5;
  -webkit-font-smoothing:antialiased;transition:background var(--t),color var(--t);}
::selection{background:rgba(13,148,136,.25)}
*::-webkit-scrollbar{height:10px;width:10px}
*::-webkit-scrollbar-thumb{background:var(--line);border-radius:99px}
*::-webkit-scrollbar-thumb:hover{background:var(--muted)}

.topbar{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--panel) 82%,transparent);
  backdrop-filter:saturate(180%) blur(14px);border-bottom:1px solid var(--line);}
.topbar .inner{max-width:1500px;margin:0 auto;padding:12px 18px;display:flex;align-items:center;gap:14px}
.logo{display:flex;align-items:center;gap:11px;font-weight:800;letter-spacing:-.3px}
.logo .mark{width:38px;height:38px;border-radius:11px;background:var(--grad);color:#fff;display:grid;place-items:center;font-size:19px;box-shadow:var(--shadow-lg);}
.logo .txt small{display:block;font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.5px}
.logo .txt b{font-size:16px;display:block;line-height:1.1}
.spacer{flex:1}
.icon-btn{width:40px;height:40px;border-radius:11px;border:1px solid var(--line);background:var(--panel);cursor:pointer;display:grid;place-items:center;font-size:17px;transition:var(--t);color:var(--ink);}
.icon-btn:hover{background:var(--brand-soft);border-color:var(--brand);transform:translateY(-1px)}

.wrap{max-width:1500px;margin:0 auto;padding:22px 18px 70px}
.section{margin-bottom:22px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:22px;transition:var(--t);}
.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.card-head h2{margin:0;font-size:17px;font-weight:800;letter-spacing:-.3px;display:flex;align-items:center;gap:9px}
.card-head .desc{font-size:13px;color:var(--muted);margin-top:3px;max-width:720px}
.card-head .actions{display:flex;gap:9px;flex-wrap:wrap}
.eyebrow{font-size:11px;font-weight:800;letter-spacing:1.4px;color:var(--brand);text-transform:uppercase}

.hero{position:relative;overflow:hidden;border-radius:var(--radius);background:var(--grad);color:#fff;padding:30px 34px;box-shadow:var(--shadow-lg);display:flex;align-items:center;gap:26px;flex-wrap:wrap;}
.hero::after{content:"";position:absolute;inset:0;background:radial-gradient(600px 200px at 90% -10%,rgba(255,255,255,.22),transparent 60%),radial-gradient(400px 300px at 0% 120%,rgba(14,165,233,.4),transparent 60%);pointer-events:none}
.hero-main{position:relative;flex:1;min-width:280px}
.hero h1{margin:0 0 8px;font-size:clamp(22px,4vw,30px);font-weight:900;letter-spacing:-.8px}
.hero p{margin:0;max-width:620px;color:rgba(255,255,255,.9);font-size:14px}
.hero .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.hero .chips span{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.25);padding:5px 12px;border-radius:99px;font-size:12px;font-weight:600;backdrop-filter:blur(4px)}
.hero-upload{position:relative;flex:0 0 320px;max-width:360px;width:100%;border:2px dashed rgba(255,255,255,.6);border-radius:16px;background:rgba(255,255,255,.10);padding:24px 20px;text-align:center;cursor:pointer;transition:var(--t);color:#fff;}
@media(max-width:760px){.hero-upload{flex:1 1 100%;max-width:none}}
.hero-upload:hover,.hero-upload.drag{background:rgba(255,255,255,.22);border-color:#fff;transform:translateY(-2px)}
.hero-upload.loaded{background:rgba(16,185,129,.25);border-color:rgba(167,243,208,.9);border-style:solid}
.hero-upload .hu-ic{font-size:40px;line-height:1}
.hero-upload .hu-t1{font-weight:800;margin-top:8px;font-size:15px}
.hero-upload .hu-t2{font-size:12px;color:rgba(255,255,255,.85);margin-top:4px}
.hero-upload u{font-weight:800;text-underline-offset:2px}
.hero-upload .hu-actions{margin-top:12px;display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.mini-btn{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.35);color:#fff;font-weight:700;font-size:11.5px;padding:6px 11px;border-radius:9px;cursor:pointer;transition:var(--t)}
.mini-btn:hover{background:rgba(255,255,255,.35)}
#fileInput{display:none}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}
.stat{position:relative;overflow:hidden;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-sm);padding:16px;box-shadow:var(--shadow-sm);transition:var(--t);animation:rise .5s both;}
.stat:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.stat .ic{width:36px;height:36px;border-radius:11px;display:grid;place-items:center;font-size:17px}
.stat .n{font-size:26px;font-weight:900;letter-spacing:-1px;margin-top:9px;line-height:1}
.stat .l{font-size:12px;color:var(--muted);margin-top:3px;font-weight:600}
.stat .strip{position:absolute;left:0;top:0;bottom:0;width:5px}
.stat.s-total .ic{background:var(--brand-soft);color:var(--brand)}.stat.s-total .strip{background:var(--brand)}
.stat.s-award .ic{background:var(--green-bg);color:var(--green)}.stat.s-award .strip{background:var(--green)}.stat.s-award .n{color:var(--green)}
.stat.s-mid .ic{background:var(--amber-bg);color:var(--amber)}.stat.s-mid .strip{background:var(--amber)}.stat.s-mid .n{color:var(--amber)}
.stat.s-warn .ic{background:var(--red-bg);color:var(--red)}.stat.s-warn .strip{background:var(--red)}.stat.s-warn .n{color:var(--red)}
.stat.s-cyan .ic{background:#cffafe;color:#0891b2}.stat.s-cyan .strip{background:#0891b2}.stat.s-cyan .n{color:#0891b2}

.rekap{position:relative;overflow:hidden;border-radius:var(--radius);color:#fff;background:linear-gradient(120deg,#134e4a 0%,#0d9488 55%,#0369a1 130%);box-shadow:var(--shadow-lg);padding:22px 24px;animation:rise .45s both}
.rekap::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(520px 180px at 95% -20%,rgba(255,255,255,.22),transparent 60%),radial-gradient(420px 260px at -5% 130%,rgba(14,165,233,.4),transparent 60%)}
.rekap-head{position:relative;margin-bottom:16px}
.rekap-head h2{margin:2px 0 0;font-size:18px;font-weight:900;letter-spacing:-.4px}
.rekap-grid{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:900px){.rekap-grid{grid-template-columns:1fr 1fr}}
@media(max-width:460px){.rekap-grid{grid-template-columns:1fr}}
.rekap .rk{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:14px;padding:15px 17px;backdrop-filter:blur(6px);display:flex;flex-direction:column;gap:3px}
.rekap .rk-l{font-size:12px;font-weight:700;color:rgba(255,255,255,.92)}
.rekap .rk-v{font-size:clamp(16px,2.2vw,21px);font-weight:900;letter-spacing:-.6px;line-height:1.15;word-break:break-word}
.rekap .rk-s{font-size:11px;color:rgba(255,255,255,.78);font-weight:600}

.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}
.field label{font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;display:block;margin-bottom:6px}
select,input[type=search]{width:100%;padding:11px 13px;border:1.5px solid var(--line);border-radius:11px;font-size:14px;background:var(--panel);color:var(--ink);transition:var(--t);font-family:inherit;}
select:focus,input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 4px rgba(13,148,136,.14)}
.search-box{position:relative}
.search-box svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted)}
.search-box input{padding-left:38px}

.btn{border:none;border-radius:11px;padding:11px 16px;font-size:13.5px;font-weight:800;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:var(--t);font-family:inherit;white-space:nowrap}
.btn-primary{background:var(--grad);color:#fff;box-shadow:0 6px 16px -4px rgba(13,148,136,.5)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 22px -6px rgba(13,148,136,.6)}
.btn-soft{background:var(--brand-soft);color:var(--brand)}
.btn-soft:hover{background:var(--brand);color:#fff;transform:translateY(-2px)}
.btn-ghost{background:var(--panel-2);color:var(--ink-2);border:1px solid var(--line)}
.btn-ghost:hover{border-color:var(--brand);color:var(--brand)}

.maintabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.maintabs button{border:1px solid var(--line);background:var(--panel);color:var(--ink-2);padding:11px 16px;border-radius:12px;font-weight:800;font-size:13px;cursor:pointer;transition:var(--t);display:inline-flex;align-items:center;gap:8px}
.maintabs button:hover{border-color:var(--brand);color:var(--brand)}
.maintabs button.active{background:var(--grad);color:#fff;border-color:transparent;box-shadow:0 6px 16px -6px rgba(13,148,136,.6)}
.maintabs .cnt{background:rgba(0,0,0,.12);padding:1px 8px;border-radius:99px;font-size:11.5px}
.maintabs button.active .cnt{background:rgba(255,255,255,.25)}

.tablewrap{overflow-x:auto;border-radius:14px;border:1px solid var(--line)}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:12px;min-width:1500px}
thead th{background:var(--panel-2);color:var(--ink-2);padding:10px 8px;text-align:left;font-weight:800;font-size:10px;letter-spacing:.2px;text-transform:uppercase;position:sticky;top:0;white-space:nowrap;border-bottom:2px solid var(--line);}
thead th.grp{text-align:center;border-left:2px solid var(--line)}
thead tr:nth-child(2) th{font-size:9.5px}
tbody td{padding:8px;border-bottom:1px solid var(--line);vertical-align:middle}
tbody td.gl{border-left:2px solid var(--line)}
tbody tr{transition:background var(--t)} tbody tr:hover{background:var(--brand-soft)}
tbody tr:last-child td{border-bottom:none}
tfoot td{padding:10px 8px;font-weight:900;background:var(--panel-2);border-top:2px solid var(--line);font-size:12px}
tfoot td.gl{border-left:2px solid var(--line)}
.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.kode{font-family:ui-monospace,'JetBrains Mono','Courier New',monospace;font-weight:800;background:var(--panel-2);padding:3px 7px;border-radius:7px;font-size:11.5px;border:1px solid var(--line)}
.satker-name{font-weight:600;min-width:180px}
.rankpos{width:26px;height:26px;border-radius:8px;display:grid;place-items:center;font-weight:900;font-size:12px;background:var(--brand-soft);color:var(--brand)}
.rankpos.p1{background:#fef9c3;color:#a16207}.rankpos.p2{background:#e2e8f0;color:#475569}.rankpos.p3{background:#ffedd5;color:#9a3412}
.badge{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;border-radius:99px;font-size:11px;font-weight:800;white-space:nowrap}
.b-green{background:var(--green-bg);color:var(--green-ink)}
.b-amber{background:var(--amber-bg);color:var(--amber-ink)}
.b-red{background:var(--red-bg);color:var(--red-ink)}
.b-slate{background:var(--panel-2);color:var(--muted);border:1px solid var(--line)}
.b-cyan{background:#cffafe;color:#0e7490}
.dev-cell{font-weight:800;font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
.dev-green{color:var(--green)}.dev-amber{color:var(--amber)}.dev-red{color:var(--red)}
.tgt{color:var(--ink-2)} .rls{color:var(--ink)}
.legend{display:flex;flex-wrap:wrap;gap:16px;font-size:12px;color:var(--muted);margin-top:16px;font-weight:600}
.legend span{display:inline-flex;align-items:center;gap:7px}
.dot{width:11px;height:11px;border-radius:4px}
.note{font-size:11.5px;color:var(--muted);background:var(--panel-2);border:1px dashed var(--line);padding:10px 13px;border-radius:11px;margin-top:14px}
.alert{padding:13px 15px;border-radius:12px;font-size:13.5px;margin-top:14px;display:flex;gap:10px;align-items:flex-start;font-weight:600}
.alert.ok{background:var(--green-bg);color:var(--green-ink)}
.alert.err{background:var(--red-bg);color:var(--red-ink)}
.empty{text-align:center;padding:60px 20px;color:var(--muted)}
.empty .e-ic{font-size:54px;opacity:.5}
.empty h3{margin:14px 0 6px;color:var(--ink-2);font-size:18px}
footer{text-align:center;color:var(--muted);font-size:12px;padding:24px 10px;font-weight:600}
.hidden{display:none!important}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.stat:nth-child(2){animation-delay:.05s}.stat:nth-child(3){animation-delay:.1s}.stat:nth-child(4){animation-delay:.15s}.stat:nth-child(5){animation-delay:.2s}
.fade{animation:rise .4s both}
.subtle{color:var(--muted);font-size:11px}
@media(max-width:600px){.card{padding:16px}.hero{padding:24px}}
</style>
</head>
<body>

<div class="topbar"><div class="inner">
  <div class="logo"><div class="mark">📊</div><div class="txt"><small>MONITORING RPD HALAMAN III DIPA</small><b>Deviasi Penyerapan Satker</b></div></div>
  <div class="spacer"></div>
  <button class="icon-btn" id="themeBtn" title="Ganti tema">🌙</button>
</div></div>

<div class="wrap">

  <!-- HERO + UPLOAD -->
  <section class="section">
    <div class="hero">
      <div class="hero-main">
        <div class="eyebrow" style="color:rgba(255,255,255,.85)">Halaman III DIPA — Rencana Penarikan Dana</div>
        <h1>Monitoring Deviasi Penyerapan Anggaran Satker</h1>
        <p>Unggah file Excel/CSV monitoring RPD Halaman III DIPA. Sistem membandingkan <b>Target Rencana</b> vs <b>Realisasi Penyerapan</b> per jenis belanja (51, 52, 53, 57), menghitung deviasi, dan menyusun peringkat satker. Mengunggah file baru akan mengganti data sebelumnya.</p>
        <div class="chips"><span>📅 Filter Jan–Des</span><span>🏆 Peringkat deviasi</span><span>🎯 Belanja 51 · 52 · 53 · 57</span><span>🧾 Cetak PDF portrait</span></div>
      </div>
      <label class="hero-upload" id="drop">
        <input type="file" id="fileInput" accept=".xlsx,.xls,.csv">
        <div class="hu-ic">📥</div>
        <div class="hu-t1" id="huTitle">Unggah file Excel / CSV</div>
        <div class="hu-t2" id="huSub">Tarik ke sini atau <u>klik untuk memilih</u> · .xlsx · .xls · .csv</div>
        <div class="hu-actions">
          <button type="button" class="mini-btn hidden" id="btnClear">🗑️ Kosongkan</button>
        </div>
      </label>
    </div>
    <div id="uploadMsg"></div>
  </section>

  <!-- APP CONTENT -->
  <div id="appContent">

  <!-- FILTER -->
  <section class="section card">
    <div class="card-head"><div>
      <div class="eyebrow">Filter</div><h2>🎛️ Pengaturan Tampilan</h2>
      <div class="desc">Pilih bulan untuk melihat deviasi pada periode tersebut. Gunakan kategori untuk menyaring satker, lalu cari satker tertentu bila perlu.</div>
    </div></div>
    <div class="controls">
      <div class="field"><label>Bulan</label><select id="fMonth"></select></div>
      <div class="field"><label>Kategori Deviasi</label>
        <select id="fCat">
          <option value="all">Semua Kategori</option>
          <option value="sangatbaik">Sangat Baik (rata² ≤5% &amp; semua ≤5%)</option>
          <option value="baik">Baik (rata² ≤5%, ada belanja &gt;5%)</option>
          <option value="kurang">Kurang (rata² &gt;5% – 20%)</option>
          <option value="peringatan">Peringatan (rata² &gt; 20%)</option>
        </select>
      </div>
      <div class="field"><label>Urutan</label>
        <select id="fSort">
          <option value="asc">Deviasi Terkecil → Terbesar</option>
          <option value="desc">Deviasi Terbesar → Terkecil</option>
          <option value="nama">Nama Satker (A–Z)</option>
        </select>
      </div>
      <div class="field" style="min-width:200px"><label>Cari Satker</label>
        <div class="search-box"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" id="fSearch" placeholder="Nama atau kode satker…"></div></div>
    </div>
    <div class="legend">
      <span><i class="dot" style="background:var(--green)"></i> Rata² ≤5% &amp; semua belanja ≤5% → <b>SANGAT BAIK</b></span>
      <span><i class="dot" style="background:#0891b2"></i> Rata² ≤5% tapi ada belanja &gt;5% → <b>BAIK</b></span>
      <span><i class="dot" style="background:var(--amber)"></i> Rata² &gt;5%–20% → <b>KURANG</b></span>
      <span><i class="dot" style="background:var(--red)"></i> Rata² &gt;20% → <b>PERINGATAN</b></span>
    </div>
  </section>

  <!-- STATS -->
  <section class="section">
    <div class="stats" id="statsBox"></div>
  </section>

  <!-- REKAP TOTAL -->
  <section class="section">
    <div class="rekap">
      <div class="rekap-head"><div class="eyebrow" style="color:rgba(255,255,255,.85)">Rekapitulasi Total — <span id="rekapBulan"></span></div><h2>Total Target Rencana vs Penyerapan Anggaran</h2></div>
      <div class="rekap-grid">
        <div class="rk"><span class="rk-l">🎯 Total Target Rencana</span><span class="rk-v" id="rkTarget">0</span><span class="rk-s">seluruh jenis belanja</span></div>
        <div class="rk"><span class="rk-l">💰 Total Penyerapan</span><span class="rk-v" id="rkSerap">0</span><span class="rk-s">realisasi bulan ini</span></div>
        <div class="rk"><span class="rk-l">📉 Total Deviasi (Nilai)</span><span class="rk-v" id="rkDevNom">0</span><span class="rk-s">selisih target − serap</span></div>
        <div class="rk"><span class="rk-l">📊 Deviasi Agregat</span><span class="rk-v" id="rkDevPct">0%</span><span class="rk-s" id="rkDevKet">—</span></div>
      </div>
    </div>
  </section>

  <!-- TABEL -->
  <section class="section card">
    <div class="card-head">
      <div>
        <div class="eyebrow">Peringkat</div><h2>🏆 Peringkat Deviasi Satker</h2>
        <div class="desc">Tiap jenis belanja menampilkan Target & Realisasi (Rp) beserta % deviasinya. Diurutkan dari deviasi rata-rata terkecil (kinerja terbaik) ke terbesar.</div>
      </div>
      <div class="actions">
        <button class="btn btn-soft" id="btnPdf">🧾 Cetak PDF (Portrait)</button>
      </div>
    </div>

    <div class="maintabs" id="catTabs">
      <button data-cat="all" class="active">Semua <span class="cnt" id="cAll">0</span></button>
      <button data-cat="sangatbaik">Sangat Baik <span class="cnt" id="cSangatBaik">0</span></button>
      <button data-cat="baik">Baik <span class="cnt" id="cBaik">0</span></button>
      <button data-cat="kurang">Kurang <span class="cnt" id="cKurang">0</span></button>
      <button data-cat="peringatan">Peringatan <span class="cnt" id="cPeringatan">0</span></button>
    </div>

    <div class="tablewrap">
      <table id="mainTable">
        <thead>
          <tr>
            <th rowspan="2">#</th>
            <th rowspan="2">Kode</th>
