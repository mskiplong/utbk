/* =========================================================
   RESPONSIVE APP SHELL + SIDEBAR REFINEMENT
   ========================================================= */
html{scroll-behavior:smooth}
.inner,.wrap{max-width:1440px}
.wrap{padding:22px clamp(12px,2.2vw,28px) 44px}
.app-layout{display:grid;grid-template-columns:280px minmax(0,1fr);gap:22px;align-items:start}
.app-main{min-width:0}
.app-sidebar{position:sticky;top:84px;align-self:start;z-index:3}
.side-panel{background:linear-gradient(180deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow);padding:16px;overflow:hidden}
.side-brand-mini{display:flex;gap:11px;align-items:center;padding:10px 10px 14px;border-bottom:1px solid var(--line);margin-bottom:10px}
.side-brand-mini>span{width:38px;height:38px;border-radius:14px;display:grid;place-items:center;background:var(--grad);color:#fff;box-shadow:var(--shadow)}
.side-brand-mini b{display:block;font-size:15px}.side-brand-mini small{display:block;color:var(--muted);font-weight:800;font-size:11px;margin-top:2px}
.side-nav{display:grid;gap:7px;margin:10px 0 14px}
.side-nav a{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);padding:11px 12px;border:1px solid transparent;border-radius:14px;background:transparent;transition:.18s ease}
.side-nav a:hover{background:var(--panel);border-color:var(--line);transform:translateX(2px)}
.side-nav span{width:28px;height:28px;border-radius:10px;display:grid;place-items:center;background:var(--slate-bg)}
.side-nav b{font-size:13px}
.side-group{border:1px solid var(--line);border-radius:16px;padding:12px;margin-top:10px;background:var(--panel)}
.side-group-title{font-weight:950;font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:6px}
.side-group p{margin:0;color:var(--muted);font-size:12px;line-height:1.45}.gup-box{border-left:5px solid var(--brand)}.tup-box{border-left:5px solid var(--amber)}
.side-tip{margin-top:12px;border-radius:16px;padding:12px;background:#eef2ff;color:#3730a3;font-weight:800;font-size:12px;line-height:1.45}
html[data-theme="dark"] .side-tip{background:#1e1b4b;color:#c7d2fe}
.card,.rekap,.stat,.side-card{box-shadow:0 14px 32px -22px rgba(15,23,42,.48)}
.card{padding:clamp(15px,1.7vw,22px)}
.controls{grid-template-columns:repeat(12,minmax(0,1fr))}.controls .field{grid-column:span 2}.controls .search{grid-column:span 3}.controls .field:nth-child(1),.controls .field:nth-child(2),.controls .field:nth-child(3),.controls .field:nth-child(4){grid-column:span 2}.controls .field:nth-child(6),.controls .field:nth-child(7){grid-column:span 1}
.rekap-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.stats{grid-template-columns:repeat(5,minmax(0,1fr))}.dash{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}.side-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.tablewrap,.mini-table{scrollbar-width:thin;scrollbar-color:var(--muted) transparent}.tablewrap table,.mini-table table{white-space:nowrap}.mini-table{max-height:390px}
.btn:hover,.icon-btn:hover{filter:brightness(.98);transform:translateY(-1px)}.btn,.icon-btn{transition:.18s ease}
