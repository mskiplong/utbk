function saveSoal(){
  const section=$('sSection').value;
  const diff=$('sDiff').value;
  const passage=$('sPass').value.trim();
  const question=$('sQ').value.trim();
  const opts=['A','B','C','D','E'].map(l=>$('sO'+l).value.trim()).filter(Boolean);
  const answer=$('sAns').value.trim().toUpperCase();
  const explanation=$('sExp').value.trim();
  const passageImg=$('sPassImg').value||'';
  const questionImg=$('sQImg').value||'';
  if(!question && !questionImg){toast('Pertanyaan (teks atau gambar) wajib diisi!','error');return;}
  if(opts.length<2){toast('Minimal 2 pilihan jawaban!','error');return;}
  if(!answer){toast('Jawaban/bobot wajib diisi!','error');return;}
  const q={id:Date.now().toString(),section,passage,passageImg,question,questionImg,options:opts,answer,explanation,difficulty:diff};
  if(!DB.questions[section])DB.questions[section]=[];
  const idx=parseInt($('soalEditIdx').value);
  const origSec=$('soalEditSec').value;
  if(idx>=0&&origSec){
    // If section changed, remove from old and add to new
    if(origSec!==section){
      DB.questions[origSec].splice(idx,1);
      DB.questions[section].push(q);
    }else{
      DB.questions[section][idx]=q;
    }
    toast('✅ Soal diperbarui','success');
  }else{
    DB.questions[section].push(q);
    toast('✅ Soal ditambahkan','success');
  }
  save();closeM('soalModal');renderQCards();
  const listEl=$('qListArea');if(listEl.dataset.sec)renderQList(listEl.dataset.sec);
  renderHome();
}

function delSoal(sec,idx){
  if(!confirm('Hapus soal ini?'))return;
  DB.questions[sec].splice(idx,1);save();
  renderQCards();
  const listEl=$('qListArea');if(listEl.dataset.sec)renderQList(listEl.dataset.sec);
  renderHome();toast('Soal dihapus','info');
}

// CSV row -> question object (supports passage/question images via URL or data URI)
function rowToQ(row){
  return {
    id:row.id||'',
    section:row.section,
    passage:row.passage||'',
    passageImg:row.passage_img||row.passageImg||'',
    question:row.question||'',
    questionImg:row.question_img||row.questionImg||'',
    options:[row.option_a||'',row.option_b||'',row.option_c||'',row.option_d||'',row.option_e||''].filter(Boolean),
    answer:row.answer||'A',
    explanation:row.explanation||'',
    difficulty:(row.difficulty||'medium').toLowerCase()
  };
}
function handleQF(file){
  if(!file)return;
  const target=$('upSec').value;
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      let parsed=[];
      if(file.name.endsWith('.json')){parsed=JSON.parse(ev.target.result);if(!Array.isArray(parsed))parsed=[parsed];}
      else if(file.name.endsWith('.csv')){const res=Papa.parse(ev.target.result,{header:true,skipEmptyLines:true});parsed=res.data.map(rowToQ);}
      let added=0,skipped=0;
      parsed.forEach(q=>{
        if(!q.question && !q.questionImg){skipped++;return;}
        let sec=target==='auto'?q.section:target;
        const match=SUBS.find(s=>s.name===sec||s.name.toLowerCase()===sec?.toLowerCase()||s.code===sec);
        if(!match){skipped++;return;}
        q.section=match.name;if(!['easy','medium','hard'].includes(q.difficulty))q.difficulty='medium';
        q.passageImg=q.passageImg||'';q.questionImg=q.questionImg||'';q.id=q.id||Date.now().toString()+Math.random().toString(36).slice(2,7);
        if(!DB.questions[q.section])DB.questions[q.section]=[];
        DB.questions[q.section].push(q);added++;
      });
      save();renderQCards();renderHome();
      toast(`✅ ${added} soal diimpor${skipped?`, ${skipped} dilewati`:''}`,added>0?'success':'error');
    }catch(err){toast('❌ Format tidak valid: '+err.message,'error');}
  };
  reader.readAsText(file);
}

