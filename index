    margin-bottom: 10px;
  }

  .ch {
    background: #f1f5f9 !important;
    border-bottom: 1px solid #ccc !important;
  }

  .ch h3 { color: #000 !important; }

  .tbl-outer {
    max-height: none !important;
    overflow: visible !important;        /* ← PENTING */
    height: auto !important;             /* ← TAMBAHAN */
    border: 1px solid #ccc !important;
  }

  .tbl-main {
    min-width: auto !important;
    font-size: 7pt !important;
    width: 100% !important;              /* ← TAMBAHAN */
    border-collapse: collapse !important;/* ← TAMBAHAN */
  }

  /* ============================================
     KRUSIAL: Paksa semua row tabel tampil
     Mengatasi row yang di-hide oleh pagination
  ============================================ */
  #main-tbody tr,
  .tbl-main tbody tr {
    display: table-row !important;       /* ← INI YANG HILANG */
    visibility: visible !important;
  }

  #main-tbody td,
  #main-tbody th {
    visibility: visible !important;
  }

  /* Header tabel repeat di setiap halaman */
  thead {
    display: table-header-group !important; /* ← TAMBAHAN */
  }

  .tbl-main thead th,
  .tbl-main thead tr:nth-child(2) th {
    position: static !important;
    background: #e2e8f0 !important;
    color: #000 !important;
    border: 1px solid #aaa !important;
  }

  .tbl-main tbody td {
    border: 1px solid #ddd !important;
    color: #333 !important;
    background: #fff !important;
    padding: 4px 7px !important;
  }

  /* Hindari row terpotong antar halaman */
  .tbl-main tbody tr {
    page-break-inside: avoid;
  }

  .sc {
    border: 1px solid #ccc !important;
    background: #fff !important;
  }

  .sc-lbl { color: #666 !important; }
  .sc-val { color: #000 !important; }

  .print-header { display: block !important; }

