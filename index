    // Test endpoint: GET /proxy/listjurnalpendaftaran2 (path-based)
    const testUrl = `${cleanUrl}/proxy/listjurnalpendaftaran2`;
    const response = await fetch(testUrl, { method: 'GET' });
    const text = await response.text();
    
    if (response.ok && text.includes('stdtable')) {
