function doRestore(file){
  if(!file)return;const r=new FileReader();
  r.onload=e=>{try{const b=JSON.parse(e.target.result);if(b.db)setDB(b.db);G.rekapData=[];G.rekapDisp=[];refreshSettings();refreshDash();toast('Restore berhasil!','success');}catch(err){toast('Gagal restore: '+err.message,'error');}};
  r.readAsText(file);
}
function clearAll(){
  if(!confirm('Hapus SEMUA data?')||!confirm('Konfirmasi?'))return;
  Object.values(K).forEach(k=>localStorage.removeItem(k));
  G.rekapData=[];G.rekapDisp=[];G.belumData=[];G.rankData=[];G.pbnData=[];
  refreshSettings();refreshDash();toast('Semua data dihapus','info');
}

// ============================================================
// INIT
// ============================================================
// Pasang satu kali saat init / DOMContentLoaded
window.addEventListener('beforeprint', () => {
  document.querySelectorAll('#main-tbody tr').forEach(tr => {
    tr._bpDisplay = tr.style.display;
    tr.style.display = 'table-row';
  });
});

window.addEventListener('afterprint', () => {
  document.querySelectorAll('#main-tbody tr').forEach(tr => {
    tr.style.display = tr._bpDisplay ?? '';
    delete tr._bpDisplay;
  });
});
  document.addEventListener('DOMContentLoaded',()=>{
  G.ps=getPref().ps||50;
  refreshDash();
  const uz=document.getElementById('upzone');
  if(uz){
    uz.addEventListener('dragover',e=>{e.preventDefault();uz.classList.add('dg');});
    uz.addEventListener('dragleave',()=>uz.classList.remove('dg'));
    uz.addEventListener('drop',e=>{
      e.preventDefault();uz.classList.remove('dg');
      if(e.dataTransfer.files[0]){
        const dt=new DataTransfer();dt.items.add(e.dataTransfer.files[0]);
        document.getElementById('fi').files=dt.files;
        onFile({target:{files:[e.dataTransfer.files[0]]}});
      }
    });
  }
});
const _go=go;window.go=p=>{_go(p);if(p==='upload')initUpload();};
