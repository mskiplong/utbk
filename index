function getProxyEndpoints() {
  const targetPath = `/listjurnalpendaftaran2`;
  const endpoints = [];
  
  // 1. User's custom proxy URL (highest priority!)
  // Proxy URL is passed via X-Proxy-URL header.
  // The proxy server reads this header and uses it as the target URL.
  const customProxy = localStorage.getItem(CONFIG.proxyUrlKey);
  if (customProxy && customProxy.trim()) {
    const cleanProxy = customProxy.trim().replace(/\/+$/, ''); // remove trailing slash
    endpoints.push({
      name: `Custom Proxy: ${cleanProxy}`,
      url: cleanProxy + '/proxy', // proxy endpoint path
      method: 'POST',
      body: '', // body will be passed in headers
      isCustom: true,
    });
  }
  
  // 2. Public CORS proxies as fallback
  for (const proxy of CONFIG.corsProxies) {
    if (proxy.includes('?url=') || proxy.endsWith('?')) {
      const fullUrl = `${CONFIG.baseUrl}${targetPath}`;
      endpoints.push({
        name: `CORS Proxy: ${proxy}`,
        url: `${proxy}${encodeURIComponent(fullUrl)}`,
        method: 'POST_BODY_IN_QUERY', // special: POST data becomes URL params
      });
    } else {
      endpoints.push({
        name: `CORS Proxy: ${proxy}`,
        url: `${proxy}${CONFIG.baseUrl}${targetPath}`,
        method: 'POST',
      });
    }
  }
  
  return endpoints;
}

async function fetchSpmbData(fsekolah, rjalur, rstatus, perPage = 500) {
  const targetPath = `/listjurnalpendaftaran2`;
  const body = `per_page=${perPage}&cari=&fsekolah=${fsekolah}&rjalur=${rjalur}&rstatus=${rstatus}`;
  
  const endpoints = getProxyEndpoints();
  const errors = [];
  
  for (const endpoint of endpoints) {
    try {
      console.log(`[SPMB Monitor] Trying: ${endpoint.name}`);
      
      let response;
      let headers = { 'Accept': 'text/html' };
      let requestBody = null;
      
      if (endpoint.isCustom) {
        // Custom proxy: send everything via headers so proxy forwards correctly
        headers['X-Proxy-Method'] = 'POST';
        headers['X-Proxy-URL'] = CONFIG.baseUrl + targetPath;
        headers['X-Proxy-Body'] = body;
        headers['Content-Type'] = 'text/plain'; // arbitrary, body sent as header
        requestBody = '';
      } else if (endpoint.method === 'POST') {
        headers['Content-Type'] = 'application/x-www-form-urlencoded';
        requestBody = body;
      } else if (endpoint.method === 'POST_BODY_IN_QUERY') {
        // For GET-style proxies that don't support POST body
        const url = `${CONFIG.baseUrl}${targetPath}?${body}`;
        response = await fetch(`${endpoint.url.split('?')[0]}${encodeURIComponent(url)}`, {
          method: 'GET',
          headers,
        });
        // Skip to validation below
        if (!response) continue;
        
        if (!response.ok) {
          errors.push(`${endpoint.name}: HTTP ${response.status}`);
          continue;
        }
        const text = await response.text();
        if (!text || text.length < 100 || !text.includes('stdtable')) {
          errors.push(`${endpoint.name}: response tidak berisi tabel`);
          continue;
        }
        console.log(`[SPMB Monitor] ✓ Success via: ${endpoint.name} (${text.length} chars)`);
        return { text, source: endpoint.name };
      }
      
      response = await fetch(endpoint.url, {
        method: endpoint.method === 'POST' ? 'POST' : 'GET',
        headers,
        body: requestBody,
      });
      
      if (!response.ok) {
        errors.push(`${endpoint.name}: HTTP ${response.status}`);
        continue;
      }
      
      const text = await response.text();
      
      if (!text || text.length < 100) {
        errors.push(`${endpoint.name}: response kosong (${text?.length || 0} chars)`);
        continue;
      }
      
      if (!text.includes('stdtable')) {
        errors.push(`${endpoint.name}: response tidak berisi tabel`);
        continue;
      }
      
      // SUCCESS!
      console.log(`[SPMB Monitor] ✓ Success via: ${endpoint.name} (${text.length} chars)`);
      return { text, source: endpoint.name };
    } catch (e) {
      errors.push(`${endpoint.name}: ${e.message}`);
    }
  }
  
  // All failed
  throw new Error('Semua proxy gagal:\n' + errors.slice(0, 3).map(e => '• ' + e).join('\n') + 
                  (errors.length > 3 ? `\n... dan ${errors.length - 3} lainnya` : '') +
                  '\n\nRekomendasi: Set "Proxy URL" di konfigurasi (misal Cloudflare Workers Anda).');
}

