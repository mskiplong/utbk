<script>
let RAW=[], GROUPS={}, MONTHS=[], rankMode='best', currentView='home', currentFocus='';
const ID_MONTH=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const $=id=>document.getElementById(id);
const MON={jan:0,feb:1,mar:2,apr:3,may:4,mei:4,jun:5,jul:6,aug:7,agu:7,agt:7,sep:8,oct:9,okt:9,nov:10,dec:11,des:11};
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function pad6(v){let s=String(v==null?'':v).trim().replace(/\.0+$/,'');return s.padStart(6,'0');}
function normText(v){return String(v==null?'':v).trim().replace(/\s+/g,' ');}
function toNum(v){if(v==null||v==='')return 0;if(typeof v==='number')return v;let s=String(v).trim().replace(/\s/g,'').replace(/Rp/gi,'');if(!s||s==='-'||s==='–')return 0;s=s.replace(/,/g,'.');if(/^[-+]?\d+(\.\d+)?e[-+]?\d+$/i.test(s)){const n=Number(s);return isNaN(n)?0:n;}const parts=s.split('.');if(parts.length>2){const dec=parts.pop();s=parts.join('')+'.'+dec;}else if(parts.length===2&&parts[1].length===3&&parts[0].length>1){s=parts.join('');}const n=parseFloat(s);return isNaN(n)?0:n;}
function fmtRp(n){return 'Rp '+Math.round(n||0).toLocaleString('id-ID');}
function fmtPct(n){return (Math.round((n||0)*100)/100).toLocaleString('id-ID',{minimumFractionDigits:2,maximumFractionDigits:2})+'%';}
function ymLabel(ym){if(!ym)return '—';const[y,m]=ym.split('-');return ID_MONTH[+m-1]+' '+y;}
function fmtDate(d){return d instanceof Date&&!isNaN(d)?d.toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}):'-';}
function parseDate(v){if(v instanceof Date&&!isNaN(v))return v;if(typeof v==='number'){const d=new Date(Math.round((v-25569)*86400*1000));return isNaN(d)?null:d;}if(v==null)return null;let s=String(v).trim();if(!s)return null;let m=s.match(/^(\d{1,2})[-\/\s]([A-Za-z]{3,})[-\/\s](\d{2,4})$/);if(m){let mo=MON[m[2].slice(0,3).toLowerCase()],y=+m[3];if(y<100)y+=2000;if(mo!=null)return new Date(y,mo,+m[1]);}m=s.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{2,4})$/);if(m){let y=+m[3];if(y<100)y+=2000;return new Date(y,+m[2]-1,+m[1]);}m=s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})$/);if(m)return new Date(+m[1],+m[2]-1,+m[3]);const d=new Date(s);return isNaN(d)?null:d;}
function ymOf(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');}
function endOfMonth(ym){const[y,m]=ym.split('-').map(Number);return new Date(y,m,0,23,59,59,999);}
function startOfMonth(ym){const[y,m]=ym.split('-').map(Number);return new Date(y,m-1,1);}
function diffDays(a,b){return Math.floor((a-b)/86400000);}
function findHeader(rows){for(let i=0;i<Math.min(rows.length,25);i++){const j=(rows[i]||[]).map(c=>String(c||'').toLowerCase()).join('|');if(j.includes('kode satker')&&j.includes('sumber dana jenis')&&j.includes('tanggal'))return i;}return -1;}
function colMap(header){const H=header.map(h=>String(h||'').toLowerCase().replace(/\s+/g,' ').trim());const find=(...keys)=>{for(let i=0;i<H.length;i++)for(const k of keys)if(H[i].includes(k))return i;return -1};return{kode:find('kode satker'),nama:find('nama satker'),kppn:find('kppn'),sumberJenis:find('sumber dana jenis'),sumber:find('sumber dana'),tgl:find('tanggal'),gup:find('total gup'),up:find('total outstanding up','outstanding'),persen:find('persen'),status:find('status'),hari:find('selisih hari'),tup:find('total tup'),setorTup:find('total setoran tup')}}
function family(j){j=String(j||'').toUpperCase();if(j==='UP'||j==='GUP'||j==='GUP NIHIL'||j==='SETORAN UP')return 'UP';if(j==='TUP'||j==='GTUP NIHIL'||j==='SETORAN TUP')return 'TUP';return j.includes('TUP')?'TUP':'UP';}
function keyOf(r){return [r.kode,r.kppn,r.sumber].join('|');}

function handleFile(file){$('uploadMsg').innerHTML='';const r=new FileReader();r.onload=e=>{try{const wb=XLSX.read(e.target.result,{type:'array',cellDates:true});const ws=wb.Sheets[wb.SheetNames[0]];processRows(XLSX.utils.sheet_to_json(ws,{header:1,raw:true,defval:''}),file.name);}catch(err){showErr('Gagal membaca file: '+err.message);}};r.readAsArrayBuffer(file);}
function processRows(rows,fileName){const hIdx=findHeader(rows);if(hIdx<0){showErr('Header wajib tidak ditemukan. Pastikan ada kolom KODE SATKER, Sumber Dana, Sumber Dana Jenis, Tanggal.');return;}const cm=colMap(rows[hIdx]);if(cm.kode<0||cm.tgl<0||cm.sumberJenis<0){showErr('Kolom wajib KODE SATKER / Tanggal / Sumber Dana Jenis tidak lengkap.');return;}RAW=[];for(let i=hIdx+1;i<rows.length;i++){const row=rows[i];if(!row||String(row[cm.kode]??'').trim()==='')continue;const d=parseDate(row[cm.tgl]);const kode=pad6(row[cm.kode]);const jenis=normText(row[cm.sumberJenis]).toUpperCase();const sumber=normText(cm.sumber>-1?row[cm.sumber]:'');RAW.push({kode,nama:normText(cm.nama>-1?row[cm.nama]:''),kppn:normText(cm.kppn>-1?row[cm.kppn]:''),sumber:sumber||'-',jenis,fam:family(jenis),tgl:d,ym:d?ymOf(d):null,gup:cm.gup>-1?toNum(row[cm.gup]):0,outstanding:cm.up>-1?toNum(row[cm.up]):0,totalTup:cm.tup>-1?toNum(row[cm.tup]):0,setorTup:cm.setorTup>-1?toNum(row[cm.setorTup]):0,status:normText(cm.status>-1?row[cm.status]:''),selisih:cm.hari>-1?toNum(row[cm.hari]):0});}
if(!RAW.length){showErr('Tidak ada baris data yang terbaca.');return;}buildGroups();buildFilters();$('uploadMsg').innerHTML='<div class="alert info">✅ Memuat <b>'+RAW.length+'</b> baris dari <b>'+esc(fileName)+'</b> · <b>'+Object.keys(GROUPS).length+'</b> identitas Satker/KPPN/Sumber Dana.</div>';$('huTitle').textContent='✅ Data dimuat ('+Object.keys(GROUPS).length+' identitas)';$('huSub').innerHTML='Klik untuk <u>ganti file</u> · .xlsx · .xls · .csv';document.querySelector('.hero-upload').classList.add('loaded');setView('home',false);$('filterSec').scrollIntoView({behavior:'smooth',block:'start'});}
function buildGroups(){GROUPS={};RAW.forEach(r=>{if(!r.tgl)return;const k=keyOf(r);if(!GROUPS[k])GROUPS[k]={key:k,kode:r.kode,nama:r.nama,kppn:r.kppn,sumber:r.sumber,rows:[]};GROUPS[k].rows.push(r);if(r.nama)GROUPS[k].nama=r.nama;});Object.values(GROUPS).forEach(g=>g.rows.sort((a,b)=>a.tgl-b.tgl));}
function buildFilters(){const ms=[...new Set(RAW.filter(r=>r.ym).map(r=>r.ym))].sort();MONTHS=ms;const sm=$('fMonth');sm.innerHTML='';ms.forEach(m=>{const o=document.createElement('option');o.value=m;o.textContent=ymLabel(m);sm.appendChild(o)});if(ms.length)sm.value=ms[ms.length-1];const kk=[...new Set(RAW.map(r=>r.kppn).filter(Boolean))].sort();$('fKppn').innerHTML='<option value="">Semua KPPN</option>'+kk.map(k=>'<option value="'+esc(k)+'">KPPN '+esc(k)+'</option>').join('');const ss=[...new Set(RAW.map(r=>r.sumber).filter(Boolean))].sort();$('fSumber').innerHTML='<option value="">Semua</option>'+ss.map(s=>'<option value="'+esc(s)+'">'+esc(s)+'</option>').join('');}
function latestBefore(rows,dt,filt){return rows.filter(r=>r.tgl<=dt&&(!filt||filt(r))).sort((a,b)=>b.tgl-a.tgl)[0]||null;}
function sumMonth(rows,ym,filt,val){return rows.filter(r=>r.ym===ym&&(!filt||filt(r))).reduce((s,r)=>s+(val?val(r):0),0);}
function sumRange(rows,from,to,filt,val){return rows.filter(r=>r.tgl>=from&&r.tgl<=to&&(!filt||filt(r))).reduce((s,r)=>s+(val?val(r):0),0);}
function upNihilReductionMonth(upRows,ym){
  const a=upRows.filter(r=>r.tgl).slice().sort((x,y)=>x.tgl-y.tgl);
  let total=0;
  for(let i=0;i<a.length;i++){
    const r=a[i];
    if(r.ym!==ym||!(r.jenis==='GUP NIHIL'||r.jenis==='SETORAN UP'))continue;
    let v=Math.abs(r.gup||0);
    if(!v){
      const prev=[...a.slice(0,i)].reverse().find(x=>x.outstanding>0 || x.jenis==='UP' || x.jenis==='GUP');
      if(prev)v=Math.max(0,(prev.outstanding||0)-(r.outstanding||0));
    }
    total+=v;
  }
  return total;
}
function tupOpenInfo(g,dt){
  const rs=g.rows.filter(r=>r.fam==='TUP'&&r.tgl<=dt).sort((a,b)=>a.tgl-b.tgl);
  if(!rs.length)return {sisa:0,lastTup:null,umur:0,totalTup:0,totalGtup:0,totalSetor:0};
  const totalTup=rs.filter(r=>r.jenis==='TUP').reduce((s,r)=>s+Math.max(0,r.gup||r.outstanding||0),0);
  const totalGtup=rs.filter(r=>r.jenis==='GTUP NIHIL').reduce((s,r)=>s+Math.abs(r.gup||0),0);
  const totalSetor=rs.filter(r=>r.jenis==='SETORAN TUP').reduce((s,r)=>s+Math.max(0,r.setorTup||Math.abs(r.gup||0)),0);
  const sisa=Math.max(0,totalTup-totalGtup-totalSetor);
  let lastTup=null;
  if(sisa>0){const tupRows=rs.filter(r=>r.jenis==='TUP').sort((a,b)=>b.tgl-a.tgl);lastTup=tupRows[0]||rs[rs.length-1];}
  return {sisa,lastTup,umur:lastTup?diffDays(dt,lastTup.tgl):0,totalTup,totalGtup,totalSetor};
}

function compute(){
  const mode=$('fMode').value,ym=$('fMonth').value,kppn=$('fKppn').value,sumber=$('fSumber').value,q=$('fSearch').value.trim().toLowerCase();
  const thWarn=toNum($('thWarn').value)||50,thAward=toNum($('thAward').value)||100;
  if(!ym)return{mode,ym,rows:[],sumTarget:0,sumRealisasi:0,ratio:0,atensi:0,thWarn,thAward};
  const eom=endOfMonth(ym);let out=[];
