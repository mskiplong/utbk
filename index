  }
  if(labelEl)labelEl.textContent=`Preview hasil: ${G.sheetData.length} baris × ${mk.length} kolom`;
  const rows=G.sheetData.map(row=>{
    const obj={};
    mk.forEach(k=>{
      const idx=G.headers.indexOf(G.mapping[k]);
      let v=idx>=0?(row[idx]??''):'';
      const f=FIELDS.find(x=>x.key===k);
      if(f?.type==='number'&&v!==''){
        const num=pN(v);v=num?fN(num):'';
      }else{v=String(v);}
      obj[k]=v;
    });
    return obj;
  });
  let html='<table>';
  html+='<thead><tr>';
  html+='<th class="th-no">#</th>';
  mk.forEach(k=>{
