function renderUploadMatrix(src){
  const div=document.getElementById('dsh-matrix');
  if(!src.length){div.innerHTML='<div class="empty" style="padding:20px;"><div class="ei">📁</div><p>Belum ada file</p></div>';return;}
  const banks=[...new Set(src.map(s=>s.bank))];
  let h='<div style="overflow-x:auto;"><table class="rank-tbl" style="min-width:500px;"><thead><tr><th>Bank</th>';
  const years=[...new Set(src.map(s=>s.year))].sort();
  years.forEach(y=>MONTHS.forEach((m,mi)=>{if(src.find(s=>s.year===y&&parseInt(s.month)===mi+1))h+=`<th>${m} ${y}</th>`;}));
  h+='<th>Total</th></tr></thead><tbody>';
  banks.forEach(bank=>{
    h+=`<tr><td class="fw7">${bank}</td>`;
    years.forEach(y=>MONTHS.forEach((m,mi)=>{
      const mn=mi+1;if(!src.find(s=>s.year===y&&parseInt(s.month)===mn))return;
      const found=src.find(s=>s.bank===bank&&s.year===y&&parseInt(s.month)===mn);
      h+=found?`<td class="td-c"><span class="badge b-ok">✓ ${found.rows}</span></td>`:`<td class="td-c"><span class="txt-m txt-xs">—</span></td>`;
    }));
    const total=src.filter(s=>s.bank===bank).reduce((a,s)=>a+s.rows,0);
    h+=`<td class="td-c fw7">${total}</td></tr>`;
  });
  h+='</tbody></table></div>';
  div.innerHTML=h;
}

