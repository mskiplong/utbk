function pgFillFromSatker(val){
  // val bisa "kode - nama" dari datalist
  if(!RAW.length) return;
  var key=val.split(' - ')[0].trim();
  var map=buildIndex();
  var found=null;
  Object.keys(map).forEach(function(k){var sk=map[k];if(found)return;if(sk.kode===pad6(key)||sk.nama.toLowerCase()===val.toLowerCase()||sk.nama.toLowerCase()===key.toLowerCase())found=sk;});
  if(!found){
    // coba cari sebagian nama
    Object.keys(map).forEach(function(k){var sk=map[k];if(found)return;if(sk.nama.toLowerCase().indexOf(key.toLowerCase())>=0)found=sk;});
  }
  if(!found) return;
  document.getElementById('pgKode').value=found.kode;
  document.getElementById('pgNama').value=found.nama;
  // kategori dari kumulatif s.d. bulan terpilih
  var rows=rowsKumulatif();
  var row=rows.find(function(r){return r.kode===found.kode && r.nama===found.nama;});
