const IMG_MAX_DIM=1280, IMG_QUALITY=0.72, IMG_TARGET_KB=180;
function bytesFromDataURL(d){ if(!d)return 0; const i=d.indexOf(',');const b64=d.slice(i+1);return Math.round(b64.length*3/4); }
function fmtBytes(n){ return n<1024?n+' B':n<1048576?(n/1024).toFixed(1)+' KB':(n/1048576).toFixed(2)+' MB'; }
// Resize + compress an image source (File or dataURL) -> compressed JPEG/PNG dataURL
function compressImage(src){
  return new Promise((resolve,reject)=>{
    const img=new Image();
    img.onload=()=>{
      let{width:w,height:h}=img;
      const scale=Math.min(1, IMG_MAX_DIM/Math.max(w,h));
      w=Math.round(w*scale); h=Math.round(h*scale);
      const cv=document.createElement('canvas'); cv.width=w; cv.height=h;
      const ctx=cv.getContext('2d'); ctx.drawImage(img,0,0,w,h);
      // Iteratively lower quality until under target size (keep readable)
      let q=IMG_QUALITY, out=cv.toDataURL('image/jpeg',q);
      let guard=0;
      while(bytesFromDataURL(out)>IMG_TARGET_KB*1024 && q>0.35 && guard<6){ q-=0.1; out=cv.toDataURL('image/jpeg',q); guard++; }
      resolve(out);
    };
    img.onerror=()=>reject(new Error('Gambar tidak dapat dibaca'));
    img.src=src;
  });
}
function readFileAsDataURL(file){ return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.target.result);r.onerror=()=>rej(new Error('Gagal baca file'));r.readAsDataURL(file);}); }
async function setImg(which,dataURL){
  // which: 'pass' | 'q'
  const hid=which==='pass'?'sPassImg':'sQImg';
  const prev=which==='pass'?'passImgPrev':'qImgPrev';
  const hint=which==='pass'?'imgzPassHint':'imgzQHint';
  const bar=which==='pass'?'passImgBar':'qImgBar';
  const info=which==='pass'?'passImgInfo':'qImgInfo';
  if(!dataURL){
    $(hid).value=''; $(prev).src=''; $(prev).classList.add('hidden');
    $(hint).classList.remove('hidden'); $(bar).classList.add('hidden');
    return;
  }
  $(hid).value=dataURL; $(prev).src=dataURL; $(prev).classList.remove('hidden');
  $(hint).classList.add('hidden'); $(bar).classList.remove('hidden');
  $(info).textContent='✅ Tersimpan • '+fmtBytes(bytesFromDataURL(dataURL));
}
async function handleImgFile(file,which){
  if(!file)return;
  if(!file.type.startsWith('image/')){toast('File bukan gambar','error');return;}
  try{
    const raw=await readFileAsDataURL(file);
    const before=file.size;
    const out=await compressImage(raw);
    await setImg(which,out);
    toast(`🖼 Gambar dikompres ${fmtBytes(before)} → ${fmtBytes(bytesFromDataURL(out))}`,'success');
  }catch(e){toast('❌ '+e.message,'error');}
}
async function pasteImg(ev,which){
  const items=(ev.clipboardData||ev.originalEvent?.clipboardData)?.items||[];
  for(const it of items){
    if(it.type && it.type.startsWith('image/')){
      ev.preventDefault();
      const blob=it.getAsFile();
      await handleImgFile(blob,which);
      return;
    }
  }
  // no image in clipboard -> let default paste happen (e.g. text); but our zone has no text input
}
function clearImg(which){ setImg(which,''); }

