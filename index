function delSrc(i){
  if(!confirm('Hapus sumber data ini?'))return;
  const db=getDB();const s=db.sources[i];db.sources.splice(i,1);
  if(s)db.rawData=(db.rawData||[]).filter(r=>!(r._bank===s.bank&&r._year===s.year&&r._month===s.month&&r._dtype===s.dtype));
  db.rekap=[];setDB(db);G.rekapData=[];G.rekapDisp=[];refreshSrcPage();toast('Sumber data dihapus!','info');
}
function clearAllSrc(){
  if(!confirm('Hapus SEMUA sumber data?'))return;
  const db=getDB();db.sources=[];db.rawData=[];db.rekap=[];setDB(db);
  G.rekapData=[];G.rekapDisp=[];refreshSrcPage();refreshDash();toast('Semua sumber data dihapus!','info');
}

