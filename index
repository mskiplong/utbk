      alert(`✅ Proxy OK!\n\nURL: ${cleanUrl}\nResponse: ${text.length} chars\nTabel ditemukan: Ya\n\nSekarang klik "Fetch Data Terbaru".`);
    } else if (response.ok) {
      showStatus('warning', `⚠️ Proxy responding tapi tanpa tabel. Mungkin URL salah.`);
      alert(`⚠️ Proxy responding tapi tidak mengembalikan tabel.\n\nResponse: ${text.length} chars\nTabel ditemukan: Tidak\n\nCek apakah URL Worker benar dan endpoint /proxy/listjurnalpendaftaran2 berfungsi.`);
    } else {
      showStatus('error', `❌ Proxy returned HTTP ${response.status}`);
      alert(`❌ Error: HTTP ${response.status}\n\nURL Worker mungkin salah atau belum di-deploy.`);
    }
  } catch (e) {
    showStatus('error', `❌ Test gagal: ${e.message}`);
    alert(`❌ Test gagal: ${e.message}\n\nPastikan:\n1. Worker sudah di-deploy ke Cloudflare\n2. URL benar (contoh: https://my-worker.workers.dev)\n3. Internet Anda stabil`);
  }
}

