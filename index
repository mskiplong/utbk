function fN(n){const v=parseFloat(n);return(!v||isNaN(v))?'':v.toLocaleString('id-ID',{maximumFractionDigits:0});}
function fC(n){return'Rp '+(parseFloat(n)||0).toLocaleString('id-ID',{maximumFractionDigits:0});}
function pN(v){
  if(!v&&v!==0)return 0;if(typeof v==='number')return Math.abs(v);
  let s=String(v).replace(/[^\d.,-]/g,'').trim();if(!s)return 0;
  const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');
  if(lc>0&&ld>0){s=lc>ld?s.replace(/\./g,'').replace(',','.'):s.replace(/,/g,'');}
  else if(lc>0){s=(s.length-lc-1)<=2?s.replace(',','.'):s.replace(/,/g,'');}
  return Math.abs(parseFloat(s)||0);
}
function norm(s){return String(s||'').toLowerCase().trim().replace(/[\s_\-\.]+/g,' ').replace(/[^\w\s]/g,'').trim();}
function trunc(s,n){s=String(s||'');return s.length>n?s.slice(0,n)+'…':s;}
function today(){return new Date().toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'});}
function tstamp(){return new Date().toISOString().split('T')[0];}
function dlBlob(c,n,t){const b=new Blob([c],{type:t}),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=n;a.click();URL.revokeObjectURL(u);}
function pSlice(arr,p){const ps=G.ps;return arr.slice((p-1)*ps,p*ps);}
function pInfo(arr,p){const ps=G.ps,s=(p-1)*ps;return`${arr.length?s+1:0}–${Math.min(s+ps,arr.length)} dari ${arr.length.toLocaleString('id-ID')}`;}
function buildPgn(cur,tot,fn){
  if(tot<=1)return'';
  let h=`<button class="pb" ${cur<=1?'disabled':''} onclick="${fn}(${cur-1})">←</button>`;
  let lo=Math.max(1,cur-2),hi=Math.min(tot,cur+2);
  if(lo>1){h+=`<button class="pb" onclick="${fn}(1)">1</button>`;if(lo>2)h+=`<button class="pb" disabled>…</button>`;}
  for(let i=lo;i<=hi;i++)h+=`<button class="pb ${i===cur?'on':''}" onclick="${fn}(${i})">${i}</button>`;
  if(hi<tot){if(hi<tot-1)h+=`<button class="pb" disabled>…</button>`;h+=`<button class="pb" onclick="${fn}(${tot})">${tot}</button>`;}
  return`<div class="pgb">${h}<button class="pb" ${cur>=tot?'disabled':''} onclick="${fn}(${cur+1})">→</button></div>`;
}
function scCard(col,ic,lbl,val,sub){return`<div class="sc ${col}"><div class="sc-ic">${ic}</div><div class="sc-lbl">${lbl}</div><div class="sc-val">${val}</div>${sub?`<div class="sc-sub">${sub}</div>`:''}</div>`;}
function statusBadge(st){
  if(!st)return'<span class="txt-m txt-xs">—</span>';
  const s=String(st).toLowerCase();
  if(s.includes('aktif')||s==='a'||s==='active')return'<span class="st-aktif">Aktif</span>';
  if(s.includes('tutup')||s.includes('close')||s==='c')return'<span class="st-tutup">Tutup</span>';
  return`<span class="badge b-wrn">${st}</span>`;
}
function saldoFmt(v){const n=parseFloat(v)||0;if(!n)return'<span class="saldo-z">0</span>';return n>0?`<span class="saldo-pos">${fC(n)}</span>`:`<span class="saldo-neg">${fC(n)}</span>`;}
function rankBadge(i){
  if(i===0)return'<span class="rank rank-1">🥇</span>';
  if(i===1)return'<span class="rank rank-2">🥈</span>';
  if(i===2)return'<span class="rank rank-3">🥉</span>';
  return`<span class="rank rank-n">${i+1}</span>`;
}
function periodLabel(bank,year,month){const m=parseInt(month);return`${bank||'—'} / ${month?(MONTHS_FULL[m-1]||month):'—'} ${year||''}`;}
function sim(a,b){
  a=norm(a);b=norm(b);if(a===b)return 100;if(a.includes(b)||b.includes(a))return 88;
  const ta=a.split(' '),tb=b.split(' ');const cm=ta.filter(t=>tb.includes(t));
  if(cm.length)return Math.round((cm.length/Math.max(ta.length,tb.length))*78);return 0;
}
function autoDetect(headers,data){
  const res={};
  FIELDS.forEach(f=>{
    let best={col:null,conf:0};
    headers.forEach(h=>{const hn=norm(h);f.pat.forEach(p=>{const s=sim(hn,norm(p));if(s>best.conf&&s>=55)best={col:h,conf:s};});});
    if(best.col)res[f.key]={col:best.col,conf:best.conf};
  });
  return res;
}

