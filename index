}

function applyKuota() {
  // Re-render with current data using new quota
  if (allStudents.length > 0) {
    const newRegnos = allStudents.filter(r => !knownRegnos.has(r.regno)).map(r => r.regno);
    renderResults(newRegnos);
    showStatus('info', `✓ Kuota diperbarui menjadi ${document.getElementById('kuota').value}.`);
  } else {
    showStatus('warning', '⚠️ Belum ada data. Fetch terlebih dahulu.');
  }
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));
}

// ============================================================
// EXPORT PDF
// ============================================================
function exportPDF() {
  if (allStudents.length === 0) {
    showStatus('warning', '⚠️ Tidak ada data untuk di-export. Fetch dulu.');
    return;
  }
  
  showStatus('info', '📄 Generating PDF...');
  
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
  
  const sorted = [...allStudents].sort((a, b) => {
    const na = parseFloat(a.nilai_akhir) || 0;
    const nb = parseFloat(b.nilai_akhir) || 0;
    return nb - na;
  });
  
  const kuota = parseInt(document.getElementById('kuota').value) || 71;
  sorted.forEach((r, idx) => {
    r.rank = idx + 1;
    r.pilihan_diterima = (r.opt1 === '309') ? 'SMP NEGERI 9' : '-';
    r.status_terima = (idx < kuota) ? 'DITERIMA' : 'TIDAK';
  });
  const diterimaCount = sorted.filter(r => r.status_terima === 'DITERIMA').length;
  const lastDiterima = sorted[Math.min(kuota - 1, sorted.length - 1)];
  
  // Title
  doc.setFontSize(14);
  doc.setTextColor(26, 84, 144);
  doc.text('Data SPMB - Jalur Prestasi SMPN 9 (Hasil Sementara)', 14, 14);
  
  doc.setFontSize(10);
  doc.setTextColor(60, 60, 60);
  doc.text(`Pil 1 + Pil 2 jalur prestasi | Nilai > ${document.getElementById('threshold').value} | Kuota: ${kuota} | ${new Date().toLocaleString('id-ID')}`, 14, 20);
  
  // Summary
  const total = sorted.length;
  const pil1Count = sorted.filter(r => r.pilihan_ke === 1).length;
  const pil2Count = sorted.filter(r => r.pilihan_ke === 2).length;
  const diterimaPil1 = sorted.filter(r => r.status_terima === 'DITERIMA' && r.opt1 === '309').length;
  const diterimaPil2 = sorted.filter(r => r.status_terima === 'DITERIMA' && r.opt1 !== '309').length;
  doc.setFontSize(9);
  doc.setTextColor(22, 163, 74);
  doc.text(`DITERIMA di SMPN 9: ${diterimaCount} (Pil 1: ${diterimaPil1}, Pil 2: ${diterimaPil2}) | Batas nilai: ${lastDiterima ? lastDiterima.nilai_akhir : '-'}`, 14, 26);
  doc.setTextColor(60, 60, 60);
  doc.text(`TIDAK: ${sorted.length - diterimaCount} | Total pool: ${total}`, 110, 26);
  
  // Table
  doc.autoTable({
    startY: 30,
    head: [['#', 'REGNO', 'Pil', 'Pilihan Diterima', 'Nama', 'Asal Sekolah', 'Nilai', 'Status']],
    body: sorted.map((r) => {
      const diterima = r.status_terima === 'DITERIMA';
      const pilDiterima = diterima
        ? `SMP NEGERI 9 (Pil ${r.pilihan_penerimaan})`
        : r.pilihan_diterima;
      return [
        r.rank,
        r.regno,
        r.pilihan_ke === 1 ? 'Pil 1' : 'Pil 2',
        pilDiterima,
        r.nama,
        r.asal_sekolah,
        r.nilai_akhir,
        r.status_terima,
      ];
    }),
    theme: 'striped',
    headStyles: { fillColor: [26, 84, 144], textColor: 255, fontStyle: 'bold' },
    styles: { fontSize: 7, cellPadding: 1.5 },
    columnStyles: {
      0: { cellWidth: 10, halign: 'center' },
      1: { cellWidth: 22, halign: 'center' },
      2: { cellWidth: 13, halign: 'center' },
      3: { cellWidth: 38, halign: 'center' },
      4: { cellWidth: 50 },
      5: { cellWidth: 70 },
      6: { cellWidth: 18, halign: 'center' },
      7: { cellWidth: 22, halign: 'center' },
    },
    didParseCell: function(data) {
      if (data.section === 'body' && data.column.index === 7) {
        if (data.cell.raw === 'DITERIMA') {
          data.cell.styles.fillColor = [220, 252, 231];
          data.cell.styles.textColor = [22, 101, 52];
          data.cell.styles.fontStyle = 'bold';
        } else if (data.cell.raw === 'TIDAK') {
          data.cell.styles.fillColor = [254, 226, 226];
          data.cell.styles.textColor = [153, 27, 27];
          data.cell.styles.fontStyle = 'bold';
        }
      }
      if (data.section === 'body' && data.column.index === 0) {
        data.cell.styles.fontStyle = 'bold';
      }
      if (data.section === 'body' && data.column.index === 3) {
        if (data.cell.raw && data.cell.raw.includes('SMP NEGERI 9')) {
          data.cell.styles.textColor = [22, 101, 52];
          data.cell.styles.fontStyle = 'bold';
        }
      }
    },
  });
  
  // Footer
  const pageCount = doc.internal.getNumberOfPages();
  for (let i = 1; i <= pageCount; i++) {
    doc.setPage(i);
    doc.setFontSize(7);
    doc.setTextColor(150);
    doc.text(`Halaman ${i} dari ${pageCount} | Sumber: spmb.semarangkota.go.id/smp | Top ${kuota} = DITERIMA`, 14, doc.internal.pageSize.height - 8);
  }
  
  doc.save(`spmb-prestasi-smpn9-kuota-${kuota}-${Date.now()}.pdf`);
  showStatus('success', `✅ PDF berhasil didownload! (${total} siswa, kuota ${kuota}, diterima ${diterimaCount})`);
}

