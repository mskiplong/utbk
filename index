  if(r)try{DB={users:[],questions:{},results:[],...JSON.parse(r)};}catch(e){}
  if(!DB.users.length){
    DB.users=[
      {id:'u1',username:'admin',password:'ayahibu4ku',name:'Administrator',role:'admin',active:true},
      {id:'u2',username:'siswa',password:'siswa123',name:'Siswa Demo',role:'siswa',active:true},
    ];save();
  }
}

/* ══ THEME ══ */
