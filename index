}
function saveEditRuh(){
  const i=parseInt(document.getElementById('edit-ruh-idx').value);const db=getDB();if(!db.ruh[i])return;
  db.ruh[i]={...db.ruh[i],kode_satker:document.getElementById('edit-kode').value.trim(),nama_satker:document.getElementById('edit-nama').value.trim(),kode_ba:document.getElementById('edit-ba').value.trim(),nama_ba:document.getElementById('edit-namaBA').value.trim(),kode_eselon:document.getElementById('edit-esl').value.trim()};
