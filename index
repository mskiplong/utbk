<script>
/* ══ CONSTANTS ══ */
const SUBS=[
  {name:"Penalaran Umum",                        code:"PU",   n:30,time:30,grp:"TPS",     col:"#58a6ff"},
  {name:"Pengetahuan dan Pemahaman Umum",        code:"PPU",  n:20,time:15,grp:"TPS",     col:"#bc8cff"},
  {name:"Kemampuan Memahami Bacaan dan Menulis", code:"KMBM", n:20,time:25,grp:"TPS",     col:"#3fb950"},
  {name:"Pengetahuan Kuantitatif",               code:"PK",   n:20,time:20,grp:"TPS",     col:"#d29922"},
  {name:"Literasi dalam Bahasa Indonesia",       code:"LBI",  n:30,time:45,grp:"Literasi",col:"#f85149"},
  {name:"Literasi dalam Bahasa Inggris",         code:"LBIng",n:20,time:30,grp:"Literasi",col:"#39c5cf"},
  {name:"Penalaran Matematika",                  code:"PM",   n:20,time:30,grp:"PM",      col:"#ffa657"},
];
const TOTAL_Q=160, EXAM_SEC=115*60;
const IRT={easy:1.0,medium:1.5,hard:2.0};

/* ══ IRT ENGINE ══ */
function calcIRT(qs,ans){
  const sec={};
  SUBS.forEach(s=>{sec[s.name]={wC:0,wT:0,correct:0,wrong:0,skip:0,total:s.n};});
  qs.forEach((q,i)=>{
    const s=sec[q.section];if(!s)return;
    const w=IRT[q.difficulty]||IRT.medium;
    s.wT+=w;
    const ua=ans[i],ca=normAns(q.answer);
    if(!ua)s.skip++;
    else if(isCorr(ua,ca)){s.wC+=w;s.correct++;}
    else s.wrong++;
  });
  const scaled={};
  SUBS.forEach(s=>{
    const d=sec[s.name];
    const ratio=d.wT>0?d.wC/d.wT:0;
    const theta=ratio*6-3;
    const score=Math.round(300+(theta+3)/6*500);
    d.scaled=clamp(score,300,800);d.theta=Math.round(theta*100)/100;d.ratio=Math.round(ratio*1000)/10;
    scaled[s.name]=d;
  });
  const avg=ns=>{const v=ns.map(n=>scaled[n]?.scaled||300);return Math.round(v.reduce((a,b)=>a+b,0)/v.length);};
  const TPS=avg(SUBS.filter(s=>s.grp==='TPS').map(s=>s.name));
  const Lit=avg(SUBS.filter(s=>s.grp==='Literasi').map(s=>s.name));
  const PM=avg(SUBS.filter(s=>s.grp==='PM').map(s=>s.name));
  return{sections:scaled,groups:{TPS,Literasi:Lit,PM},finalScore:clamp(Math.round((TPS+Lit+PM)/3),300,800)};
}
function normAns(a){
  if(!a)return'A';
  if(typeof a==='number')return['A','B','C','D','E'][a]||'A';
  const s=String(a).trim().toUpperCase();
  if(['A','B','C','D','E'].includes(s))return s;
  const n=parseInt(s);if(!isNaN(n)&&n>=0&&n<=4)return['A','B','C','D','E'][n];
  return'A';
}
function isCorr(u,c){return String(c).split(',').map(x=>x.trim().toUpperCase()).includes(String(u).toUpperCase());}
function normOpts(q){if(Array.isArray(q.options))return q.options.map(o=>String(o).replace(/^[A-Ea-e][.)]\s*/,'').trim());return['A','B','C','D','E'];}
function clamp(v,mn,mx){return Math.max(mn,Math.min(mx,v));}

/* ══ STATE ══ */
let DB={users:[],questions:{},ptnData:[],results:[]};
let CU=null;
let exam={active:false,qs:[],ans:{},flags:new Set(),idx:0,timer:null,left:EXAM_SEC};
let CH={trend:null,radar:null,bar:null,rasio:null,adm:null};
let rMode='peluang',rScore=0,pgRefs=[];
let darkMode=true;
let qListPage={}; // {sectionName: pageNum}

/* ══ STORAGE ══ */
function save(){try{localStorage.setItem('snbtpro',JSON.stringify(DB));}catch(e){toast('Storage penuh!','error');}}
function load(){
  const r=localStorage.getItem('snbtpro');
  if(r)try{DB={users:[],questions:{},ptnData:[],results:[],...JSON.parse(r)};}catch(e){}
  if(!DB.users.length){
    DB.users=[
      {id:'u1',username:'admin',password:'ayahibu4ku',name:'Administrator',role:'admin',active:true},
      {id:'u2',username:'siswa',password:'siswa123',name:'Siswa Demo',role:'siswa',active:true},
    ];save();
  }
  if(!DB.ptnData.length){DB.ptnData=defPTN();save();}
}

/* ══ THEME ══ */
function toggleTheme(){
  darkMode=!darkMode;
  document.documentElement.setAttribute('data-theme',darkMode?'dark':'light');
  const ico=darkMode?'🌙':'☀️';
