function reloadSheet(){
  if(!G.wb)return;
  const idx=parseInt(document.getElementById('sh-sel').value)||0;
  const hrow=parseInt(document.getElementById('h-row').value)||1;
  const hcol=parseInt(document.getElementById('h-col').value)||1; // KOLOM HEADER
  const ws=G.wb.Sheets[G.wb.SheetNames[idx]];
  const raw=XLSX.utils.sheet_to_json(ws,{header:1,defval:'',raw:false});
  const hIdx=hrow-1;
  const hColIdx=hcol-1; // index kolom mulai (0-based)
  
  if(hIdx>=raw.length){toast('Baris header melebihi jumlah baris!','error');return;}
  
  // Ambil header mulai dari kolom ke-hcol
  const fullHeaderRow=raw[hIdx];
  const slicedHeaders=fullHeaderRow.slice(hColIdx);
  G.headers=slicedHeaders.map((h,i)=>String(h||'').trim()||`Col_${hColIdx+i+1}`);
  
  // Data: slice dari kolom yang sama
  G.sheetData=raw.slice(hIdx+1)
    .filter(r=>r.some(c=>c!==''&&c!==null))
    .map(r=>r.slice(hColIdx));
  
  // Update badge info
  const badgeWrap=document.getElementById('header-info-badge');
  const badgeText=document.getElementById('header-badge-text');
  if(badgeWrap&&badgeText){
    badgeWrap.style.display='block';
    badgeText.textContent=`Header: Baris ${hrow}, Kolom ${hcol} → ${G.headers.length} kolom terdeteksi`;
