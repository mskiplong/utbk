    html+=`<th style="${isNum?'color:#34d399;text-align:right;':'color:var(--cyan);'}">
      ${f?f.label:k}<br><span style="font-size:0.58rem;color:var(--t3);font-weight:normal;">[Kol.${colIdx+1}]</span>
    </th>`;
  });
  html+='</tr></thead>';
  html+='<tbody>';
  rows.forEach((row,ri)=>{
    html+='<tr>';
    html+=`<td class="td-no-sticky">${ri+1}</td>`;
    mk.forEach(k=>{
      const f=FIELDS.find(x=>x.key===k);
      const isNum=f?.type==='number';
      const val=String(row[k]||'');
      const display=val.length>35?val.slice(0,35)+'…':val;
      html+=`<td class="${isNum?'td-num':''}" title="${val.replace(/"/g,'&quot;')}">${display}</td>`;
    });
    html+='</tr>';
  });
  html+='</tbody></table>';
  container.innerHTML=html;
}

