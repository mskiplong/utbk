  const qs=DB.questions[secName]||[];
  const kl=kw.toLowerCase();
  const filtered=qs.filter((q,i)=>q.question.toLowerCase().includes(kl)||(q.passage||'').toLowerCase().includes(kl)||(q.answer||'').toLowerCase().includes(kl));
  body.innerHTML=`<table><thead><tr><th>#</th><th>Soal</th><th>Difficulty</th><th>Jawaban</th><th>Aksi</th></tr></thead><tbody>${filtered.slice(0,50).map((q,i)=>{
