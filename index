<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UP·GUP Analytics — Analisis Kepatuhan Satker</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
/* ============================ THEME ============================ */
:root{
  --brand:#4f46e5; --brand2:#6366f1; --brand-soft:#eef2ff;
  --accent:#06b6d4;
  --green:#059669; --green-bg:#d1fae5; --green-ink:#065f46;
  --amber:#d97706; --amber-bg:#fef3c7; --amber-ink:#92400e;
  --red:#dc2626;   --red-bg:#fee2e2;   --red-ink:#991b1b;
  --slate:#64748b;
  --bg:#f1f5f9; --panel:#ffffff; --panel-2:#f8fafc;
  --ink:#0f172a; --ink-2:#475569; --muted:#94a3b8;
  --line:#e8edf3;
  --radius:18px; --radius-sm:12px;
  --shadow-sm:0 1px 3px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04);
  --shadow:0 12px 28px -8px rgba(15,23,42,.16), 0 4px 10px -4px rgba(15,23,42,.08);
  --shadow-lg:0 28px 60px -16px rgba(79,70,229,.30);
  --grad:linear-gradient(135deg,#4f46e5 0%,#7c3aed 50%,#06b6d4 130%);
  --grad-soft:linear-gradient(135deg,#eef2ff,#ecfeff);
  --t:.25s cubic-bezier(.4,0,.2,1);
}
html[data-theme="dark"]{
  --bg:#0b1120; --panel:#111827; --panel-2:#0f172a;
  --ink:#f1f5f9; --ink-2:#cbd5e1; --muted:#64748b;
  --line:#1e293b; --brand-soft:#1e1b4b;
  --green-bg:#052e22; --amber-bg:#3a2a06; --red-bg:#3a0d0d;
  --green-ink:#6ee7b7; --amber-ink:#fcd34d; --red-ink:#fca5a5;
  --shadow:0 12px 30px -10px rgba(0,0,0,.6);
  --shadow-sm:0 1px 3px rgba(0,0,0,.4);
  --grad-soft:linear-gradient(135deg,#1e1b4b,#0e2a33);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:'Inter','Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif;
  background:var(--bg); color:var(--ink); min-height:100vh; line-height:1.5;
  -webkit-font-smoothing:antialiased; transition:background var(--t),color var(--t);
}
::selection{background:rgba(79,70,229,.25)}
a{color:inherit}
.muted{color:var(--muted)}

/* scrollbar */
*::-webkit-scrollbar{height:10px;width:10px}
*::-webkit-scrollbar-thumb{background:var(--line);border-radius:99px}
*::-webkit-scrollbar-thumb:hover{background:var(--muted)}

/* ============================ TOPBAR ============================ */
.topbar{
  position:sticky;top:0;z-index:50;
  background:color-mix(in srgb, var(--panel) 82%, transparent);
  backdrop-filter:saturate(180%) blur(14px);
  border-bottom:1px solid var(--line);
}
.topbar .inner{max-width:1280px;margin:0 auto;padding:12px 18px;display:flex;align-items:center;gap:14px}
.logo{display:flex;align-items:center;gap:11px;font-weight:800;letter-spacing:-.3px}
.logo .mark{
  width:38px;height:38px;border-radius:11px;background:var(--grad);color:#fff;
  display:grid;place-items:center;font-size:19px;box-shadow:var(--shadow-lg);
}
.logo .txt small{display:block;font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.5px}
.logo .txt b{font-size:16px;display:block;line-height:1.1}
.spacer{flex:1}
.icon-btn{
  width:40px;height:40px;border-radius:11px;border:1px solid var(--line);background:var(--panel);
  cursor:pointer;display:grid;place-items:center;font-size:17px;transition:var(--t);color:var(--ink);
}
.icon-btn:hover{background:var(--brand-soft);border-color:var(--brand);transform:translateY(-1px)}

/* ============================ LAYOUT ============================ */
.wrap{max-width:1280px;margin:0 auto;padding:22px 18px 70px}
.section{margin-bottom:22px}
.card{
  background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
  box-shadow:var(--shadow-sm);padding:22px;transition:var(--t);
}
.card.pad-lg{padding:26px}
.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.card-head h2{margin:0;font-size:17px;font-weight:800;letter-spacing:-.3px;display:flex;align-items:center;gap:9px}
.card-head .desc{font-size:13px;color:var(--muted);margin-top:3px;max-width:560px}
.eyebrow{font-size:11px;font-weight:800;letter-spacing:1.4px;color:var(--brand);text-transform:uppercase}

/* ============================ HERO / UPLOAD ============================ */
.hero{
  position:relative;overflow:hidden;border-radius:var(--radius);
  background:var(--grad);color:#fff;padding:30px 34px;box-shadow:var(--shadow-lg);
  display:flex;align-items:center;gap:26px;flex-wrap:wrap;
}
.hero::after{content:"";position:absolute;inset:0;background:
  radial-gradient(600px 200px at 90% -10%, rgba(255,255,255,.22), transparent 60%),
  radial-gradient(400px 300px at 0% 120%, rgba(6,182,212,.4), transparent 60%);pointer-events:none}
.hero-main{position:relative;flex:1;min-width:280px}
.hero h1{margin:0 0 8px;font-size:clamp(22px,4vw,32px);font-weight:900;letter-spacing:-.8px}
.hero p{margin:0;max-width:560px;color:rgba(255,255,255,.9);font-size:14px}
.hero .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.hero .chips span{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.25);
  padding:5px 12px;border-radius:99px;font-size:12px;font-weight:600;backdrop-filter:blur(4px)}

.hero-upload{
  position:relative;flex:0 0 300px;max-width:340px;width:100%;
  border:2px dashed rgba(255,255,255,.6);border-radius:16px;background:rgba(255,255,255,.10);
  padding:24px 20px;text-align:center;cursor:pointer;transition:var(--t);color:#fff;
}
@media(max-width:760px){.hero-upload{flex:1 1 100%;max-width:none}}
.hero-upload:hover,.hero-upload.drag{background:rgba(255,255,255,.22);border-color:#fff;transform:translateY(-2px)}
.hero-upload.loaded{background:rgba(16,185,129,.25);border-color:rgba(167,243,208,.9);border-style:solid}
.hero-upload .hu-ic{font-size:40px;line-height:1}
.hero-upload .hu-t1{font-weight:800;margin-top:8px;font-size:15px}
.hero-upload .hu-t2{font-size:12px;color:rgba(255,255,255,.85);margin-top:4px}
.hero-upload u{font-weight:800;text-underline-offset:2px}
#fileInput{display:none}

/* ============================ STAT CARDS ============================ */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:14px}
.stat{
  position:relative;overflow:hidden;background:var(--panel);border:1px solid var(--line);
  border-radius:var(--radius-sm);padding:18px;box-shadow:var(--shadow-sm);transition:var(--t);
  animation:rise .5s both;
}
.stat:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.stat .top{display:flex;align-items:center;justify-content:space-between}
.stat .ic{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-size:18px}
.stat .n{font-size:30px;font-weight:900;letter-spacing:-1px;margin-top:10px;line-height:1}
.stat .l{font-size:12.5px;color:var(--muted);margin-top:3px;font-weight:600}
.stat .strip{position:absolute;left:0;top:0;bottom:0;width:5px}
.stat.s-total .ic{background:var(--brand-soft);color:var(--brand)}.stat.s-total .strip{background:var(--brand)}
.stat.s-award .ic{background:var(--green-bg);color:var(--green)}.stat.s-award .strip{background:var(--green)}.stat.s-award .n{color:var(--green)}
.stat.s-mid .ic{background:var(--amber-bg);color:var(--amber)}.stat.s-mid .strip{background:var(--amber)}.stat.s-mid .n{color:var(--amber)}
.stat.s-warn .ic{background:var(--red-bg);color:var(--red)}.stat.s-warn .strip{background:var(--red)}.stat.s-warn .n{color:var(--red)}
.stat.s-none .ic{background:#e2e8f0;color:var(--slate)}.stat.s-none .strip{background:var(--slate)}

/* ============================ REKAP TOTAL ============================ */
.rekap{position:relative;overflow:hidden;border-radius:var(--radius);color:#fff;
  background:linear-gradient(120deg,#312e81 0%,#4f46e5 55%,#0e7490 130%);
  box-shadow:var(--shadow-lg);padding:22px 24px;animation:rise .45s both}
.rekap::after{content:"";position:absolute;inset:0;pointer-events:none;background:
  radial-gradient(520px 180px at 95% -20%,rgba(255,255,255,.22),transparent 60%),
  radial-gradient(420px 260px at -5% 130%,rgba(6,182,212,.4),transparent 60%)}
.rekap-head{position:relative;margin-bottom:16px}
.rekap-head h2{margin:2px 0 0;font-size:18px;font-weight:900;letter-spacing:-.4px}
.rekap-grid{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media(max-width:680px){.rekap-grid{grid-template-columns:1fr}}
.rekap .rk{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);
  border-radius:14px;padding:15px 17px;backdrop-filter:blur(6px);display:flex;flex-direction:column;gap:3px}
.rekap .rk-l{font-size:12px;font-weight:700;color:rgba(255,255,255,.92)}
.rekap .rk-v{font-size:clamp(20px,3.4vw,26px);font-weight:900;letter-spacing:-.6px;line-height:1.15;word-break:break-word}
.rekap .rk-s{font-size:11px;color:rgba(255,255,255,.78);font-weight:600}

/* ============================ DASHBOARD GRID ============================ */
.dash{display:grid;grid-template-columns:320px 1fr;gap:18px}
@media(max-width:880px){.dash{grid-template-columns:1fr}}

.donut-wrap{display:flex;flex-direction:column;align-items:center;gap:16px}
.donut{position:relative;width:200px;height:200px}
.donut svg{transform:rotate(-90deg)}
.donut .center{position:absolute;inset:0;display:grid;place-items:center;text-align:center}
.donut .center .big{font-size:34px;font-weight:900;letter-spacing:-1px}
.donut .center .sm{font-size:11px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:1px}
.donut-legend{width:100%;display:flex;flex-direction:column;gap:9px}
.dl{display:flex;align-items:center;gap:10px;font-size:13px}
.dl .sw{width:13px;height:13px;border-radius:4px;flex:none}
.dl .name{flex:1;font-weight:600}
.dl .val{font-weight:800}
.dl .pct{color:var(--muted);font-size:11.5px;width:46px;text-align:right}

/* top performers */
.rank{display:flex;flex-direction:column;gap:10px}
.rank .row{display:flex;align-items:center;gap:12px;padding:11px 13px;border-radius:13px;background:var(--panel-2);border:1px solid var(--line);transition:var(--t)}
.rank .row:hover{transform:translateX(3px);border-color:var(--brand)}
.rank .pos{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;font-weight:900;font-size:13px;flex:none;background:var(--brand-soft);color:var(--brand)}
.rank .row:nth-child(1) .pos{background:#fef9c3;color:#a16207}
.rank .row:nth-child(2) .pos{background:#e2e8f0;color:#475569}
.rank .row:nth-child(3) .pos{background:#ffedd5;color:#9a3412}
.rank .meta{flex:1;min-width:0}
.rank .meta b{font-size:13px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank .meta small{font-size:11px;color:var(--muted)}
.rank .pv{font-weight:900;font-size:15px}
.tabs{display:flex;gap:6px;background:var(--panel-2);padding:5px;border-radius:11px;border:1px solid var(--line)}
.tabs button{flex:1;border:none;background:transparent;padding:8px 10px;border-radius:8px;font-weight:700;font-size:12.5px;cursor:pointer;color:var(--ink-2);transition:var(--t)}
.tabs button.active{background:var(--panel);color:var(--brand);box-shadow:var(--shadow-sm)}

/* ============================ CONTROLS ============================ */
.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}
.field label{font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;display:block;margin-bottom:6px}
select,input[type=search],input[type=number]{
  width:100%;padding:11px 13px;border:1.5px solid var(--line);border-radius:11px;font-size:14px;
  background:var(--panel);color:var(--ink);transition:var(--t);font-family:inherit;
}
select:focus,input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 4px rgba(79,70,229,.14)}
.search-box{position:relative}
.search-box svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted)}
.search-box input{padding-left:38px}

/* ============================ BUTTONS ============================ */
.btn{border:none;border-radius:11px;padding:11px 16px;font-size:13.5px;font-weight:800;cursor:pointer;
  display:inline-flex;align-items:center;gap:8px;transition:var(--t);font-family:inherit;white-space:nowrap}
.btn-primary{background:var(--grad);color:#fff;box-shadow:0 6px 16px -4px rgba(79,70,229,.5)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 22px -6px rgba(79,70,229,.6)}
.btn-soft{background:var(--brand-soft);color:var(--brand)}
.btn-soft:hover{background:var(--brand);color:#fff;transform:translateY(-2px)}
.btn-ghost{background:var(--panel-2);color:var(--ink-2);border:1px solid var(--line)}
.btn-ghost:hover{border-color:var(--brand);color:var(--brand)}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none!important}

/* ============================ TABLE ============================ */
.tablewrap{overflow-x:auto;border-radius:14px;border:1px solid var(--line)}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:13px;min-width:840px}
thead th{
  background:var(--panel-2);color:var(--ink-2);padding:13px 12px;text-align:left;font-weight:800;
  font-size:11.5px;letter-spacing:.4px;text-transform:uppercase;position:sticky;top:0;white-space:nowrap;
  border-bottom:2px solid var(--line);
}
tbody td{padding:12px;border-bottom:1px solid var(--line);vertical-align:middle}
tbody tr{transition:background var(--t)}
tbody tr:hover{background:var(--brand-soft)}
tbody tr:last-child td{border-bottom:none}
.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.kode{font-family:ui-monospace,'JetBrains Mono','Courier New',monospace;font-weight:800;
  background:var(--panel-2);padding:3px 8px;border-radius:7px;font-size:12.5px;border:1px solid var(--line)}
.satker-name{font-weight:600}
.satker-name small{display:block;color:var(--muted);font-size:11px;font-weight:500}

.badge{display:inline-flex;align-items:center;gap:5px;padding:5px 11px;border-radius:99px;font-size:11.5px;font-weight:800;white-space:nowrap}
.b-green{background:var(--green-bg);color:var(--green-ink)}
.b-amber{background:var(--amber-bg);color:var(--amber-ink)}
.b-red{background:var(--red-bg);color:var(--red-ink)}
.b-slate{background:var(--panel-2);color:var(--muted);border:1px solid var(--line)}

.prog{display:flex;align-items:center;gap:9px;min-width:130px}
.bar{flex:1;height:8px;border-radius:99px;background:var(--line);overflow:hidden}
.bar>i{display:block;height:100%;border-radius:99px;transition:width .6s cubic-bezier(.4,0,.2,1)}
.prog .pv{font-weight:800;font-size:12.5px;width:54px;text-align:right;font-variant-numeric:tabular-nums}

/* ============================ MISC ============================ */
.hidden{display:none!important}
.alert{padding:13px 15px;border-radius:12px;font-size:13.5px;margin-top:14px;display:flex;gap:10px;align-items:flex-start;font-weight:600}
.alert.err{background:var(--red-bg);color:var(--red-ink)}
.alert.info{background:var(--brand-soft);color:var(--brand)}
.pill{font-size:12px;font-weight:800;color:var(--brand);background:var(--brand-soft);padding:5px 12px;border-radius:99px}
.legend{display:flex;flex-wrap:wrap;gap:16px;font-size:12px;color:var(--muted);margin-top:16px;font-weight:600}
.legend span{display:inline-flex;align-items:center;gap:7px}
.dot{width:11px;height:11px;border-radius:4px}
.empty{text-align:center;padding:46px 20px;color:var(--muted)}
.empty .e-ic{font-size:48px;opacity:.5}
.note{font-size:11.5px;color:var(--muted);background:var(--panel-2);border:1px dashed var(--line);padding:10px 13px;border-radius:11px;margin-top:14px}
footer{text-align:center;color:var(--muted);font-size:12px;padding:24px 10px;font-weight:600}

@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.stat:nth-child(2){animation-delay:.05s}.stat:nth-child(3){animation-delay:.1s}
.stat:nth-child(4){animation-delay:.15s}.stat:nth-child(5){animation-delay:.2s}
.fade{animation:rise .4s both}

@media(max-width:600px){
  .card{padding:16px}.hero{padding:24px}
  .card-head .actions{width:100%}.card-head .actions .btn{flex:1;justify-content:center}
}
</style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <div class="inner">
    <div class="logo">
      <div class="mark">📊</div>
      <div class="txt"><small>ANALISIS KEPATUHAN</small><b>UP·GUP Analytics</b></div>
    </div>
    <div class="spacer"></div>
    <button class="icon-btn" id="themeBtn" title="Ganti tema">🌙</button>
  </div>
</div>

<div class="wrap" id="wrap">

  <!-- HERO + UPLOAD -->
  <section class="section">
    <div class="hero">
      <div class="hero-main">
        <div class="eyebrow" style="color:rgba(255,255,255,.85)">Dashboard Analisis Kepatuhan</div>
        <h1>Pantau Kepatuhan UP &amp; GUP Satker</h1>
        <p>Sistem mengunci nilai UP terakhir tiap satker lalu membandingkannya dengan total GUP per bulan. Lengkap dengan rekap total, peringatan, SANGAT BAIK, dan ekspor PDF.</p>
        <div class="chips"><span>🔒 Kode satker 6 digit</span><span>📅 Filter per bulan</span><span>⚡ 100% di perangkat Anda</span><span>🧾 Cetak PDF</span></div>
      </div>
      <label class="hero-upload" id="drop">
        <input type="file" id="fileInput" accept=".xlsx,.xls,.csv">
        <div class="hu-ic">📥</div>
        <div class="hu-t1" id="huTitle">Unggah file Excel</div>
        <div class="hu-t2" id="huSub">Tarik ke sini atau <u>klik untuk memilih</u> · .xlsx · .xls · .csv</div>
      </label>
    </div>
    <div id="uploadMsg"></div>
  </section>

  <!-- FILTER -->
  <section class="section card" id="filterCard">
    <div class="card-head">
      <div>
        <div class="eyebrow">Langkah 1</div>
        <h2>🎛️ Filter &amp; Ambang Batas</h2>
        <div class="desc">Pilih bulan untuk membandingkan total GUP terhadap UP yang terkunci. Atur ambang sesuai kebijakan satker Anda.</div>
      </div>
    </div>
    <div class="controls">
      <div class="field"><label>Bulan GUP</label><select id="fMonth"></select></div>
      <div class="field"><label>KPPN</label><select id="fKppn"><option value="">Semua KPPN</option></select></div>
      <div class="field" style="grid-column:span 2;min-width:200px">
        <label>Cari Satker</label>
        <div class="search-box">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" id="fSearch" placeholder="Nama atau kode satker…">
        </div>
      </div>
      <div class="field"><label>Batas Peringatan (%)</label><input type="number" id="thWarn" value="90" min="0" max="500"></div>
      <div class="field"><label>Batas Sangat Baik (%)</label><input type="number" id="thAward" value="100" min="0" max="500"></div>
    </div>
    <div class="legend">
      <span><i class="dot" style="background:var(--red)"></i> &lt; 90% → <b>PERINGATAN</b></span>
      <span><i class="dot" style="background:var(--amber)"></i> 90% – &lt;100% → <b>KURANG</b></span>
      <span><i class="dot" style="background:var(--green)"></i> ≥ 100% → <b>SANGAT BAIK</b></span>
      <span><i class="dot" style="background:var(--slate)"></i> belum ada GUP bulan ini</span>
    </div>
  </section>

  <!-- REKAP TOTAL (untuk KPPN) -->
  <section class="section" id="rekapSection">
    <div class="rekap">
      <div class="rekap-head">
        <div class="eyebrow" style="color:rgba(255,255,255,.85)">Rekapitulasi KPPN</div>
        <h2 id="rekapTitle">Total UP &amp; GUP Satker</h2>
      </div>
      <div class="rekap-grid">
        <div class="rk">
          <span class="rk-l">🔒 Total UP Satker</span>
          <span class="rk-v" id="rkUp">Rp 0</span>
          <span class="rk-s" id="rkUpSat">0 satker terkunci</span>
        </div>
        <div class="rk">
          <span class="rk-l">💸 Jumlah GUP Bulan Ini</span>
          <span class="rk-v" id="rkGup">Rp 0</span>
          <span class="rk-s" id="rkGupSat">0 satker ber-GUP</span>
        </div>
        <div class="rk">
          <span class="rk-l">📊 Rasio GUP / UP</span>
          <span class="rk-v" id="rkRatio">0%</span>
          <span class="rk-s">total GUP ÷ total UP</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section" id="statsSection">
    <div class="stats" id="stats"></div>
  </section>

  <!-- DASHBOARD: DONUT + RANK -->
  <section class="section dash" id="dashSection">
    <div class="card">
      <div class="card-head"><div><div class="eyebrow">Komposisi</div><h2>📈 Distribusi Capaian</h2></div></div>
      <div class="donut-wrap">
        <div class="donut">
          <svg width="200" height="200" viewBox="0 0 200 200" id="donutSvg"></svg>
          <div class="center"><div class="big" id="donutBig">0</div><div class="sm">Satker</div></div>
        </div>
        <div class="donut-legend" id="donutLegend"></div>
      </div>
    </div>
    <div class="card">
      <div class="card-head">
        <div><div class="eyebrow">Peringkat</div><h2>🏅 Sorotan Satker</h2></div>
      </div>
      <div class="tabs" id="rankTabs">
        <button data-mode="award" class="active">🏆 Tertinggi</button>
        <button data-mode="warn">⚠️ Terendah</button>
      </div>
      <div class="rank" id="rankList" style="margin-top:14px"></div>
    </div>
  </section>

  <!-- TABLE -->
  <section class="section card" id="tableCard">
    <div class="card-head">
      <div>
        <div class="eyebrow">Langkah 2</div>
        <h2>📋 Detail per Satker <span class="pill" id="sumMonthLbl"></span></h2>
        <div class="desc" id="tableInfo"></div>
      </div>
      <div class="actions" style="display:flex;gap:9px;flex-wrap:wrap">
        <button class="btn btn-ghost" id="btnPdfList">🧾 PDF Daftar</button>
        <button class="btn btn-soft" id="btnPdfWarn">⚠️ PDF Peringatan</button>
        <button class="btn btn-primary" id="btnPdfAward">🌟 PDF Sangat Baik</button>
      </div>
    </div>
    <div class="tablewrap">
      <table id="tbl">
        <thead><tr>
          <th>Kode</th><th>Nama Satker</th><th>KPPN</th>
          <th class="num">UP Terkunci</th><th class="num">Total GUP Bulan</th>
          <th>Capaian % GUP/UP</th><th>Status</th>
        </tr></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
    <div id="emptyMsg"></div>
    <div class="note">🔒 <b>UP terkunci</b> diambil dari nilai <i>Total Outstanding UP</i> pada tanggal terakhir tiap satker dalam file. <b>% GUP/UP</b> = Total GUP bulan terpilih ÷ UP × 100%.</div>
  </section>

  <footer>UP·GUP Analytics • Seluruh perhitungan berjalan lokal di browser Anda — data tidak dikirim ke mana pun.</footer>
</div><!-- /#wrap -->

<script>
/* ============ STATE ============ */
let RAW=[], UP_LOCK={}, MONTHS=[], rankMode='award';
const ID_MONTH=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const $=id=>document.getElementById(id);

/* ============ UTIL ============ */
function pad6(v){let s=String(v==null?'':v).trim().replace(/\.0+$/,'');return s.padStart(6,'0');}
function toNum(v){
  if(v==null||v==='')return 0; if(typeof v==='number')return v;
  let s=String(v).trim().replace(/\s/g,'').replace(/Rp/gi,'');
  if(s.indexOf(',')>-1&&s.indexOf('.')>-1){s=s.replace(/\./g,'').replace(',','.');}
  else if(s.indexOf(',')>-1){s=s.replace(',','.');}
  const n=parseFloat(s);return isNaN(n)?0:n;
}
function fmtRp(n){return 'Rp '+Math.round(n).toLocaleString('id-ID');}
function fmtRpShort(n){n=Math.round(n);if(n>=1e9)return 'Rp '+(n/1e9).toFixed(1).replace('.',',')+' M';if(n>=1e6)return 'Rp '+(n/1e6).toFixed(1).replace('.',',')+' jt';return 'Rp '+n.toLocaleString('id-ID');}
function fmtPct(n){return (Math.round(n*100)/100).toLocaleString('id-ID',{minimumFractionDigits:2,maximumFractionDigits:2})+'%';}
function ymLabel(ym){const[y,m]=ym.split('-');return ID_MONTH[+m-1]+' '+y;}

const MON={jan:0,feb:1,mar:2,apr:3,may:4,mei:4,jun:5,jul:6,aug:7,agu:8,agt:8,sep:9,oct:10,okt:10,nov:11,dec:11,des:11};
function parseDate(v){
  if(v instanceof Date&&!isNaN(v))return v;
  if(typeof v==='number'){const d=new Date(Math.round((v-25569)*86400*1000));return isNaN(d)?null:d;}
  if(v==null)return null; let s=String(v).trim(); if(!s)return null;
  let m=s.match(/^(\d{1,2})[-\/\s]([A-Za-z]{3,})[-\/\s](\d{2,4})$/);
  if(m){let mo=MON[m[2].slice(0,3).toLowerCase()];let y=+m[3];if(y<100)y+=2000;if(mo!=null)return new Date(y,mo,+m[1]);}
  m=s.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{2,4})$/);
  if(m){let y=+m[3];if(y<100)y+=2000;return new Date(y,+m[2]-1,+m[1]);}
  m=s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})$/);
  if(m)return new Date(+m[1],+m[2]-1,+m[3]);
  const d=new Date(s);return isNaN(d)?null:d;
}
function ymOf(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');}

function findHeader(rows){
  for(let i=0;i<Math.min(rows.length,15);i++){
    const j=rows[i].map(c=>String(c||'').toLowerCase()).join('|');
    if(j.includes('kode satker')||(j.includes('satker')&&j.includes('tanggal')))return i;
  } return -1;
}
function colMap(header){
  const norm=h=>String(h||'').toLowerCase().replace(/\s+/g,' ').trim();
  const H=header.map(norm);
  const find=(...keys)=>{for(let i=0;i<H.length;i++)for(const k of keys)if(H[i].includes(k))return i;return -1;};
  return{kode:find('kode satker','kode'),nama:find('nama satker','nama'),kppn:find('kppn'),
    sumber:find('sumber dana jenis','jenis'),tgl:find('tanggal'),gup:find('total gup'),
    up:find('total outstanding up','outstanding up','outstanding'),persen:find('persen')};
}

/* ============ FILE ============ */
function handleFile(file){
  $('uploadMsg').innerHTML='';
  const r=new FileReader();
  r.onload=e=>{try{
    const wb=XLSX.read(e.target.result,{type:'array',cellDates:true});
    const ws=wb.Sheets[wb.SheetNames[0]];
    processRows(XLSX.utils.sheet_to_json(ws,{header:1,raw:true,defval:''}));
  }catch(err){showErr('Gagal membaca file: '+err.message);}};
  r.readAsArrayBuffer(file);
}
function processRows(rows){
  const hIdx=findHeader(rows);
  if(hIdx<0){showErr('Baris header (kolom "Kode Satker") tidak ditemukan. Pastikan format file sesuai.');return;}
  const cm=colMap(rows[hIdx]);
  if(cm.kode<0||cm.tgl<0){showErr('Kolom wajib (Kode Satker / Tanggal) tidak ditemukan.');return;}
  RAW=[];
  for(let i=hIdx+1;i<rows.length;i++){
    const r=rows[i];if(!r)continue;
    const k=r[cm.kode];if(k==null||String(k).trim()==='')continue;
    const d=parseDate(r[cm.tgl]);
    RAW.push({kode:pad6(k),nama:String(cm.nama>-1?r[cm.nama]:'').trim(),
      kppn:String(cm.kppn>-1?r[cm.kppn]:'').trim(),
      jenis:String(cm.sumber>-1?r[cm.sumber]:'').trim().toUpperCase(),
      tgl:d,ym:d?ymOf(d):null,
      gup:cm.gup>-1?toNum(r[cm.gup]):0,up:cm.up>-1?toNum(r[cm.up]):0});
  }
  if(!RAW.length){showErr('Tidak ada baris data yang terbaca.');return;}
  buildUpLock();buildMonths();
  $('uploadMsg').innerHTML='<div class="alert info">✅ Memuat <b>'+RAW.length+'</b> baris · <b>'+Object.keys(UP_LOCK).length+'</b> satker.</div>';
  $('huTitle').textContent='✅ Data dimuat ('+Object.keys(UP_LOCK).length+' satker)';
  $('huSub').innerHTML='Klik untuk <u>ganti file</u> · .xlsx · .xls · .csv';
  document.querySelector('.hero-upload').classList.add('loaded');
  render();
  $('rekapSection').scrollIntoView({behavior:'smooth',block:'start'});
}
function buildUpLock(){
  UP_LOCK={};const byK={};
  RAW.forEach(r=>{if(!r.tgl)return;(byK[r.kode]=byK[r.kode]||[]).push(r);});
  for(const k in byK){const a=byK[k].slice().sort((x,y)=>y.tgl-x.tgl);
    const p=a.find(r=>r.up>0)||a[0];UP_LOCK[k]={up:p.up,nama:p.nama,kppn:p.kppn,tgl:p.tgl};}
}
function buildMonths(){
  const set=new Set();RAW.forEach(r=>{if(r.ym)set.add(r.ym);});
  MONTHS=[...set].sort();
  const sel=$('fMonth');sel.innerHTML='';
  MONTHS.forEach(m=>{const o=document.createElement('option');o.value=m;o.textContent=ymLabel(m);sel.appendChild(o);});
  if(MONTHS.length)sel.value=MONTHS[MONTHS.length-1];
  const ks=new Set();RAW.forEach(r=>{if(r.kppn)ks.add(r.kppn);});
  const ksel=$('fKppn');ksel.innerHTML='<option value="">Semua KPPN</option>';
  [...ks].sort().forEach(k=>{const o=document.createElement('option');o.value=k;o.textContent='KPPN '+k;ksel.appendChild(o);});
}

/* ============ COMPUTE ============ */
function compute(){
  const ym=$('fMonth').value,kppnF=$('fKppn').value,q=$('fSearch').value.trim().toLowerCase();
  const thWarn=toNum($('thWarn').value)||90,thAward=toNum($('thAward').value)||100;
  const gupSum={};
  RAW.forEach(r=>{if(r.ym===ym&&r.jenis.includes('GUP'))gupSum[r.kode]=(gupSum[r.kode]||0)+r.gup;});
  const out=[];
  for(const k in UP_LOCK){
    const L=UP_LOCK[k];if(kppnF&&L.kppn!==kppnF)continue;
    const totGup=gupSum[k]||0,has=Object.prototype.hasOwnProperty.call(gupSum,k),up=L.up||0;
    const pct=up>0?totGup/up*100:0;
    let cat,badge;
    if(!has){cat='Tidak Ada GUP';badge='b-slate';}
    else if(pct>=thAward){cat='SANGAT BAIK';badge='b-green';}
    else if(pct<thWarn){cat='PERINGATAN';badge='b-red';}
    else{cat='KURANG';badge='b-amber';}
    const row={kode:k,nama:L.nama,kppn:L.kppn,up,totGup,pct,cat,badge,has};
    if(q&&!(row.kode.toLowerCase().includes(q)||row.nama.toLowerCase().includes(q)))continue;
    out.push(row);
  }
  out.sort((a,b)=>b.pct-a.pct);
  const sumUp=out.reduce((s,r)=>s+r.up,0);
  const sumGup=out.reduce((s,r)=>s+r.totGup,0);
  const ratio=sumUp>0?sumGup/sumUp*100:0;
  return{ym,rows:out,thWarn,thAward,sumUp,sumGup,ratio};
}

/* ============ RENDER ============ */
function render(){
  const empty=!RAW.length;
  const d=compute();
  const mLbl=d.ym?ymLabel(d.ym):'—';
  $('sumMonthLbl').textContent=mLbl;
  $('tableInfo').textContent=empty
    ? 'Belum ada data. Unggah file Excel untuk menampilkan hasil.'
    : 'Bulan '+mLbl+' · '+d.rows.length+' satker · UP terkunci dari tanggal terakhir data';

  const total=d.rows.length,
    award=d.rows.filter(r=>r.cat==='SANGAT BAIK').length,
    cukup=d.rows.filter(r=>r.cat==='KURANG').length,
    warn=d.rows.filter(r=>r.cat==='PERINGATAN').length,
    none=d.rows.filter(r=>!r.has).length,
    withGup=d.rows.filter(r=>r.has).length;

  // Rekap total untuk KPPN
  $('rekapTitle').textContent='Total UP & GUP Satker — '+mLbl;
  $('rkUp').textContent=fmtRp(d.sumUp);
  $('rkUpSat').textContent=total+' satker terkunci';
  $('rkGup').textContent=fmtRp(d.sumGup);
  $('rkGupSat').textContent=withGup+' satker ber-GUP bulan ini';
  $('rkRatio').textContent=fmtPct(d.ratio);

  $('stats').innerHTML=`
    ${stat('s-total','🏢',total,'Total Satker')}
    ${stat('s-award','🌟',award,'Sangat Baik')}
    ${stat('s-mid','🔻',cukup,'Kurang')}
    ${stat('s-warn','⚠️',warn,'Peringatan')}
    ${stat('s-none','➖',none,'Tanpa GUP')}`;

  renderDonut([
    {n:'Sangat Baik',v:award,c:'#059669'},
    {n:'Kurang',v:cukup,c:'#d97706'},
    {n:'Peringatan',v:warn,c:'#dc2626'},
    {n:'Tanpa GUP',v:none,c:'#94a3b8'},
  ],total);
  renderRank(d.rows);
  renderTable(d.rows);
}
function stat(cls,ic,n,l){return `<div class="stat ${cls}"><span class="strip"></span><div class="top"><div class="ic">${ic}</div></div><div class="n">${n}</div><div class="l">${l}</div></div>`;}

function renderDonut(parts,total){
  const svg=$('donutSvg');const C=2*Math.PI*70;let off=0;svg.innerHTML='';
  const bg=document.createElementNS('http://www.w3.org/2000/svg','circle');
  bg.setAttribute('cx',100);bg.setAttribute('cy',100);bg.setAttribute('r',70);
  bg.setAttribute('fill','none');bg.setAttribute('stroke','var(--line)');bg.setAttribute('stroke-width',26);
  svg.appendChild(bg);
  if(total>0)parts.forEach(p=>{
    if(p.v<=0)return;const len=p.v/total*C;
    const c=document.createElementNS('http://www.w3.org/2000/svg','circle');
    c.setAttribute('cx',100);c.setAttribute('cy',100);c.setAttribute('r',70);
    c.setAttribute('fill','none');c.setAttribute('stroke',p.c);c.setAttribute('stroke-width',26);
    c.setAttribute('stroke-dasharray',len+' '+(C-len));c.setAttribute('stroke-dashoffset',-off);
    c.style.transition='stroke-dashoffset .6s ease';svg.appendChild(c);off+=len;
  });
  $('donutBig').textContent=total;
  $('donutLegend').innerHTML=parts.map(p=>`<div class="dl"><span class="sw" style="background:${p.c}"></span>
    <span class="name">${p.n}</span><span class="val">${p.v}</span>
    <span class="pct">${total?Math.round(p.v/total*100):0}%</span></div>`).join('');
}

function renderRank(rows){
  let list=rows.filter(r=>r.has);
  list = rankMode==='award' ? list.slice().sort((a,b)=>b.pct-a.pct) : list.slice().sort((a,b)=>a.pct-b.pct);
  list=list.slice(0,5);
  const el=$('rankList');
  if(!list.length){el.innerHTML='<div class="empty"><div class="e-ic">📭</div><div>Belum ada data GUP.</div></div>';return;}
  el.innerHTML=list.map((r,i)=>{
    const col=r.cat==='SANGAT BAIK'?'var(--green)':r.cat==='PERINGATAN'?'var(--red)':'var(--amber)';
    return `<div class="row"><div class="pos">${i+1}</div>
      <div class="meta"><b title="${r.nama}">${r.nama||r.kode}</b><small>${r.kode} · ${fmtRpShort(r.totGup)}</small></div>
      <div class="pv" style="color:${col}">${fmtPct(r.pct)}</div></div>`;
  }).join('');
}

function renderTable(rows){
  const tb=$('tbody');tb.innerHTML='';
  if(!rows.length){
    const msg = RAW.length
      ? '<div class="e-ic">🔍</div><div>Tidak ada satker yang cocok dengan filter.</div>'
      : '<div class="e-ic">📂</div><div><b>Belum ada data.</b><br>Unggah file Excel pada kotak di atas untuk menampilkan hasil.</div>';
    $('emptyMsg').innerHTML='<div class="empty">'+msg+'</div>';return;
  }
  $('emptyMsg').innerHTML='';
  rows.forEach(r=>{
    const col=r.cat==='SANGAT BAIK'?'var(--green)':r.cat==='PERINGATAN'?'var(--red)':r.cat==='KURANG'?'var(--amber)':'#94a3b8';
    const w=Math.min(100,Math.max(0,r.pct));
    const ic=r.cat==='SANGAT BAIK'?'🌟':r.cat==='PERINGATAN'?'⚠️':r.cat==='KURANG'?'🔻':'➖';
    const tr=document.createElement('tr');tr.className='fade';
    tr.innerHTML=`
      <td><span class="kode">${r.kode}</span></td>
      <td><div class="satker-name">${r.nama||'-'}</div></td>
      <td>${r.kppn?'<span class="badge b-slate">KPPN '+r.kppn+'</span>':'-'}</td>
      <td class="num">${fmtRp(r.up)}</td>
      <td class="num">${fmtRp(r.totGup)}</td>
      <td><div class="prog"><div class="bar"><i style="width:${w}%;background:${col}"></i></div><span class="pv">${r.has?fmtPct(r.pct):'–'}</span></div></td>
      <td><span class="badge ${r.badge}">${ic} ${r.cat}</span></td>`;
    tb.appendChild(tr);
  });
}

/* ============ PDF ============ */
function makePDF(filter,title){
  const {jsPDF}=window.jspdf;const d=compute();let rows=d.rows;
  if(filter==='warn')rows=rows.filter(r=>r.cat==='PERINGATAN');
  if(filter==='award')rows=rows.filter(r=>r.cat==='SANGAT BAIK');
  if(!rows.length){alert('Tidak ada data untuk dicetak pada kategori ini.');return;}
  const doc=new jsPDF({orientation:'landscape',unit:'mm',format:'a4'});
  const W=doc.internal.pageSize.getWidth();
  doc.setFillColor(79,70,229);doc.rect(0,0,W,26,'F');
  doc.setTextColor(255,255,255);doc.setFontSize(15);doc.setFont(undefined,'bold');doc.text(title,14,12);
  doc.setFontSize(9);doc.setFont(undefined,'normal');
  doc.text('Bulan: '+ymLabel(d.ym)+'   |   Peringatan <'+d.thWarn+'%   |   Kurang '+d.thWarn+'-<'+d.thAward+'%   |   Sangat Baik \u2265'+d.thAward+'%',14,19);
  doc.text('Dicetak: '+new Date().toLocaleString('id-ID'),14,23.5);
  // Total untuk baris yang dicetak
  const tUp=rows.reduce((s,r)=>s+r.up,0);
  const tGup=rows.reduce((s,r)=>s+r.totGup,0);
  const tRatio=tUp>0?tGup/tUp*100:0;
  const withGup=rows.filter(r=>r.has).length;

  const body=rows.map((r,i)=>[i+1,r.kode,r.nama||'-',r.kppn||'-',fmtRp(r.up),fmtRp(r.totGup),r.has?fmtPct(r.pct):'-',r.cat]);
  const foot=[['','','TOTAL '+rows.length+' SATKER','',fmtRp(tUp),fmtRp(tGup),fmtPct(tRatio),'']];
  doc.autoTable({startY:30,
    head:[['No','Kode','Nama Satker','KPPN','UP Terkunci','Total GUP Bulan','% GUP/UP','Capaian']],body,foot,
    styles:{fontSize:8,cellPadding:2.2},headStyles:{fillColor:[99,102,241],textColor:255,fontStyle:'bold'},
    footStyles:{fillColor:[49,46,129],textColor:255,fontStyle:'bold',fontSize:8.5},
    alternateRowStyles:{fillColor:[244,245,251]},
    columnStyles:{0:{halign:'center',cellWidth:10},1:{halign:'center'},4:{halign:'right'},5:{halign:'right'},6:{halign:'right'},7:{halign:'center',fontStyle:'bold'}},
    didParseCell:c=>{
      if(c.section==='foot'){
        if(c.column.index===2)c.cell.styles.halign='right';
        if([4,5,6].includes(c.column.index))c.cell.styles.halign='right';
      }
      if(c.section==='body'&&c.column.index===7){const v=c.cell.raw;
      if(v==='SANGAT BAIK')c.cell.styles.textColor=[5,150,105];
      else if(v==='PERINGATAN')c.cell.styles.textColor=[220,38,38];
      else if(v==='KURANG')c.cell.styles.textColor=[217,119,6];else c.cell.styles.textColor=[100,116,139];}},
    didDrawPage:()=>{doc.setFontSize(8);doc.setTextColor(120);
      doc.text('Hal '+doc.internal.getCurrentPageInfo().pageNumber,W-14,doc.internal.pageSize.getHeight()-6,{align:'right'});}});

  let y=doc.lastAutoTable.finalY+9;if(y>doc.internal.pageSize.getHeight()-40){doc.addPage();y=20;}
  // Kotak rekap total
  doc.setDrawColor(99,102,241);doc.setFillColor(238,242,255);
  doc.roundedRect(14,y,W-28,26,2.5,2.5,'FD');
  doc.setTextColor(49,46,129);doc.setFontSize(11);doc.setFont(undefined,'bold');
  doc.text('REKAPITULASI — '+ymLabel(d.ym),18,y+7);
  doc.setFontSize(9.5);doc.setFont(undefined,'normal');doc.setTextColor(30,41,59);
  const colW=(W-36)/3;
  doc.setFont(undefined,'normal');doc.text('Total UP Satker',18,y+15);
  doc.text('Jumlah GUP Satker',18+colW,y+15);
  doc.text('Rasio GUP / UP',18+colW*2,y+15);
  doc.setFont(undefined,'bold');doc.setFontSize(12);doc.setTextColor(49,46,129);
  doc.text(fmtRp(tUp),18,y+22);
  doc.text(fmtRp(tGup),18+colW,y+22);
  doc.text(fmtPct(tRatio),18+colW*2,y+22);
  let y2=y+34;if(y2>doc.internal.pageSize.getHeight()-12){doc.addPage();y2=20;}
  doc.setFont(undefined,'normal');doc.setFontSize(8.5);doc.setTextColor(100,116,139);
  doc.text(rows.length+' satker tercetak  ·  '+withGup+' satker ber-GUP bulan ini  ·  Peringatan <'+d.thWarn+'%  ·  Kurang '+d.thWarn+'-<'+d.thAward+'%  ·  Sangat Baik \u2265'+d.thAward+'%',14,y2);
  doc.save(title.replace(/\s+/g,'_')+'_'+d.ym+'.pdf');
}

/* ============ EVENTS ============ */
function showErr(m){$('uploadMsg').innerHTML='<div class="alert err">❌ '+m+'</div>';}
const drop=$('drop'),fi=$('fileInput');
fi.addEventListener('change',e=>{if(e.target.files[0])handleFile(e.target.files[0]);});
['dragenter','dragover'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('drag');}));
