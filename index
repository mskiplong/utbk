function delU(id){const u=DB.users.find(x=>x.id===id);if(!u||!confirm(`Hapus "${u.name}"?`))return;DB.users=DB.users.filter(x=>x.id!==id);DB.results=DB.results.filter(x=>x.userId!==id);save();renderUserTable();toast('User dihapus','info');}
function resetPW(id){const u=DB.users.find(x=>x.id===id);if(!u)return;const p=prompt(`Reset PW untuk ${u.name}:`);if(!p||p.length<6){toast('PW tidak valid','error');return;}u.password=p;save();toast('Password direset','success');}
function renderAdmStats(){
  const allS=DB.results.flatMap(r=>r.results.map(x=>x.finalScore||x.totalScore||0));
  $('aStG').innerHTML=[['👥 User',DB.users.length,'var(--ac)'],['📚 Soal',Object.values(DB.questions).flat().length,'var(--pu)'],['🏛 PTN',DB.ptnData.length,'var(--gn)'],['🏆 Tryout',DB.results.reduce((s,r)=>s+(r.results?.length||0),0),'var(--or)'],['📊 Avg',allS.length?Math.round(allS.reduce((a,b)=>a+b,0)/allS.length):'—','var(--cy)'],['🏅 Max',allS.length?Math.max(...allS):'—','var(--yw)']].map(([l,v,c])=>`<div class="sc" style="--al:${c}"><div class="sv" style="color:${c}">${v}</div><div class="sl">${l}</div></div>`).join('');
  if(allS.length){const ctx=$('aChart').getContext('2d');if(CH.adm)CH.adm.destroy();const bins=Array(10).fill(0);allS.forEach(s=>{const i=Math.min(9,Math.floor((s-300)/50));bins[Math.max(0,i)]++;});const isDark=darkMode,tc=isDark?'#8b949e':'#656d76',gc=isDark?'rgba(255,255,255,.06)':'rgba(0,0,0,.06)';CH.adm=new Chart($('aChart').getContext('2d'),{type:'bar',data:{labels:bins.map((_,i)=>`${300+i*50}–${349+i*50}`),datasets:[{label:'Siswa',data:bins,backgroundColor:'rgba(88,166,255,.6)',borderColor:'#58a6ff',borderWidth:1.5,borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:tc,font:{size:9}}},y:{ticks:{color:tc},grid:{color:gc}}}}});}
}

/* ══ UTILS ══ */
function $(id){return document.getElementById(id);}
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function movAvg(data,w){return data.map((_,i)=>{const sl=data.slice(Math.max(0,i-w+1),i+1);return Math.round(sl.reduce((a,b)=>a+b,0)/sl.length*10)/10;});}
function dl(content,name,type){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([content],{type}));a.download=name;a.click();}
function toast(msg,type='info'){const w=$('toastW');const t=document.createElement('div');t.className=`toast ${type}`;t.innerHTML=`<span>${type==='success'?'✅':type==='error'?'❌':type==='warn'?'⚠️':'ℹ️'}</span><span>${msg}</span>`;w.appendChild(t);setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(110%)';t.style.transition='all .3s';setTimeout(()=>t.remove(),300);},3500);}
function closeM(id){$(id)?.classList.add('hidden');}
document.querySelectorAll('.overlay').forEach(ov=>ov.addEventListener('click',e=>{if(e.target===ov)ov.classList.add('hidden');}));
window.addEventListener('beforeunload',e=>{if(exam.active){e.preventDefault();e.returnValue='';}});

