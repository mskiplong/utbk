/* ============ PDF ============ */
function pdfBase(title){
  const {jsPDF}=window.jspdf;const doc=new jsPDF({orientation:'landscape',unit:'mm',format:'a4'});
  const W=doc.internal.pageSize.getWidth();const bln=$('fMonth').value;
  doc.setFillColor(13,148,136);doc.rect(0,0,W,26,'F');
  doc.setTextColor(255,255,255);doc.setFontSize(15);doc.setFont(undefined,'bold');doc.text(title,14,12);
  doc.setFontSize(9);doc.setFont(undefined,'normal');
  doc.text('Bulan: '+monthLabel(bln)+'   |   \u2265100 Sangat Baik · <100 Kurang · =0 Peringatan',14,19);
  doc.text('Dicetak: '+new Date().toLocaleString('id-ID'),14,23.5);
  return {doc,W,bln};
}
function pdfFinish(doc,W){doc.setFontSize(8);doc.setTextColor(120);
  const p=doc.internal.getNumberOfPages();for(let i=1;i<=p;i++){doc.setPage(i);doc.text('Hal '+i+' / '+p,W-14,doc.internal.pageSize.getHeight()-6,{align:'right'});}}
function commonTable(doc,head,body,foot,colStyles,catCol){
  doc.autoTable({startY:30,head:[head],body,foot:foot?[foot]:undefined,
    styles:{fontSize:7.8,cellPadding:2},headStyles:{fillColor:[8,145,178],textColor:255,fontStyle:'bold'},
    footStyles:{fillColor:[19,78,74],textColor:255,fontStyle:'bold'},alternateRowStyles:{fillColor:[240,253,250]},
    columnStyles:colStyles||{},
    didParseCell:c=>{if(catCol!=null&&c.section==='body'&&c.column.index===catCol){const v=String(c.cell.raw);
      if(v.includes('SANGAT BAIK'))c.cell.styles.textColor=[5,150,105];
      else if(v.includes('PERINGATAN'))c.cell.styles.textColor=[220,38,38];
      else if(v.includes('KURANG'))c.cell.styles.textColor=[217,119,6];
      else if(v.includes('CAPUT'))c.cell.styles.textColor=[8,145,178];}}});
}
function bySatker(rows){return rows.slice().sort((a,b)=>a.kode.localeCompare(b.kode,'id',{numeric:true}));}
function pdfSatker(){
  const d=compute();if(!d.rows.length){alert('Tidak ada data.');return;}
  const {doc,W}=pdfBase('Ringkasan Nilai IKPA Satker');
  // Urut: Sangat Baik (nilai tertinggi) paling atas. Belum kirim CAPUT ditaruh paling bawah.
  const rows=d.rows.slice().sort((a,b)=>{
    if(a.belumCaput!==b.belumCaput)return a.belumCaput?1:-1;
    return b.nilai-a.nilai;
  });
  const body=rows.map((r,i)=>[i+1,r.kode,r.nama||'-',r.kppn||'-',r.ro,r.roLow,fmtN(r.nilai),r.cat,r.belumCaput?'Belum CAPUT':(r.bermasalah?'Belum Valid':'Lengkap')]);
  const active=d.rows.filter(r=>!r.belumCaput);const avg=active.length?active.reduce((s,r)=>s+r.nilai,0)/active.length:0;
  const foot=['','','TOTAL '+d.rows.length+' SATKER','',d.rows.reduce((s,r)=>s+r.ro,0),d.rows.reduce((s,r)=>s+r.roLow,0),'rata '+fmtN(avg),'',''];
  commonTable(doc,['No','Kode','Nama Satker','KPPN','RO','RO<100','Nilai IKPA','Kategori','Status Lapor'],body,foot,
    {0:{halign:'center',cellWidth:9},4:{halign:'center'},5:{halign:'center'},6:{halign:'right'},7:{halign:'center',fontStyle:'bold'}},7);
  pdfFinish(doc,W);doc.save('Ringkasan_Satker_bln'+d.bln+'.pdf');
}
function pdfRoLow(){
  const d=compute();const list=getRoLowList(d);if(!list.length){alert('Tidak ada RO <100.');return;}
  const {doc,W}=pdfBase('Daftar RO dengan Nilai < 100 (dikelompokkan per satker, beserta penyebab)');
  // Penomoran melekat: nomor satker (1,2,3...) + sub-nomor RO dalam satker (1.1, 1.2, ...)
  let satkerNo=0, lastKode=null, sub=0;
  const body=list.map(r=>{
    const firstOfGroup = r.kode!==lastKode;
    if(firstOfGroup){satkerNo++;sub=0;lastKode=r.kode;}
    sub++;
    const noSatker = firstOfGroup ? String(satkerNo) : '';
    const noRO = satkerNo+'.'+sub;
    return [
      noSatker,
      firstOfGroup?r.kode:'',
      firstOfGroup?(r.satkerNama||r.nama||'-'):'',
      noRO,
      kodeRO(r),
      r.uraian||'-',
      r.progressBlank?'0':fmtN(r.progress),
      r.pcroBlank?'-':fmtN(r.pcro),
      fmtN(r.nilai),
      'Progress RO '+(r.progressBlank?'0':fmtN(r.progress))+' belum mencapai Target PCRO '+(r.pcroBlank?'-':fmtN(r.pcro))
    ];
  });
  commonTable(doc,['No','Kode Satker','Satker','No RO','Kode RO','Uraian RO','Progress RO','Target PCRO','Nilai','Keterangan Penyebab'],body,null,
    {0:{cellWidth:9,halign:'center',fontStyle:'bold'},1:{cellWidth:18,fontStyle:'bold'},2:{cellWidth:38},3:{cellWidth:11,halign:'center'},4:{cellWidth:15,halign:'center'},5:{cellWidth:48},6:{halign:'right'},7:{halign:'right'},8:{halign:'right'},9:{cellWidth:62}});
  pdfFinish(doc,W);doc.save('RO_dibawah_100_bln'+d.bln+'.pdf');
}
function pdfBV(){
  const d=compute();const list=bySatker(d.rows.filter(r=>r.bermasalah));if(!list.length){alert('Tidak ada satker bermasalah.');return;}
  const {doc,W}=pdfBase('Satker Belum Terkonfirmasi / Tidak Valid');
  const body=list.map((r,i)=>[i+1,r.kode,r.nama||'-',r.kppn||'-',r.belumKonf,r.tidakValid,
    [r.belumKonf>0?'Belum Konfirmasi':'',r.tidakValid>0?'Tidak Valid':''].filter(Boolean).join(' & ')]);
  commonTable(doc,['No','Kode','Nama Satker','KPPN','RO Blm Konfirmasi','RO Tidak Valid','Status'],body,null,
    {0:{halign:'center',cellWidth:9},4:{halign:'center'},5:{halign:'center'}});
  pdfFinish(doc,W);doc.save('Belum_Valid_bln'+d.bln+'.pdf');
}
function pdfCaput(){
