function toExportRows(data){
  return data.map((r,i)=>({'No.':i+1,'Bank':r._bank||'','Tahun':r._year||'','Bulan':MONTHS_FULL[parseInt(r._month)-1]||r._month||'','Kode BA':r.kode_ba||'','Nama BA':r.nama_ba||'','Kode Eselon':r.kode_eselon||'','Nama Eselon':r.nama_eselon||'','Kode Kanwil':r.kode_kanwil||'','Kode KPPN Mitra Satker':r.kode_kppn||'','Kode Satker':r.kode_satker||'','Nama Satker':r.nama_satker||'','No Rekening Induk':r.no_rek_induk||'','Nama Rekening Induk':r.nama_rek_induk||'','No Rekening VA':r.no_rek_va||'','Nama Rekening VA':r.nama_rek_va||'','Saldo VA':pN(r.saldo_va)||0,'Jumlah Trx CMS':pN(r.jml_cms)||0,'Nilai CMS':pN(r.nilai_cms)||0,'Jumlah Trx Kartu Debit':pN(r.jml_debit)||0,'Nilai Kartu Debit':pN(r.nilai_debit)||0,'Jumlah Trx Teller':pN(r.jml_teller)||0,'Nilai Teller':pN(r.nilai_teller)||0,'Status Rekening':r.status||''}));
}
function expRekap(fmt){
  const data=G.rekapDisp.length?G.rekapDisp:G.rekapData;if(!data.length){toast('Tidak ada data!','error');return;}
  const rows=toExportRows(data);const nm=`Rekap_VA_${tstamp()}`;
  if(fmt==='xlsx'){const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(rows),'Rekap VA');XLSX.writeFile(wb,nm+'.xlsx');}
  else if(fmt==='csv'){dlBlob(XLSX.utils.sheet_to_csv(XLSX.utils.json_to_sheet(rows)),nm+'.csv','text/csv');}
  else{dlBlob(JSON.stringify(rows,null,2),nm+'.json','application/json');}
  toast(`Export ${fmt.toUpperCase()} berhasil!`,'success');
}
