function refreshSatkerList(){
  var dl=document.getElementById('satkerList');
  if(!dl) return;
  var map=buildIndex();var seen={};var opt='';
  Object.keys(map).forEach(function(k){var sk=map[k];var key=sk.kode+sk.nama;if(seen[key])return;seen[key]=1;opt+='<option value="'+sk.kode+' - '+sk.nama+'">';});
  dl.innerHTML=opt;
}

// ============ DATA LOADING ============
function rowsToData(aoa){
  // find header rows: locate row containing 'Kode Satker' then data after the two-row header
  // Standard layout: NO, Kode Satker, Nama, Kode KPPN, Kode Eselon1, Periode, then 4x(51,52,53,57) Rencana/Penyerapan/Deviasi/%Deviasi
  // We map by position relative to the row whose first numeric is data. Robust approach: find header.
  var headerRow=-1;
  for(var i=0;i<Math.min(aoa.length,15);i++){
    var joined=(aoa[i]||[]).join('|').toLowerCase();
    if(joined.indexOf('kode satker')>=0){headerRow=i;break;}
  }
  var start = headerRow>=0? headerRow+2 : 0;
  var out=[];
  for(var r=start;r<aoa.length;r++){
    var row=aoa[r]||[];
    var no=row[0];
    if(no===undefined||no===null||String(no).trim()==='') continue;
    if(!/^\d+$/.test(String(no).trim())) continue;
    var kode=pad6(String(row[1]||'').replace(/\D/g,''));
    if(!kode||kode==='000000') continue;
    var nama=String(row[2]||'').trim();
    var kppn=String(row[3]||'').trim();
    var es1=String(row[4]||'').trim();
    var bulan=parseInt(String(row[5]||'').replace(/\D/g,''),10);
    if(!bulan||bulan<1||bulan>12) continue;
    out.push([kode,nama,kppn,es1,bulan,
      num(row[6]),num(row[7]),num(row[8]),num(row[9]),
      num(row[10]),num(row[11]),num(row[12]),num(row[13])]);
  }
  return out;
}
function num(x){
  if(x===undefined||x===null) return 0;
  if(typeof x==='number') return isNaN(x)?0:Math.round(x);
  var s=String(x).trim().replace(/"/g,'');
  if(s===''||s==='-') return 0;
  // handle indonesian decimal/scientific like "8,36E+08"; strip stray chars
  var v=parseFloat(s.replace(',', '.').replace(/[^0-9.eE+\-]/g,''));
  return isNaN(v)?0:Math.round(v);
}

function loadData(data,label){
  if(!data||!data.length){
    showMsg('err','❌ Tidak ada baris data valid ditemukan dalam file.');
    return;
  }
  RAW=data;
  // months present
  initMonth();
  document.getElementById('drop').classList.add('loaded');
  document.getElementById('huTitle').textContent='Data dimuat';
  document.getElementById('huSub').innerHTML=label+' · <u>klik untuk ganti file</u>';
  document.getElementById('btnClear').classList.remove('hidden');
  showMsg('ok','✅ Berhasil memuat '+data.length+' baris dari '+ new Set(data.map(function(d){return d[0]+d[3];})).size +' satker.');
  render();
  refreshSatkerList();
}
function clearData(){
  RAW=[];
  initMonth();
  document.getElementById('drop').classList.remove('loaded');
  document.getElementById('huTitle').textContent='Unggah file Excel / CSV';
  document.getElementById('huSub').innerHTML='Tarik ke sini atau <u>klik untuk memilih</u> · .xlsx · .xls · .csv';
  document.getElementById('btnClear').classList.add('hidden');
  document.getElementById('fileInput').value='';
  showMsg('','');
  render();
  refreshSatkerList();
}
function showMsg(type,txt){
  var box=document.getElementById('uploadMsg');
  if(!txt){box.innerHTML='';return;}
  box.innerHTML='<div class="alert '+(type==='err'?'err':'ok')+'">'+txt+'</div>';
}

function handleFile(file){
  var name=file.name;var ext=name.split('.').pop().toLowerCase();
  var reader=new FileReader();
  reader.onload=function(e){
    try{
      var wb=XLSX.read(e.target.result,{type:'array'});
      var ws=wb.Sheets[wb.SheetNames[0]];
      var aoa=XLSX.utils.sheet_to_json(ws,{header:1,raw:true,defval:''});
      var data=rowsToData(aoa);
      loadData(data, name);
    }catch(err){
      showMsg('err','❌ Gagal membaca file: '+err.message);
    }
  };
  reader.readAsArrayBuffer(file);
}

function initMonth(){
  var sel=document.getElementById('fMonth');
  var present=[...new Set(RAW.map(function(r){return r[IDX.bulan];}))];
  var html='';
  for(var m=1;m<=12;m++){
    var has=present.indexOf(m)>=0;
    html+='<option value="'+m+'"'+(has?'':' disabled')+'>Bulan '+m+' — '+MONNAME[m]+(has?'':' (tidak ada data)')+'</option>';
  }
  sel.innerHTML=html;
  var last=present.length?Math.max.apply(null,present):1;
  state.bulan=last;sel.value=last;
}
function syncTabs(){
  document.querySelectorAll('#catTabs button').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-cat')===state.cat);});
  document.getElementById('fCat').value=state.cat;
}

document.addEventListener('DOMContentLoaded',function(){
  var fi=document.getElementById('fileInput');var drop=document.getElementById('drop');
  fi.addEventListener('change',function(e){if(e.target.files[0])handleFile(e.target.files[0]);});
  ['dragover','dragenter'].forEach(function(ev){drop.addEventListener(ev,function(e){e.preventDefault();drop.classList.add('drag');});});
  ['dragleave','drop'].forEach(function(ev){drop.addEventListener(ev,function(e){e.preventDefault();drop.classList.remove('drag');});});
  drop.addEventListener('drop',function(e){if(e.dataTransfer.files[0])handleFile(e.dataTransfer.files[0]);});

  document.getElementById('btnClear').addEventListener('click',function(e){e.preventDefault();e.stopPropagation();clearData();});

  document.getElementById('fMonth').addEventListener('change',function(e){state.bulan=parseInt(e.target.value,10);render();});
  document.getElementById('fCat').addEventListener('change',function(e){state.cat=e.target.value;syncTabs();render();});
  document.getElementById('fSort').addEventListener('change',function(e){state.sort=e.target.value;render();});
  document.getElementById('fSearch').addEventListener('input',function(e){state.q=e.target.value;render();});
  document.querySelectorAll('#catTabs button').forEach(function(b){b.addEventListener('click',function(){state.cat=b.getAttribute('data-cat');syncTabs();render();});});
  document.getElementById('btnPdf').addEventListener('click',doPrint);
  document.getElementById('btnPdfKum').addEventListener('click',doPrintKum);
  document.getElementById('themeBtn').addEventListener('click',function(){var h=document.documentElement;var d=h.getAttribute('data-theme')==='dark';h.setAttribute('data-theme',d?'light':'dark');this.textContent=d?'🌙':'☀️';});

  // ---- Piagam ----
  pgPeriodeOptions();
  pgSyncNarasi();
  document.getElementById('pgPeriodeJenis').addEventListener('change',function(){pgPeriodeOptions();renderPiagam();});
  document.getElementById('pgPeriodeDetail').addEventListener('change',renderPiagam);
  document.getElementById('pgTahun').addEventListener('input',renderPiagam);
  document.getElementById('pgCari').addEventListener('change',function(e){pgFillFromSatker(e.target.value);});
  document.getElementById('pgKategori').addEventListener('change',function(){var el=document.getElementById('pgNarasi');el.dataset.touched='';pgSyncNarasi();renderPiagam();});
  document.getElementById('pgNarasi').addEventListener('input',function(e){e.target.dataset.touched='1';renderPiagam();});
  ['pgKode','pgNama','pgNomor','pgKota','pgTanggal','pgNomorND','pgTanggalND','pgJabatan','pgNamaTtd','pgNip'].forEach(function(id){
    document.getElementById(id).addEventListener('input',renderPiagam);
  });
  document.getElementById('btnPiagamPdf').addEventListener('click',doPiagamPdf);
  document.getElementById('btnPiagamWord').addEventListener('click',doPiagamWord);
  window.addEventListener('resize',function(){clearTimeout(window.__pgRz);window.__pgRz=setTimeout(renderPiagam,200);});

  // tampilkan dashboard kosong sejak awal
  initMonth();
  render();
  renderPiagam();
});
})();
</script>
