function buildPreviewTable(headers, rows, isMapping){
  let html='<table>';
  html+='<thead><tr>';
  html+='<th class="th-no">#</th>';
  headers.forEach((h)=>{
    const isNum=isMapping?(FIELDS.find(f=>f.key===h)?.type==='number'):false;
    const label=isMapping?(FIELDS.find(f=>f.key===h)?.label||h):h;
    html+=`<th style="${isNum?'color:#34d399;text-align:right;':''}">${label}</th>`;
  });
  html+='</tr></thead>';
  html+='<tbody>';
  rows.forEach((row,ri)=>{
    html+='<tr>';
    html+=`<td class="td-no-sticky">${ri+1}</td>`;
    headers.forEach((h,ci)=>{
      let val=Array.isArray(row)?(row[ci]??''):(row[h]??'');
      val=String(val);
      const isNum=isMapping?(FIELDS.find(f=>f.key===h)?.type==='number'):false;
      const display=val.length>40?val.slice(0,40)+'…':val;
      html+=`<td class="${isNum?'td-num':''}" title="${val.replace(/"/g,'&quot;')}">${display}</td>`;
    });
    html+='</tr>';
  });
  html+='</tbody></table>';
  return html;
}

