  document.getElementById('prt-date-pbn').textContent=today();
  let rekapFil=rek.filter(r=>{
    if(bank&&r._bank!==bank)return false;if(year&&r._year!==year)return false;
    if(month&&String(r._month).padStart(2,'0')!==month)return false;return true;
  });
  const rekapBySatker={};
  rekapFil.forEach(r=>{
    const k=String(r.kode_satker||'').trim();if(!k)return;
    if(!rekapBySatker[k]){rekapBySatker[k]={jml_cms:0,nilai_cms:0,jml_debit:0,nilai_debit:0,jml_teller:0,nilai_teller:0,saldo_va:0};}
    rekapBySatker[k].jml_cms+=pN(r.jml_cms);rekapBySatker[k].nilai_cms+=pN(r.nilai_cms);
    rekapBySatker[k].jml_debit+=pN(r.jml_debit);rekapBySatker[k].nilai_debit+=pN(r.nilai_debit);
    rekapBySatker[k].jml_teller+=pN(r.jml_teller);rekapBySatker[k].nilai_teller+=pN(r.nilai_teller);
    if(pN(r.saldo_va)>rekapBySatker[k].saldo_va)rekapBySatker[k].saldo_va=pN(r.saldo_va);
  });
  let combined=ruh.map(r=>{
    const k=String(r.kode_satker||'').trim();const rekapD=rekapBySatker[k]||null;
    return{kode_satker:k,nama_satker:r.nama_satker||'',kode_ba:r.kode_ba||'',nama_ba:r.nama_ba||'',kode_eselon:r.kode_eselon||'',
      jml_cms:rekapD?rekapD.jml_cms:0,nilai_cms:rekapD?rekapD.nilai_cms:0,
      jml_debit:rekapD?rekapD.jml_debit:0,nilai_debit:rekapD?rekapD.nilai_debit:0,
      jml_teller:rekapD?rekapD.jml_teller:0,nilai_teller:rekapD?rekapD.nilai_teller:0,
      saldo_va:rekapD?rekapD.saldo_va:0,sudahCms:rekapD&&rekapD.jml_cms>0};
  });
  if(show==='sudah')combined=combined.filter(r=>r.sudahCms);
  else if(show==='belum')combined=combined.filter(r=>!r.sudahCms);
  combined.sort((a,b)=>b.jml_cms-a.jml_cms);
  G.pbnData=combined;G.pbnPage=1;
  const sudah=combined.filter(r=>r.sudahCms).length;const belum=combined.filter(r=>!r.sudahCms).length;
  document.getElementById('pbn-stats').innerHTML=`
    ${scCard('bl','🏛','Total Satker RUH',ruh.length,'')}
    ${scCard('gr','✅','Sudah CMS',sudah,Math.round((sudah/Math.max(ruh.length,1))*100)+'%')}
    ${scCard('rd','⚠','Belum CMS',belum,Math.round((belum/Math.max(ruh.length,1))*100)+'%')}
    ${scCard('cy','📊','Kepatuhan',Math.round((sudah/Math.max(ruh.length,1))*100)+'%','')}
  `;
  document.getElementById('pbn-cnt').textContent=combined.length+' satker';
  renderPbnTable();
}
