     '<div class="pg-ttd"><div class="box">'+
       '<div class="place">'+(kota?kota+', ':'')+tgl+'</div>'+
       '<div class="jab">'+jabatan+'</div>'+
       '<div class="el">Ditandatangani secara elektronik.<br>Nomor: '+nomorND+'&nbsp;&nbsp;Tanggal: '+tanggalND+'</div>'+
       '<div class="nm">'+namaTtd+'</div>'+
       '<div class="nip">'+nip+'</div>'+
     '</div></div>'+
   '</div></div>';
  return {css:css,html:html};
}
function renderPiagam(){
  var p=buildPiagamHTML(false);
  var wrap=document.getElementById('piagamPreviewWrap');
  var PW=793.7, PH=1122.5; // 210mm x 297mm dalam px @96dpi
  var avail=(wrap?wrap.clientWidth:800)-36;
  var scale=Math.min(1, avail/PW); if(scale<0.2) scale=0.2;
  var ow=Math.round(PW*scale), oh=Math.round(PH*scale);
  document.getElementById('piagamPreview').innerHTML='<style>'+p.css+'</style>'+
    '<div style="width:'+ow+'px;height:'+oh+'px;margin:0 auto;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,.18)">'+
    '<div style="transform:scale('+scale.toFixed(4)+');transform-origin:top left;width:'+PW+'px">'+p.html+'</div></div>';
}
function buildPiagamDoc(){
  var p=buildPiagamHTML(true);
  return '<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><title>Piagam Penghargaan</title>'+
    '<style>@page{size:A4 portrait;margin:0}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}'+
    'body{margin:0}'+p.css+'</style></head><body>'+p.html+'</body></html>';
}
function doPiagamPdf(){
  var w=window.open('','_blank');
