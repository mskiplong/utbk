<script>
/* ══ CONSTANTS ══ */
const SUBS=[
  {name:"Tes Intelegensia Umum",        code:"TIU", n:35,time:100,grp:"SKD",     col:"#58a6ff", score:5},
  {name:"Tes Wawasan Kebangsaan",       code:"TWK", n:30,time:100,grp:"SKD",     col:"#bc8cff", score:5},
  {name:"Tes Karakteristik Pribadi",    code:"TKP", n:45,time:100,grp:"SKD",     col:"#3fb950", score:5},
  {name:"Tes Potensi Akademik",         code:"TPA", n:50,time:60, grp:"TPA",     col:"#d29922", score:5},
  {name:"Tes Bahasa Inggris",           code:"TBI", n:50,time:60, grp:"TBI",     col:"#f85149", score:5},
];
const TOTAL_Q=210, EXAM_SEC=160*60;

/* ══ SCORING ENGINE ══ */
function calcSTAN(qs,ans){
  const sec={};
  SUBS.forEach(s=>{sec[s.name]={score:0,total:s.n,correct:0,wrong:0,skip:0};});
  qs.forEach((q,i)=>{
    const s=sec[q.section];if(!s)return;
    const ua=ans[i],ca=normAns(q.answer);
    if(!ua){s.skip++; return;}
    
    // TKP: pembobotan 1-5 per opsi
    if(q.section === 'Tes Karakteristik Pribadi'){
      s.correct++; // semua jawaban dihitung
      let weight = 0;
      // Format answer bisa: "5,4,3,2,1" atau "A:5,B:4,C:3,D:2,E:1" atau "A"
      if(typeof q.answer === 'string' && q.answer.includes(',')){
        const parts = q.answer.split(',');
        const map = {};
        const letters = ['A','B','C','D','E'];
        parts.forEach((p,idx)=>{
          p = p.trim();
          if(p.includes(':')){
            const [k,v] = p.split(':');
            map[k.trim().toUpperCase()] = parseInt(v) || 0;
          } else {
            map[letters[idx]] = parseInt(p) || 0;
          }
        });
        weight = map[ua.toUpperCase()] || 0;
      } else {
        // fallback: jika hanya 1 kunci, beri 5 untuk jawaban terbaik, 1 untuk lainnya
        weight = isCorr(ua, ca) ? 5 : 1;
      }
      s.score += weight;
    } else {
      // TIU, TWK, TPA, TBI: benar +5, salah 0
      if(isCorr(ua,ca)){
        s.correct++;
        s.score += 5;
      } else {
        s.wrong++;
      }
    }
  });
  const scaled={};
  SUBS.forEach(s=>{
    const d=sec[s.name];
    scaled[s.name]=d;
  });
  const sum=Object.values(scaled).reduce((a,b)=>a+b.score,0);
  const groups={
    SKD: SUBS.filter(s=>s.grp==='SKD').reduce((a,b)=>a+scaled[b.name].score,0),
    TPA: scaled['Tes Potensi Akademik']?.score||0,
    TBI: scaled['Tes Bahasa Inggris']?.score||0,
  };
  return{sections:scaled,groups,finalScore:sum};
}
function normAns(a){
  if(!a)return'A';
  if(typeof a==='number')return['A','B','C','D','E'][a]||'A';
  const s=String(a).trim().toUpperCase();
  if(['A','B','C','D','E'].includes(s))return s;
  const n=parseInt(s);if(!isNaN(n)&&n>=0&&n<=4)return['A','B','C','D','E'][n];
  return'A';
}
function isCorr(u,c){return String(c).split(',').map(x=>x.trim().toUpperCase()).includes(String(u).toUpperCase());}
function normOpts(q){if(Array.isArray(q.options))return q.options.map(o=>String(o).replace(/^[A-Ea-e][.)]\s*/,'').trim());return['A','B','C','D','E'];}
function clamp(v,mn,mx){return Math.max(mn,Math.min(mx,v));}

/* ══ STATE ══ */
let DB={users:[],questions:{},results:[]};
let CU=null;
let exam={active:false,qs:[],ans:{},flags:new Set(),idx:0,timer:null,left:EXAM_SEC};
let CH={trend:null,radar:null,bar:null,rasio:null,adm:null};
let rMode='peluang',rScore=0;
let darkMode=true;
let qListPage={}; // {sectionName: pageNum}

/* ══ STORAGE ══ */
function save(){try{localStorage.setItem('snbtpro',JSON.stringify(DB));}catch(e){toast('Storage penuh!','error');}}
function load(){
