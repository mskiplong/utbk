  $('appWrap').classList.add('hidden');
  $('loginErr').classList.add('hidden');
  $('lgU').value='';$('lgP').value='';
}
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&$('loginScreen').style.display!=='none')doLogin();});
function toggleMob(){$('mobNav').classList.toggle('open');}
function closeMob(){$('mobNav').classList.remove('open');}

/* ══ NAVIGATION ══ */
function G(page){
  document.querySelectorAll('[id^="pg-"]').forEach(el=>el.classList.add('hidden'));
  document.querySelectorAll('.ni').forEach(el=>el.classList.remove('active'));
  const el=$('pg-'+page);if(el)el.classList.remove('hidden');
  document.querySelectorAll('.ni').forEach(btn=>{if(btn.getAttribute('onclick')?.includes(`'${page}'`))btn.classList.add('active');});
  if(page==='home')renderHome();
  if(page==='hasil')renderHasil();
  if(page==='rasio')initRasio();
  if(page==='db'&&CU?.role==='admin')initDB();
  if(page==='admin'&&CU?.role==='admin')initAdmin();
  if(page==='sim'&&!exam.active)renderSimReady();
}

/* ══ HOME ══ */
function renderHome(){
  const tq=Object.values(DB.questions).reduce((s,a)=>s+(a?.length||0),0);
  $('hTQ').textContent=tq;$('hTP').textContent=DB.ptnData.length;$('hTT').textContent=getMyR().length;
  $('hSubT').innerHTML=SUBS.map(s=>{
    const av=(DB.questions[s.name]||[]).length,ok=av>=s.n;
    return`<tr><td><span style="color:${s.col};font-weight:600">${s.name}</span></td><td><span class="badge bg-blue">${s.code}</span></td><td><strong>${s.n}</strong></td><td style="color:var(--tx2)">${s.time}m</td><td><span class="badge bg-gray">${s.grp}</span></td><td><span class="badge ${ok?'bg-green':'bg-yellow'}">${av}/${s.n} ${ok?'✓':'⚠'}</span></td></tr>`;
  }).join('');
  const rec=getMyR().slice(-3).reverse();
  if(rec.length){
    $('hRec').classList.remove('hidden');
    $('hRecL').innerHTML=rec.map(r=>`<div style="display:flex;align-items:center;justify-content:space-between;padding:11px;background:var(--sf);border-radius:var(--rs);margin-bottom:7px;border:1px solid var(--bd)">
      <div><div style="font-weight:700;font-size:13px">${r.label}</div><div style="color:var(--tx2);font-size:10px">${r.date}</div></div>
      <div style="text-align:right"><div style="font-size:22px;font-weight:900;color:var(--ac)">${r.finalScore}</div><div style="font-size:10px;color:var(--tx2)">Skor IRT</div></div>
    </div>`).join('');
  }else{$('hRec').classList.add('hidden');}
}
function getMyR(){if(!CU)return[];return(DB.results.find(r=>r.userId===CU.id)||{results:[]}).results;}
function addMyR(result){let ur=DB.results.find(r=>r.userId===CU.id);if(!ur){ur={userId:CU.id,results:[]};DB.results.push(ur);}ur.results.push(result);save();}

/* ══ SIMULATION ══ */
function renderSimReady(){
  $('simReady').classList.remove('hidden');$('simActive').classList.add('hidden');$('simRes').classList.add('hidden');
  let ok=true;
  $('sSubI').innerHTML=SUBS.map(s=>{
    const av=(DB.questions[s.name]||[]).length,isOk=av>=s.n;if(!isOk)ok=false;
    return`<div style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:var(--sf);border:1px solid var(--bd);border-radius:var(--rs);margin-bottom:5px">
      <div style="display:flex;align-items:center;gap:7px"><span style="font-weight:700;font-size:11px;color:${s.col}">[${s.code}]</span><span style="font-size:12px">${s.name}</span><span class="badge bg-gray" style="font-size:9px">${s.grp}</span></div>
      <span class="badge ${isOk?'bg-green':'bg-yellow'}" style="font-size:10px">${av}/${s.n}</span>
    </div>`;
  }).join('');
  $('sWarn').classList.toggle('hidden',ok);
}

function sTab(id,btn){
  // Hide sibling content divs
  const el=document.getElementById(id);if(!el)return;
  const parent=el.parentElement;
  if(parent){Array.from(parent.children).forEach(c=>{if(c.tagName!=='BUTTON'&&!c.classList.contains('tabs'))c.classList.add('hidden');});}
  el.classList.remove('hidden');
  // Active tab
  if(btn){const tp=btn.closest('.tabs');if(tp)tp.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));btn.classList.add('active');}
}

function startSim(){
  const qs=[];
  SUBS.forEach(s=>{
    const pool=shuffle([...(DB.questions[s.name]||[])]);
    const picked=pool.slice(0,s.n);
    for(let i=picked.length;i<s.n;i++){picked.push({id:`ph_${s.code}_${i}`,section:s.name,question:`[Placeholder] Soal ${s.code} No.${i+1}. Upload soal di Database.`,options:['Pilihan A','Pilihan B','Pilihan C','Pilihan D','Pilihan E'],answer:'A',difficulty:'easy',passage:'',explanation:'',isPlaceholder:true});}
    qs.push(...picked);
  });
  exam={active:true,qs,ans:{},flags:new Set(),idx:0,timer:null,left:EXAM_SEC};
  $('simReady').classList.add('hidden');$('simActive').classList.remove('hidden');$('simRes').classList.add('hidden');
  buildNav();renderQ();startTimer();
}
function startTimer(){if(exam.timer)clearInterval(exam.timer);exam.timer=setInterval(()=>{exam.left--;updTimerUI();if(exam.left<=0){clearInterval(exam.timer);finishExam();}},1000);}
function updTimerUI(){const el=$('eTimer'),h=Math.floor(exam.left/3600),m=Math.floor((exam.left%3600)/60),s=exam.left%60;el.textContent=`${h>0?String(h).padStart(2,'0')+':':''}${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;el.className='timer'+(exam.left<300?' danger':exam.left<600?' warn':'');}
function renderQ(){
  const q=exam.qs[exam.idx];if(!q)return;
  const si=SUBS.find(s=>s.name===q.section);
  const sub=$('eSub');sub.textContent=si?`[${si.code}] ${q.section}`:q.section;sub.style.cssText=si?`background:${si.col}20;color:${si.col};border:1px solid ${si.col}40`:'';
  const ss=getSS(q.section),sn=si?.n||0,li=exam.idx-ss;
  $('ePrg').textContent=`Soal ${exam.idx+1}/${exam.qs.length} — ${q.section}: ${li+1}/${sn}`;
  const diff=q.difficulty||'medium';
  $('eDiff').innerHTML=`<span class="dbadge d${diff[0]}">${diff.toUpperCase()} • IRT ×${IRT[diff]||1.5}</span>`;
  const pa=$('ePas');if(q.passage){pa.classList.remove('hidden');pa.textContent=q.passage;}else{pa.classList.add('hidden');}
  $('eQ').textContent=`${exam.idx+1}. ${q.question}`;
