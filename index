/* ─── PASTE IMPORT ─── */
function importQFromPaste(){
  const txt=$('qPaste').value.trim();
  if(!txt){toast('Paste kosong','error');return;}
  try{
    let parsed=[];
    if(txt.startsWith('[')||txt.startsWith('{')){
      parsed=JSON.parse(txt);if(!Array.isArray(parsed))parsed=[parsed];
    }else{
      const res=Papa.parse(txt,{header:true,skipEmptyLines:true});
      parsed=res.data.map(rowToQ);
    }
    const target=$('upSec').value;
    let added=0,skipped=0;
    parsed.forEach(q=>{
      if(!q.question && !q.questionImg){skipped++;return;}
      let sec=target==='auto'?q.section:target;
      const match=SUBS.find(s=>s.name===sec||s.name.toLowerCase()===sec?.toLowerCase()||s.code===sec);
      if(!match){skipped++;return;}
      q.section=match.name;
      if(!['easy','medium','hard'].includes((q.difficulty||'').toLowerCase()))q.difficulty='medium';
      q.passageImg=q.passageImg||'';q.questionImg=q.questionImg||'';
      if(!DB.questions[q.section])DB.questions[q.section]=[];
      DB.questions[q.section].push({...q,id:Date.now().toString()+Math.random().toString(36).slice(2,7)});
      added++;
    });
    save();renderQCards();renderHome();toast(`✅ ${added} soal diimpor${skipped?`, ${skipped} dilewati`:''}`,added>0?'success':'error');$('qPaste').value='';
  }catch(e){toast('❌ Gagal parse: '+e.message,'error');}
}
