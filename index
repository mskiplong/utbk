/* ─── BACKUP SELECTIVE ─── */
function backupSelected(){
  const data={version:'4.0',date:new Date().toISOString()};
  if($('bkQ')?.checked) data.questions=DB.questions;
  if($('bkR')?.checked) data.results=DB.results;
  if($('bkU')?.checked) data.users=DB.users;
  dl(JSON.stringify(data,null,2),`stanpro_pilihan_${new Date().toISOString().split('T')[0]}.json`,'application/json');
  toast('✅ Backup pilihan diunduh','success');
}
function toggleBk(all){
  ['bkQ','bkR','bkU'].forEach(id=>{const el=$(id);if(el)el.checked=all;});
}
function updateBkCounts(){
  const qc=Object.values(DB.questions).reduce((s,a)=>s+a.length,0);
  if($('bkQC'))$('bkQC').textContent=qc;
}

/* ══ UTILS ══ */
function $(id){return document.getElementById(id);}
function escHtml(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function movAvg(data,w){return data.map((_,i)=>{const sl=data.slice(Math.max(0,i-w+1),i+1);return Math.round(sl.reduce((a,b)=>a+b,0)/sl.length*10)/10;});}
function dl(content,name,type){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([content],{type}));a.download=name;a.click();}
function toast(msg,type='info'){const w=$('toastW');const t=document.createElement('div');t.className=`toast ${type}`;t.innerHTML=`<span>${type==='success'?'✅':type==='error'?'❌':type==='warn'?'⚠️':'ℹ️'}</span><span>${msg}</span>`;w.appendChild(t);setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(110%)';t.style.transition='all .3s';setTimeout(()=>t.remove(),300);},3500);}
function closeM(id){$(id)?.classList.add('hidden');}
document.querySelectorAll('.overlay').forEach(ov=>ov.addEventListener('click',e=>{if(e.target===ov)ov.classList.add('hidden');}));
window.addEventListener('beforeunload',e=>{if(exam.active){e.preventDefault();e.returnValue='';}});

