// ============================================================
// AUTO-REFRESH (monitor mode)
// ============================================================
let autoRefreshTimer = null;
let autoRefreshInterval = 60; // seconds
let autoRefreshBusy = false; // Prevent overlapping runs

function toggleAutoRefresh() {
  const btn = document.getElementById('btnAutoRefresh');
  const statAuto = document.getElementById('statAuto');
  const autoIntervalEl = document.getElementById('autoInterval');
  
  if (autoRefreshTimer) {
    // Stop
    clearInterval(autoRefreshTimer);
    autoRefreshTimer = null;
    btn.textContent = '⏱️ Auto-Refresh: OFF';
    btn.classList.remove('success');
    btn.classList.add('secondary');
    statAuto.style.display = 'none';
    showStatus('info', '⏱️ Auto-refresh dimatikan.');
  } else {
    // Ask for interval
    const input = prompt('Interval auto-refresh (dalam detik, min 10):', '60');
    if (!input) return;
    const seconds = parseInt(input);
    if (!seconds || seconds < 10) {
      alert('Minimal 10 detik.');
      return;
    }
    autoRefreshInterval = seconds;
    
    // Define the auto-refresh cycle: fetch + verify + delta detect
    const autoRefreshCycle = async () => {
      if (autoRefreshBusy) {
        console.log('[Auto-Refresh] Skip cycle (previous still running)');
        return;
      }
      autoRefreshBusy = true;
      try {
        console.log(`[Auto-Refresh] Cycle start at ${new Date().toLocaleString('id-ID')}`);
        // Step 1: Fetch latest data (overwrites previous)
        await fetchAllData(true);
        // Step 2: Verify + detect changes
        await verifyAllStudents(true); // silent mode
        console.log(`[Auto-Refresh] Cycle complete`);
      } catch (e) {
        console.error('[Auto-Refresh] Error:', e);
      } finally {
        autoRefreshBusy = false;
      }
    };
    
    // Run immediately, then on interval
    autoRefreshCycle();
    autoRefreshTimer = setInterval(autoRefreshCycle, seconds * 1000);
    
    btn.textContent = `⏱️ Auto-Refresh: ON (${seconds}s)`;
    btn.classList.remove('secondary');
    btn.classList.add('success');
    statAuto.style.display = 'inline-block';
    autoIntervalEl.textContent = `setiap ${seconds} detik`;
    showStatus('success', `⏱️ Auto-refresh aktif setiap ${seconds} detik. Akan otomatis: fetch → verifikasi → deteksi perubahan. Tab harus tetap terbuka.`);
  }
}

function updateStats() {
  document.getElementById('statTotal').textContent = allStudents.length;
  
  // Use verification data if available
  const verified = allStudents.filter(r => r.verified);
  const smpn9 = verified.filter(r => r.is_smpn9).length;
  const lain = verified.filter(r => !r.is_smpn9).length;
  document.getElementById('statDiterima').textContent = smpn9;
  document.getElementById('statLain').textContent = lain;
  
  const newCount = allStudents.filter(r => !knownRegnos.has(r.regno)).length;
  document.getElementById('statNew').textContent = newCount;
  const lf = localStorage.getItem(CONFIG.lastFetchKey);
  if (lf) {
    document.getElementById('statLastFetch').textContent = new Date(lf).toLocaleString('id-ID');
  }
}
