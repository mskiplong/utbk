function onRuhFile(e){
  const file=e.target.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=ev=>{try{
    const wb=XLSX.read(new Uint8Array(ev.target.result),{type:'array'});
    const ws=wb.Sheets[wb.SheetNames[0]];
    const raw=XLSX.utils.sheet_to_json(ws,{header:1,defval:'',raw:false});
    if(!raw.length){toast('File kosong!','error');return;}
    ruhHeaders2=raw[0].map((h,i)=>String(h||'').trim()||`Col_${i+1}`);
    ruhRawData=raw.slice(1);
    ['ruh-kode-col','ruh-nama-col','ruh-ba-col','ruh-namaBA-col'].forEach(id=>{
      const el=document.getElementById(id);
      el.innerHTML='<option value="">— Pilih kolom —</option>'+ruhHeaders2.map(h=>`<option>${h}</option>`).join('');
    });
    const kodeMatch=ruhHeaders2.find(h=>/(kode.?satker|kd.?satker|satker.?code)/i.test(h));
    const namaMatch=ruhHeaders2.find(h=>/(nama.?satker|nama.?unit|satuan.?kerja)/i.test(h));
    const baMatch=ruhHeaders2.find(h=>/(kode.?ba|bagian.?anggaran)/i.test(h));
    const namaBaMatch=ruhHeaders2.find(h=>/(nama.?ba|nama.?bagian)/i.test(h));
    if(kodeMatch)document.getElementById('ruh-kode-col').value=kodeMatch;
    if(namaMatch)document.getElementById('ruh-nama-col').value=namaMatch;
    if(baMatch)document.getElementById('ruh-ba-col').value=baMatch;
    if(namaBaMatch)document.getElementById('ruh-namaBA-col').value=namaBaMatch;
    const mc=Math.min(ruhHeaders2.length,8);
    let h=`<table class="rank-tbl" style="font-size:0.67rem;min-width:max-content;"><thead><tr>${ruhHeaders2.slice(0,mc).map(hd=>`<th>${hd}</th>`).join('')}</tr></thead><tbody>`;
    ruhRawData.slice(0,5).forEach(row=>{h+=`<tr>${row.slice(0,mc).map(v=>`<td>${v||''}</td>`).join('')}</tr>`;});
    h+=`</tbody></table>`;
    const prev=document.getElementById('ruh-prev');prev.innerHTML=h;prev.style.display='block';
    toast(`File dibaca: ${ruhRawData.length} baris`,'success');
  }catch(err){toast('Gagal baca: '+err.message,'error');}};
  reader.readAsArrayBuffer(file);
}
function importRuh(){
  if(!ruhRawData){toast('Upload file terlebih dahulu!','error');return;}
  const kodeCol=document.getElementById('ruh-kode-col').value;const namaCol=document.getElementById('ruh-nama-col').value;
  const baCol=document.getElementById('ruh-ba-col').value;const namaBaCol=document.getElementById('ruh-namaBA-col').value;
  if(!kodeCol||!namaCol){toast('Pilih kolom Kode & Nama Satker!','error');return;}
  const ki=ruhHeaders2.indexOf(kodeCol),ni=ruhHeaders2.indexOf(namaCol);
  const bi=baCol?ruhHeaders2.indexOf(baCol):-1,nbi=namaBaCol?ruhHeaders2.indexOf(namaBaCol):-1;
  const db=getDB();if(!db.ruh)db.ruh=[];let added=0,updated=0;
  ruhRawData.forEach(row=>{
    const kode=String(row[ki]||'').trim();const nama=String(row[ni]||'').trim();if(!kode||!nama)return;
    const exist=db.ruh.findIndex(r=>r.kode_satker===kode);
    const entry={kode_satker:kode,nama_satker:nama,kode_ba:bi>=0?String(row[bi]||'').trim():'',nama_ba:nbi>=0?String(row[nbi]||'').trim():'',kode_eselon:'',status:'Aktif'};
    if(exist>=0){db.ruh[exist]={...db.ruh[exist],...entry};updated++;}else{db.ruh.push(entry);added++;}
  });
  setDB(db);renderRuh();document.getElementById('ruh-upload-panel').style.display='none';
  toast(`Import selesai: ${added} ditambah, ${updated} diperbarui`,'success');
}
function renderRuh(){
  const db=getDB();const ruh=db.ruh||[];
  const kw=(document.getElementById('ruh-search')?.value||'').toLowerCase();
  const baF=document.getElementById('ruh-ba-filter')?.value||'';
  const bas=[...new Set(ruh.map(r=>r.kode_ba).filter(Boolean))].sort();
  const el=document.getElementById('ruh-ba-filter');
  if(el)el.innerHTML='<option value="">Semua BA</option>'+bas.map(b=>`<option>${b}</option>`).join('');
  document.getElementById('ruh-cnt').textContent=ruh.length+' satker';
  document.getElementById('nb-ruh').textContent=ruh.length;
  let data=ruh.filter(r=>{
    if(baF&&r.kode_ba!==baF)return false;
    if(kw){const hay=(r.kode_satker+' '+r.nama_satker).toLowerCase();if(!hay.includes(kw))return false;}
    return true;
  });
  const tot=Math.ceil(data.length/G.ps);const page=pSlice(data,G.ruhPage);const start=(G.ruhPage-1)*G.ps;
  document.getElementById('ruh-tbody').innerHTML=!page.length
    ?'<tr><td colspan="8"><div class="empty"><div class="ei">🏛</div><p>Belum ada satker</p></div></td></tr>'
    :page.map((r,i)=>{
      const globalIdx=ruh.findIndex(x=>x.kode_satker===r.kode_satker);
      return`<tr>
        <td class="td-no">${start+i+1}</td>
        <td class="td-code" style="color:var(--cyan);">${r.kode_satker||'—'}</td>
        <td class="fw7">${r.nama_satker||'—'}</td>
        <td class="td-code">${r.kode_ba||'—'}</td>
        <td>${r.nama_ba||'—'}</td>
        <td class="td-code">${r.kode_eselon||'—'}</td>
        <td class="td-c">${statusBadge(r.status||'Aktif')}</td>
        <td class="td-c">
          <button class="btn bg2 bxs" onclick="editRuh(${globalIdx})">✏</button>
          <button class="btn bd bxs" onclick="delRuh(${globalIdx})">✕</button>
        </td>
      </tr>`;
    }).join('');
  document.getElementById('ruh-pgn').innerHTML=`<div class="pgn"><div class="pgi">${pInfo(data,G.ruhPage)}</div>${buildPgn(G.ruhPage,tot,'ruhGo')}</div>`;
}
