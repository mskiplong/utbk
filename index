<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Capaian RO / IKPA Analytics — Analisis Capaian Output Satker</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
:root{
  --brand:#0d9488; --brand2:#0f766e; --brand-soft:#ccfbf1;
  --green:#059669; --green-bg:#d1fae5; --green-ink:#065f46;
  --amber:#d97706; --amber-bg:#fef3c7; --amber-ink:#92400e;
  --red:#dc2626;   --red-bg:#fee2e2;   --red-ink:#991b1b;
  --slate:#64748b;
  --bg:#f0fdfa; --panel:#ffffff; --panel-2:#f6fbfa;
  --ink:#0f172a; --ink-2:#475569; --muted:#94a3b8;
  --line:#e3eeec;
  --radius:18px; --radius-sm:12px;
  --shadow-sm:0 1px 3px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04);
  --shadow:0 12px 28px -8px rgba(15,23,42,.16), 0 4px 10px -4px rgba(15,23,42,.08);
  --shadow-lg:0 28px 60px -16px rgba(13,148,136,.30);
  --grad:linear-gradient(135deg,#0d9488 0%,#0891b2 55%,#0ea5e9 130%);
  --t:.25s cubic-bezier(.4,0,.2,1);
}
html[data-theme="dark"]{
  --bg:#04130f; --panel:#0c1a18; --panel-2:#0a1513;
  --ink:#f1f5f9; --ink-2:#cbd5e1; --muted:#64748b;
  --line:#16302b; --brand-soft:#053b34;
  --green-bg:#052e22; --amber-bg:#3a2a06; --red-bg:#3a0d0d;
  --green-ink:#6ee7b7; --amber-ink:#fcd34d; --red-ink:#fca5a5;
  --shadow:0 12px 30px -10px rgba(0,0,0,.6); --shadow-sm:0 1px 3px rgba(0,0,0,.4);
}
*{box-sizing:border-box} html,body{margin:0;padding:0}
body{font-family:'Inter','Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif;
  background:var(--bg);color:var(--ink);min-height:100vh;line-height:1.5;
  -webkit-font-smoothing:antialiased;transition:background var(--t),color var(--t);}
::selection{background:rgba(13,148,136,.25)}
*::-webkit-scrollbar{height:10px;width:10px}
*::-webkit-scrollbar-thumb{background:var(--line);border-radius:99px}
*::-webkit-scrollbar-thumb:hover{background:var(--muted)}

.topbar{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--panel) 82%,transparent);
  backdrop-filter:saturate(180%) blur(14px);border-bottom:1px solid var(--line);}
.topbar .inner{max-width:1340px;margin:0 auto;padding:12px 18px;display:flex;align-items:center;gap:14px}
.logo{display:flex;align-items:center;gap:11px;font-weight:800;letter-spacing:-.3px}
.logo .mark{width:38px;height:38px;border-radius:11px;background:var(--grad);color:#fff;display:grid;place-items:center;font-size:19px;box-shadow:var(--shadow-lg);}
.logo .txt small{display:block;font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.5px}
.logo .txt b{font-size:16px;display:block;line-height:1.1}
.spacer{flex:1}
.icon-btn{width:40px;height:40px;border-radius:11px;border:1px solid var(--line);background:var(--panel);cursor:pointer;display:grid;place-items:center;font-size:17px;transition:var(--t);color:var(--ink);}
.icon-btn:hover{background:var(--brand-soft);border-color:var(--brand);transform:translateY(-1px)}

.wrap{max-width:1340px;margin:0 auto;padding:22px 18px 70px}
.section{margin-bottom:22px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:22px;transition:var(--t);}
.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.card-head h2{margin:0;font-size:17px;font-weight:800;letter-spacing:-.3px;display:flex;align-items:center;gap:9px}
.card-head .desc{font-size:13px;color:var(--muted);margin-top:3px;max-width:640px}
.eyebrow{font-size:11px;font-weight:800;letter-spacing:1.4px;color:var(--brand);text-transform:uppercase}

.hero{position:relative;overflow:hidden;border-radius:var(--radius);background:var(--grad);color:#fff;padding:30px 34px;box-shadow:var(--shadow-lg);display:flex;align-items:center;gap:26px;flex-wrap:wrap;}
.hero::after{content:"";position:absolute;inset:0;background:radial-gradient(600px 200px at 90% -10%,rgba(255,255,255,.22),transparent 60%),radial-gradient(400px 300px at 0% 120%,rgba(14,165,233,.4),transparent 60%);pointer-events:none}
.hero-main{position:relative;flex:1;min-width:280px}
.hero h1{margin:0 0 8px;font-size:clamp(22px,4vw,32px);font-weight:900;letter-spacing:-.8px}
.hero p{margin:0;max-width:560px;color:rgba(255,255,255,.9);font-size:14px}
.hero .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.hero .chips span{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.25);padding:5px 12px;border-radius:99px;font-size:12px;font-weight:600;backdrop-filter:blur(4px)}
.hero-upload{position:relative;flex:0 0 300px;max-width:340px;width:100%;border:2px dashed rgba(255,255,255,.6);border-radius:16px;background:rgba(255,255,255,.10);padding:24px 20px;text-align:center;cursor:pointer;transition:var(--t);color:#fff;}
@media(max-width:760px){.hero-upload{flex:1 1 100%;max-width:none}}
.hero-upload:hover,.hero-upload.drag{background:rgba(255,255,255,.22);border-color:#fff;transform:translateY(-2px)}
.hero-upload.loaded{background:rgba(16,185,129,.25);border-color:rgba(167,243,208,.9);border-style:solid}
.hero-upload .hu-ic{font-size:40px;line-height:1}
.hero-upload .hu-t1{font-weight:800;margin-top:8px;font-size:15px}
.hero-upload .hu-t2{font-size:12px;color:rgba(255,255,255,.85);margin-top:4px}
.hero-upload u{font-weight:800;text-underline-offset:2px}
#fileInput{display:none}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}
.stat{position:relative;overflow:hidden;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-sm);padding:16px;box-shadow:var(--shadow-sm);transition:var(--t);animation:rise .5s both;}
.stat:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.stat .ic{width:36px;height:36px;border-radius:11px;display:grid;place-items:center;font-size:17px}
.stat .n{font-size:26px;font-weight:900;letter-spacing:-1px;margin-top:9px;line-height:1}
.stat .l{font-size:12px;color:var(--muted);margin-top:3px;font-weight:600}
.stat .strip{position:absolute;left:0;top:0;bottom:0;width:5px}
.stat.s-total .ic{background:var(--brand-soft);color:var(--brand)}.stat.s-total .strip{background:var(--brand)}
.stat.s-award .ic{background:var(--green-bg);color:var(--green)}.stat.s-award .strip{background:var(--green)}.stat.s-award .n{color:var(--green)}
.stat.s-mid .ic{background:var(--amber-bg);color:var(--amber)}.stat.s-mid .strip{background:var(--amber)}.stat.s-mid .n{color:var(--amber)}
.stat.s-warn .ic{background:var(--red-bg);color:var(--red)}.stat.s-warn .strip{background:var(--red)}.stat.s-warn .n{color:var(--red)}
.stat.s-none .ic{background:#e2e8f0;color:var(--slate)}.stat.s-none .strip{background:var(--slate)}
.stat.s-cyan .ic{background:#cffafe;color:#0891b2}.stat.s-cyan .strip{background:#0891b2}.stat.s-cyan .n{color:#0891b2}

.rekap{position:relative;overflow:hidden;border-radius:var(--radius);color:#fff;background:linear-gradient(120deg,#134e4a 0%,#0d9488 55%,#0369a1 130%);box-shadow:var(--shadow-lg);padding:22px 24px;animation:rise .45s both}
.rekap::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(520px 180px at 95% -20%,rgba(255,255,255,.22),transparent 60%),radial-gradient(420px 260px at -5% 130%,rgba(14,165,233,.4),transparent 60%)}
.rekap-head{position:relative;margin-bottom:16px}
.rekap-head h2{margin:2px 0 0;font-size:18px;font-weight:900;letter-spacing:-.4px}
.rekap-grid{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:780px){.rekap-grid{grid-template-columns:1fr 1fr}}
@media(max-width:460px){.rekap-grid{grid-template-columns:1fr}}
.rekap .rk{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:14px;padding:15px 17px;backdrop-filter:blur(6px);display:flex;flex-direction:column;gap:3px}
.rekap .rk-l{font-size:12px;font-weight:700;color:rgba(255,255,255,.92)}
.rekap .rk-v{font-size:clamp(19px,3vw,25px);font-weight:900;letter-spacing:-.6px;line-height:1.15;word-break:break-word}
.rekap .rk-s{font-size:11px;color:rgba(255,255,255,.78);font-weight:600}

.dash{display:grid;grid-template-columns:320px 1fr;gap:18px}
@media(max-width:880px){.dash{grid-template-columns:1fr}}
.donut-wrap{display:flex;flex-direction:column;align-items:center;gap:16px}
.donut{position:relative;width:200px;height:200px}
.donut svg{transform:rotate(-90deg)}
.donut .center{position:absolute;inset:0;display:grid;place-items:center;text-align:center}
.donut .center .big{font-size:34px;font-weight:900;letter-spacing:-1px}
.donut .center .sm{font-size:11px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:1px}
.donut-legend{width:100%;display:flex;flex-direction:column;gap:9px}
.dl{display:flex;align-items:center;gap:10px;font-size:13px}
.dl .sw{width:13px;height:13px;border-radius:4px;flex:none}
.dl .name{flex:1;font-weight:600}.dl .val{font-weight:800}
.dl .pct{color:var(--muted);font-size:11.5px;width:46px;text-align:right}
.rank{display:flex;flex-direction:column;gap:10px}
.rank .row{display:flex;align-items:center;gap:12px;padding:11px 13px;border-radius:13px;background:var(--panel-2);border:1px solid var(--line);transition:var(--t)}
.rank .row:hover{transform:translateX(3px);border-color:var(--brand)}
.rank .pos{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;font-weight:900;font-size:13px;flex:none;background:var(--brand-soft);color:var(--brand)}
.rank .row:nth-child(1) .pos{background:#fef9c3;color:#a16207}
.rank .row:nth-child(2) .pos{background:#e2e8f0;color:#475569}
.rank .row:nth-child(3) .pos{background:#ffedd5;color:#9a3412}
.rank .meta{flex:1;min-width:0}
.rank .meta b{font-size:13px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank .meta small{font-size:11px;color:var(--muted)}
.rank .pv{font-weight:900;font-size:15px}
.tabs-mini{display:flex;gap:6px;background:var(--panel-2);padding:5px;border-radius:11px;border:1px solid var(--line)}
.tabs-mini button{flex:1;border:none;background:transparent;padding:8px 10px;border-radius:8px;font-weight:700;font-size:12.5px;cursor:pointer;color:var(--ink-2);transition:var(--t)}
.tabs-mini button.active{background:var(--panel);color:var(--brand);box-shadow:var(--shadow-sm)}

.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}
.field label{font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;display:block;margin-bottom:6px}
select,input[type=search],input[type=number]{width:100%;padding:11px 13px;border:1.5px solid var(--line);border-radius:11px;font-size:14px;background:var(--panel);color:var(--ink);transition:var(--t);font-family:inherit;}
select:focus,input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 4px rgba(13,148,136,.14)}
.search-box{position:relative}
.search-box svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted)}
.search-box input{padding-left:38px}

.btn{border:none;border-radius:11px;padding:11px 16px;font-size:13.5px;font-weight:800;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:var(--t);font-family:inherit;white-space:nowrap}
.btn-primary{background:var(--grad);color:#fff;box-shadow:0 6px 16px -4px rgba(13,148,136,.5)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 22px -6px rgba(13,148,136,.6)}
.btn-soft{background:var(--brand-soft);color:var(--brand)}
.btn-soft:hover{background:var(--brand);color:#fff;transform:translateY(-2px)}
.btn-ghost{background:var(--panel-2);color:var(--ink-2);border:1px solid var(--line)}
.btn-ghost:hover{border-color:var(--brand);color:var(--brand)}

/* MAIN TABS */
.maintabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.maintabs button{border:1px solid var(--line);background:var(--panel);color:var(--ink-2);padding:11px 16px;border-radius:12px;font-weight:800;font-size:13.5px;cursor:pointer;transition:var(--t);display:inline-flex;align-items:center;gap:8px}
.maintabs button:hover{border-color:var(--brand);color:var(--brand)}
.maintabs button.active{background:var(--grad);color:#fff;border-color:transparent;box-shadow:0 6px 16px -6px rgba(13,148,136,.6)}
.maintabs .cnt{background:rgba(0,0,0,.12);padding:1px 8px;border-radius:99px;font-size:11.5px}
.maintabs button.active .cnt{background:rgba(255,255,255,.25)}
.pane{display:none} .pane.active{display:block;animation:rise .35s both}

.tablewrap{overflow-x:auto;border-radius:14px;border:1px solid var(--line)}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:13px;min-width:880px}
thead th{background:var(--panel-2);color:var(--ink-2);padding:12px 11px;text-align:left;font-weight:800;font-size:11px;letter-spacing:.3px;text-transform:uppercase;position:sticky;top:0;white-space:nowrap;border-bottom:2px solid var(--line);}
tbody td{padding:11px;border-bottom:1px solid var(--line);vertical-align:middle}
tbody tr{transition:background var(--t)} tbody tr:hover{background:var(--brand-soft)}
tbody tr:last-child td{border-bottom:none}
.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.kode{font-family:ui-monospace,'JetBrains Mono','Courier New',monospace;font-weight:800;background:var(--panel-2);padding:3px 8px;border-radius:7px;font-size:12.5px;border:1px solid var(--line)}
.satker-name{font-weight:600}
.muted-cell{color:var(--muted);font-size:12px}
.badge{display:inline-flex;align-items:center;gap:5px;padding:5px 11px;border-radius:99px;font-size:11.5px;font-weight:800;white-space:nowrap}
.b-green{background:var(--green-bg);color:var(--green-ink)}
.b-amber{background:var(--amber-bg);color:var(--amber-ink)}
.b-red{background:var(--red-bg);color:var(--red-ink)}
.b-slate{background:var(--panel-2);color:var(--muted);border:1px solid var(--line)}
.b-cyan{background:#cffafe;color:#0e7490}
.prog{display:flex;align-items:center;gap:9px;min-width:120px}
.bar{flex:1;height:8px;border-radius:99px;background:var(--line);overflow:hidden}
.bar>i{display:block;height:100%;border-radius:99px;transition:width .6s cubic-bezier(.4,0,.2,1)}
.prog .pv{font-weight:800;font-size:12.5px;width:46px;text-align:right;font-variant-numeric:tabular-nums}
.ket{font-size:12px;color:var(--ink-2);line-height:1.4;max-width:380px}
.ket b{color:var(--red-ink)}

.alert{padding:13px 15px;border-radius:12px;font-size:13.5px;margin-top:14px;display:flex;gap:10px;align-items:flex-start;font-weight:600}
.alert.err{background:var(--red-bg);color:var(--red-ink)}
.alert.info{background:var(--brand-soft);color:var(--brand)}
.pill{font-size:12px;font-weight:800;color:var(--brand);background:var(--brand-soft);padding:5px 12px;border-radius:99px}
.legend{display:flex;flex-wrap:wrap;gap:16px;font-size:12px;color:var(--muted);margin-top:16px;font-weight:600}
.legend span{display:inline-flex;align-items:center;gap:7px}
.dot{width:11px;height:11px;border-radius:4px}
.empty{text-align:center;padding:46px 20px;color:var(--muted)}
.empty .e-ic{font-size:48px;opacity:.5}
.note{font-size:11.5px;color:var(--muted);background:var(--panel-2);border:1px dashed var(--line);padding:10px 13px;border-radius:11px;margin-top:14px}
footer{text-align:center;color:var(--muted);font-size:12px;padding:24px 10px;font-weight:600}
.hidden{display:none!important}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.stat:nth-child(2){animation-delay:.05s}.stat:nth-child(3){animation-delay:.1s}.stat:nth-child(4){animation-delay:.15s}.stat:nth-child(5){animation-delay:.2s}.stat:nth-child(6){animation-delay:.25s}
.fade{animation:rise .4s both}
@media(max-width:600px){.card{padding:16px}.hero{padding:24px}.card-head .actions{width:100%}.card-head .actions .btn{flex:1;justify-content:center}}
</style>
</head>
<body>

<div class="topbar"><div class="inner">
  <div class="logo"><div class="mark">🎯</div><div class="txt"><small>ANALISIS CAPAIAN OUTPUT / IKPA</small><b>Capaian RO Analytics</b></div></div>
  <div class="spacer"></div>
  <button class="icon-btn" id="themeBtn" title="Ganti tema">🌙</button>
</div></div>

<div class="wrap" id="wrap">

  <!-- HERO + UPLOAD -->
  <section class="section">
    <div class="hero">
      <div class="hero-main">
        <div class="eyebrow" style="color:rgba(255,255,255,.85)">Dashboard Capaian Rincian Output</div>
        <h1>Pantau Nilai IKPA &amp; Capaian RO Satker</h1>
        <p>Unggah file Excel capaian RO — sistem menghitung Nilai IKPA per satker (rata-rata nilai RO), menandai RO &lt;100 beserta penyebabnya, satker belum terkonfirmasi/tidak valid, dan satker belum kirim CAPUT.</p>
        <div class="chips"><span>🎯 Nilai IKPA per satker</span><span>📉 RO &lt;100 + penyebab</span><span>📭 Belum kirim CAPUT</span><span>🧾 Cetak PDF</span></div>
      </div>
      <label class="hero-upload" id="drop">
        <input type="file" id="fileInput" accept=".xlsx,.xls,.csv">
        <div class="hu-ic">📥</div>
        <div class="hu-t1" id="huTitle">Unggah file Excel</div>
        <div class="hu-t2" id="huSub">Tarik ke sini atau <u>klik untuk memilih</u> · .xlsx · .xls · .csv</div>
      </label>
    </div>
    <div id="uploadMsg"></div>
  </section>

  <!-- FILTER -->
  <section class="section card" id="filterCard">
    <div class="card-head"><div>
      <div class="eyebrow">Langkah 1</div><h2>🎛️ Filter</h2>
      <div class="desc">Pilih bulan & KPPN. Nilai IKPA satker = rata-rata nilai seluruh RO-nya (tiap RO maksimal 100).</div>
    </div></div>
    <div class="controls">
      <div class="field"><label>Bulan</label><select id="fMonth"></select></div>
      <div class="field"><label>KPPN</label><select id="fKppn"><option value="">Semua KPPN</option></select></div>
      <div class="field" style="grid-column:span 2;min-width:200px"><label>Cari Satker</label>
        <div class="search-box"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" id="fSearch" placeholder="Nama atau kode satker…"></div></div>
    </div>
    <div class="legend">
      <span><i class="dot" style="background:var(--green)"></i> ≥ 100 → <b>SANGAT BAIK</b></span>
      <span><i class="dot" style="background:var(--amber)"></i> &lt; 100 (≠0) → <b>KURANG</b></span>
      <span><i class="dot" style="background:var(--red)"></i> = 0 → <b>PERINGATAN</b></span>
      <span><i class="dot" style="background:#0891b2"></i> ada RO status terkonfirmasi kosong → <b>BELUM KIRIM CAPUT</b></span>
    </div>
  </section>

  <!-- REKAP -->
  <section class="section" id="rekapSection">
    <div class="rekap">
      <div class="rekap-head"><div class="eyebrow" style="color:rgba(255,255,255,.85)">Rekapitulasi KPPN</div><h2 id="rekapTitle">Rekap Nilai IKPA Satker</h2></div>
      <div class="rekap-grid">
        <div class="rk"><span class="rk-l">🎯 Rata-rata Nilai IKPA</span><span class="rk-v" id="rkNilai">0</span><span class="rk-s" id="rkSat">0 satker aktif</span></div>
        <div class="rk"><span class="rk-l">📉 RO di bawah 100</span><span class="rk-v" id="rkRoLow">0</span><span class="rk-s" id="rkRoTot">dari 0 RO</span></div>
        <div class="rk"><span class="rk-l">🚫 Belum Konfirmasi / Tidak Valid</span><span class="rk-v" id="rkBV">0</span><span class="rk-s">satker perlu cek</span></div>
        <div class="rk"><span class="rk-l">📭 Belum Kirim CAPUT</span><span class="rk-v" id="rkCaput">0</span><span class="rk-s">ada RO status kosong</span></div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section" id="statsSection"><div class="stats" id="stats"></div></section>

  <!-- DASHBOARD -->
  <section class="section dash" id="dashSection">
    <div class="card">
      <div class="card-head"><div><div class="eyebrow">Komposisi</div><h2>📈 Distribusi Nilai Satker</h2></div></div>
      <div class="donut-wrap">
        <div class="donut"><svg width="200" height="200" viewBox="0 0 200 200" id="donutSvg"></svg>
          <div class="center"><div class="big" id="donutBig">0</div><div class="sm">Satker</div></div></div>
        <div class="donut-legend" id="donutLegend"></div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><div><div class="eyebrow">Peringkat</div><h2>🏅 Sorotan Satker</h2></div></div>
      <div class="tabs-mini" id="rankTabs"><button data-mode="award" class="active">🌟 Tertinggi</button><button data-mode="warn">⚠️ Terendah</button></div>
      <div class="rank" id="rankList" style="margin-top:14px"></div>
    </div>
  </section>

  <!-- MAIN TABS -->
  <section class="section card" id="tableCard">
    <div class="maintabs" id="mainTabs">
      <button data-pane="satker" class="active">📋 Ringkasan Satker <span class="cnt" id="cSatker">0</span></button>
      <button data-pane="rolow">📉 RO &lt; 100 <span class="cnt" id="cRoLow">0</span></button>
      <button data-pane="bv">🚫 Belum Konfirmasi / Tidak Valid <span class="cnt" id="cBV">0</span></button>
      <button data-pane="caput">📭 Belum Kirim CAPUT <span class="cnt" id="cCaput">0</span></button>
    </div>

    <!-- PANE: Ringkasan Satker -->
    <div class="pane active" id="pane-satker">
      <div class="card-head" style="margin-bottom:12px"><div>
        <h2>📋 Ringkasan Satker <span class="pill" id="sumMonthLbl"></span></h2>
        <div class="desc" id="tableInfo"></div></div>
        <div class="actions" style="display:flex;gap:9px;flex-wrap:wrap"><button class="btn btn-primary" id="btnPdfSatker">🧾 PDF Ringkasan Satker</button></div>
      </div>
      <div class="tablewrap"><table><thead><tr>
        <th>Kode</th><th>Nama Satker</th><th>KPPN</th><th class="num">RO</th><th class="num">RO &lt;100</th><th>Nilai IKPA</th><th>Kategori</th><th>Status Lapor</th>
      </tr></thead><tbody id="tbSatker"></tbody></table></div>
      <div id="emptySatker"></div>
    </div>

    <!-- PANE: RO < 100 -->
    <div class="pane" id="pane-rolow">
      <div class="card-head" style="margin-bottom:12px"><div>
        <h2>📉 Daftar RO dengan Nilai &lt; 100</h2>
        <div class="desc">Setiap RO yang belum mencapai 100, lengkap dengan penyebab (Progress RO vs Target PCRO).</div></div>
        <div class="actions"><button class="btn btn-primary" id="btnPdfRoLow">🧾 PDF RO &lt; 100</button></div>
      </div>
      <div class="tablewrap"><table style="min-width:1000px"><thead><tr>
        <th>Kode Satker</th><th>Satker</th><th>Kode RO</th><th>Uraian RO</th><th class="num">Progress RO</th><th class="num">Target PCRO</th><th>Nilai</th><th>Keterangan Penyebab</th>
      </tr></thead><tbody id="tbRoLow"></tbody></table></div>
      <div id="emptyRoLow"></div>
    </div>

    <!-- PANE: Belum Konfirmasi / Tidak Valid -->
    <div class="pane" id="pane-bv">
      <div class="card-head" style="margin-bottom:12px"><div>
        <h2>🚫 Satker Belum Terkonfirmasi / Tidak Valid</h2>
        <div class="desc">Satker yang memiliki RO berstatus <b>Tidak Terkonfirmasi</b> atau <b>Tidak Valid</b> (status terkonfirmasi yang kosong masuk ke Belum Kirim CAPUT).</div></div>
        <div class="actions"><button class="btn btn-primary" id="btnPdfBV">🧾 PDF Belum Valid</button></div>
      </div>
      <div class="tablewrap"><table><thead><tr>
        <th>Kode</th><th>Nama Satker</th><th>KPPN</th><th class="num">RO Belum Konfirmasi</th><th class="num">RO Tidak Valid</th><th>Status</th>
      </tr></thead><tbody id="tbBV"></tbody></table></div>
      <div id="emptyBV"></div>
    </div>

    <!-- PANE: Belum Kirim CAPUT -->
    <div class="pane" id="pane-caput">
      <div class="card-head" style="margin-bottom:12px"><div>
        <h2>📭 Satker Belum Kirim CAPUT</h2>
        <div class="desc">Satker yang memiliki <b>minimal 1 RO dengan Status Terkonfirmasi kosong</b> — diindikasikan belum melaporkan Capaian Output untuk RO tersebut.</div></div>
        <div class="actions"><button class="btn btn-primary" id="btnPdfCaput">🧾 PDF Belum Kirim CAPUT</button></div>
      </div>
      <div class="tablewrap"><table><thead><tr>
        <th>Kode</th><th>Nama Satker</th><th>KPPN</th><th class="num">Jumlah RO</th><th class="num">RO Belum Status</th><th>Status</th>
      </tr></thead><tbody id="tbCaput"></tbody></table></div>
      <div id="emptyCaput"></div>
    </div>

    <div class="note">🎯 <b>Nilai IKPA satker</b> = Σ nilai RO ÷ jumlah RO (tiap RO maksimal 100). <b>≥100</b> Sangat Baik · <b>&lt;100</b> Kurang · <b>=0</b> Peringatan. Satker yang memiliki <b>minimal 1 RO dengan Status Terkonfirmasi kosong</b> dianggap <b>belum kirim CAPUT</b> (tidak masuk kategori belum konfirmasi/valid). <b>Belum Konfirmasi</b> = status "Tidak Terkonfirmasi"; <b>Belum Valid</b> = status "Tidak Valid".</div>
  </section>

  <footer>Capaian RO / IKPA Analytics • Seluruh perhitungan berjalan lokal di browser Anda — data tidak dikirim ke mana pun.</footer>
</div>

<script>
let RAW=[], SAT={}, MONTHS=[], rankMode='award', activePane='satker';
const ID_MONTH=['','Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const $=id=>document.getElementById(id);

function pad6(v){let s=String(v==null?'':v).trim().replace(/\.0+$/,'');return s.padStart(6,'0');}
function toNum(v){
  if(v==null||v==='')return 0; if(typeof v==='number')return v;
  let s=String(v).trim().replace(/\s/g,'').replace(/Rp/gi,'');
  if(/e/i.test(s)){s=s.replace(',','.');const n=parseFloat(s);return isNaN(n)?0:n;}
  if(s.indexOf(',')>-1&&s.indexOf('.')>-1){s=s.replace(/\./g,'').replace(',','.');}
  else if(s.indexOf(',')>-1){s=s.replace(',','.');}
  const n=parseFloat(s);return isNaN(n)?0:n;
}
function cleanStr(v){
  // hilangkan NBSP, zero-width, dan whitespace lain
  return String(v==null?'':v).replace(/[\u00a0\u200b\u200c\u200d\ufeff]/g,'').replace(/\s+/g,' ').trim();
}
function isBlank(v){const s=cleanStr(v);return s===''||s==='-';}
function fmtN(n){return (Math.round(n*100)/100).toLocaleString('id-ID',{maximumFractionDigits:2});}
function monthLabel(m){const i=parseInt(m);return (i>=1&&i<=12)?ID_MONTH[i]:('Bulan '+m);}
function kodeRO(r){const a=(r.kro||'').trim(),b=(r.roNo||'').trim();return a&&b?(a+'.'+b):(a||b||'-');}

function findHeader(rows){
  for(let i=0;i<Math.min(rows.length,15);i++){
    const j=rows[i].map(c=>String(c||'').toLowerCase()).join('|');
    if(j.includes('kode satker')||(j.includes('satker')&&j.includes('nilai')))return i;
  } return -1;
}
function colMap(header){
  const norm=h=>String(h||'').toLowerCase().replace(/\s+/g,' ').trim();
  const H=header.map(norm);
  const find=(...keys)=>{for(let i=0;i<H.length;i++)for(const k of keys)if(H[i].includes(k))return i;return -1;};
  const exact=k=>{for(let i=0;i<H.length;i++)if(H[i]===k)return i;return -1;};
  return{kode:find('kode satker','kode'),nama:find('nama satker','nama'),kppn:find('kppn'),
    bulan:find('bulan'),uraian:find('uraian ro','uraian'),
    kro:exact('kro')>-1?exact('kro'):find('kro'),
    ro:exact('ro')>-1?exact('ro'):-1,
    progress:find('progress ro','progress'),pcro:find('target pcro','pcro'),
    konf:find('status terkonfirmasi','terkonfirmasi'),valid:find('status validasi','validasi'),
    nilai:exact('nilai')>-1?exact('nilai'):find('nilai')};
}

function handleFile(file){
  $('uploadMsg').innerHTML='';
  const r=new FileReader();
  r.onload=e=>{try{
    const wb=XLSX.read(e.target.result,{type:'array',cellDates:true});
    processRows(XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{header:1,raw:true,defval:''}));
  }catch(err){showErr('Gagal membaca file: '+err.message);}};
  r.readAsArrayBuffer(file);
}
function processRows(rows){
  const hIdx=findHeader(rows);
  if(hIdx<0){showErr('Baris header (kolom "Kode Satker") tidak ditemukan. Pastikan format file sesuai.');return;}
  const cm=colMap(rows[hIdx]);
  if(cm.kode<0){showErr('Kolom wajib (Kode Satker) tidak ditemukan.');return;}
  RAW=[];
  for(let i=hIdx+1;i<rows.length;i++){
    const r=rows[i];if(!r)continue;
    const k=r[cm.kode];
    if(isBlank(k))continue;
    const digits=String(k).replace(/\D/g,'');
    if(!digits)continue; // lewati baris total/footer
    const konfRaw=cleanStr(cm.konf>-1?r[cm.konf]:'');
    const validRaw=cleanStr(cm.valid>-1?r[cm.valid]:'');
    const konfU=konfRaw.toUpperCase();
    const validU=validRaw.toUpperCase();
    const konfKosong = isBlank(konfRaw); // benar-benar kosong (termasuk NBSP/'-')
    const nilaiBlank = cm.nilai>-1 ? isBlank(r[cm.nilai]) : true;
    let nilai = cm.nilai>-1 ? toNum(r[cm.nilai]) : 0;
    if(nilai>100)nilai=100; // cap maksimal 100
    RAW.push({
      kode:pad6(k),
      nama:cleanStr(cm.nama>-1?r[cm.nama]:''),
      kppn:cleanStr(cm.kppn>-1?r[cm.kppn]:''),
      bulan:cleanStr(cm.bulan>-1?r[cm.bulan]:''),
      uraian:cleanStr(cm.uraian>-1?r[cm.uraian]:''),
      kro:cleanStr(cm.kro>-1?r[cm.kro]:''),
      roNo:cleanStr(cm.ro>-1?r[cm.ro]:''),
      progress:cm.progress>-1?toNum(r[cm.progress]):0,
      progressBlank:cm.progress>-1?isBlank(r[cm.progress]):true,
      pcro:cm.pcro>-1?toNum(r[cm.pcro]):0,
      pcroBlank:cm.pcro>-1?isBlank(r[cm.pcro]):true,
      nilai, nilaiBlank,
      konfRaw,
      // Status Terkonfirmasi KOSONG -> belum kirim CAPUT
      konfBlank: konfKosong,
      // "TIDAK TERKONFIRMASI" / "BELUM" (ada isinya tapi tidak terkonfirmasi) -> belum konfirmasi
      tidakKonfirmasi: !konfKosong && (konfU.includes('TIDAK')||konfU.includes('BELUM')),
      // "TIDAK VALID" / "BELUM VALID" -> belum valid
      tidakValid: !isBlank(validRaw) && (validU.includes('TIDAK')||validU.includes('BELUM')),
    });
  }
  if(!RAW.length){showErr('Tidak ada baris data yang terbaca.');return;}
  buildSatker();buildMonths();
  // Diagnostik kolom konfirmasi
  const konfDetected = cm.konf>-1 ? ('"'+cleanStr(rows[hIdx][cm.konf])+'"') : '<b style="color:#dc2626">TIDAK TERDETEKSI</b>';
  const blankRows = RAW.filter(r=>r.konfBlank).length;
  const distinct={}; RAW.forEach(r=>{const v=r.konfRaw||'(kosong)';distinct[v]=(distinct[v]||0)+1;});
  const sampleVals = Object.keys(distinct).slice(0,6).map(v=>v+' ('+distinct[v]+')').join(', ');
  $('uploadMsg').innerHTML='<div class="alert info">✅ Memuat <b>'+RAW.length+'</b> baris RO · <b>'+Object.keys(SAT).length+'</b> satker-bulan.<br>'
    +'🔎 Kolom Status Terkonfirmasi: '+konfDetected+' · baris kosong: <b>'+blankRows+'</b>'
    +'<br><span style="font-size:11px;opacity:.8">Nilai status ditemukan: '+sampleVals+'</span></div>';
  $('huTitle').textContent='✅ Data dimuat';
  $('huSub').innerHTML='Klik untuk <u>ganti file</u> · .xlsx · .xls · .csv';
  document.querySelector('.hero-upload').classList.add('loaded');
  render();
  $('rekapSection').scrollIntoView({behavior:'smooth',block:'start'});
}
function buildSatker(){
  SAT={};
  RAW.forEach(r=>{
    const key=r.kode+'|'+r.bulan;
    if(!SAT[key])SAT[key]={kode:r.kode,nama:r.nama,kppn:r.kppn,bulan:r.bulan,
      ros:[],nilaiSum:0,ro:0,roLow:0,roNol:0,belumKonf:0,tidakValid:0,konfBlankCount:0,nilaiAdaCount:0};
    const s=SAT[key];
    s.ros.push(r); s.nilaiSum+=r.nilai; s.ro++;
    if(!r.nilaiBlank)s.nilaiAdaCount++;
    if(r.nilai<100)s.roLow++;
    if(r.nilai===0)s.roNol++;
    if(r.konfBlank)s.konfBlankCount++;       // status terkonfirmasi kosong
    if(r.tidakKonfirmasi)s.belumKonf++;      // TIDAK TERKONFIRMASI
    if(r.tidakValid)s.tidakValid++;          // TIDAK VALID
    if(!s.nama&&r.nama)s.nama=r.nama;
  });
}
function buildMonths(){
  const set=new Set();RAW.forEach(r=>{if(r.bulan)set.add(r.bulan);});
  MONTHS=[...set].sort((a,b)=>parseInt(a)-parseInt(b));
  const sel=$('fMonth');sel.innerHTML='';
  MONTHS.forEach(m=>{const o=document.createElement('option');o.value=m;o.textContent=monthLabel(m);sel.appendChild(o);});
  if(MONTHS.length)sel.value=MONTHS[MONTHS.length-1];
  const ks=new Set();RAW.forEach(r=>{if(r.kppn)ks.add(r.kppn);});
  const ksel=$('fKppn');ksel.innerHTML='<option value="">Semua KPPN</option>';
  [...ks].sort().forEach(k=>{const o=document.createElement('option');o.value=k;o.textContent='KPPN '+k;ksel.appendChild(o);});
}

function compute(){
  const bln=$('fMonth').value,kppnF=$('fKppn').value,q=$('fSearch').value.trim().toLowerCase();
  const out=[];
  for(const key in SAT){
    const s=SAT[key];
    if(bln&&s.bulan!==bln)continue;
    if(kppnF&&s.kppn!==kppnF)continue;
    if(q&&!(s.kode.toLowerCase().includes(q)||(s.nama||'').toLowerCase().includes(q)))continue;
    const nilai=s.ro>0?s.nilaiSum/s.ro:0;
    // BELUM KIRIM CAPUT: ada MINIMAL 1 RO dengan Status Terkonfirmasi kosong
    const belumCaput = s.konfBlankCount>0;
    let cat,badge;
    if(belumCaput){cat='BELUM KIRIM CAPUT';badge='b-cyan';}
    else if(nilai>=100){cat='SANGAT BAIK';badge='b-green';}
    else if(nilai===0){cat='PERINGATAN';badge='b-red';}
    else{cat='KURANG';badge='b-amber';}
    // bermasalah hanya jika ada TIDAK TERKONFIRMASI atau TIDAK VALID (bukan yang kosong)
    const bermasalah = s.belumKonf>0 || s.tidakValid>0;
    out.push({kode:s.kode,nama:s.nama,kppn:s.kppn,bulan:s.bulan,ro:s.ro,roLow:s.roLow,roNol:s.roNol,
      nilai,cat,badge,belumKonf:s.belumKonf,tidakValid:s.tidakValid,konfBlank:s.konfBlankCount,bermasalah,belumCaput,ros:s.ros});
  }
  out.sort((a,b)=>b.nilai-a.nilai);
  return{bln,rows:out};
}

function render(){
  const empty=!RAW.length;
  const d=compute();
  const mLbl=d.bln?monthLabel(d.bln):'—';
  $('sumMonthLbl').textContent=mLbl;
  $('tableInfo').textContent=empty?'Belum ada data. Unggah file Excel untuk menampilkan hasil.':mLbl+' · '+d.rows.length+' satker';

  const total=d.rows.length;
  const active=d.rows.filter(r=>!r.belumCaput);
  const award=active.filter(r=>r.cat==='SANGAT BAIK').length;
  const kurang=active.filter(r=>r.cat==='KURANG').length;
  const warn=active.filter(r=>r.cat==='PERINGATAN').length;
  const caput=d.rows.filter(r=>r.belumCaput).length;
  const bv=d.rows.filter(r=>r.bermasalah).length;
  const avgNilai=active.length?active.reduce((s,r)=>s+r.nilai,0)/active.length:0;
  const sumRO=d.rows.reduce((s,r)=>s+r.ro,0);
  const sumRoLow=d.rows.reduce((s,r)=>s+r.roLow,0);

  $('rekapTitle').textContent='Rekap Nilai IKPA Satker — '+mLbl;
  $('rkNilai').textContent=fmtN(avgNilai);
  $('rkSat').textContent=active.length+' satker aktif';
  $('rkRoLow').textContent=sumRoLow;
  $('rkRoTot').textContent='dari '+sumRO+' RO';
  $('rkBV').textContent=bv;
  $('rkCaput').textContent=caput;

  $('stats').innerHTML=`
    ${stat('s-total','🏢',total,'Total Satker')}
    ${stat('s-award','🌟',award,'Sangat Baik')}
    ${stat('s-mid','🔻',kurang,'Kurang')}
    ${stat('s-warn','⚠️',warn,'Peringatan')}
    ${stat('s-cyan','📭',caput,'Belum Kirim CAPUT')}
    ${stat('s-none','🚫',bv,'Belum Valid/Konfirmasi')}`;

  renderDonut([
    {n:'Sangat Baik',v:award,c:'#059669'},
    {n:'Kurang',v:kurang,c:'#d97706'},
    {n:'Peringatan',v:warn,c:'#dc2626'},
    {n:'Belum Kirim CAPUT',v:caput,c:'#0891b2'},
  ],total);
  renderRank(active);
  renderSatker(d.rows);
  renderRoLow(d);
  renderBV(d.rows);
  renderCaput(d.rows);

  // counts on tabs
  $('cSatker').textContent=d.rows.length;
  $('cRoLow').textContent=getRoLowList(d).length;
  $('cBV').textContent=bv;
  $('cCaput').textContent=caput;
}
function stat(cls,ic,n,l){return `<div class="stat ${cls}"><span class="strip"></span><div class="ic">${ic}</div><div class="n">${n}</div><div class="l">${l}</div></div>`;}

function renderDonut(parts,total){
  const svg=$('donutSvg');const C=2*Math.PI*70;let off=0;svg.innerHTML='';
  const bg=document.createElementNS('http://www.w3.org/2000/svg','circle');
  bg.setAttribute('cx',100);bg.setAttribute('cy',100);bg.setAttribute('r',70);bg.setAttribute('fill','none');bg.setAttribute('stroke','var(--line)');bg.setAttribute('stroke-width',26);svg.appendChild(bg);
  if(total>0)parts.forEach(p=>{if(p.v<=0)return;const len=p.v/total*C;
    const c=document.createElementNS('http://www.w3.org/2000/svg','circle');
    c.setAttribute('cx',100);c.setAttribute('cy',100);c.setAttribute('r',70);c.setAttribute('fill','none');
    c.setAttribute('stroke',p.c);c.setAttribute('stroke-width',26);
    c.setAttribute('stroke-dasharray',len+' '+(C-len));c.setAttribute('stroke-dashoffset',-off);
    c.style.transition='stroke-dashoffset .6s ease';svg.appendChild(c);off+=len;});
  $('donutBig').textContent=total;
  $('donutLegend').innerHTML=parts.map(p=>`<div class="dl"><span class="sw" style="background:${p.c}"></span><span class="name">${p.n}</span><span class="val">${p.v}</span><span class="pct">${total?Math.round(p.v/total*100):0}%</span></div>`).join('');
}
function renderRank(rows){
  let list=rows.slice();
  list = rankMode==='award' ? list.sort((a,b)=>b.nilai-a.nilai) : list.sort((a,b)=>a.nilai-b.nilai);
  list=list.slice(0,5);
  const el=$('rankList');
  if(!list.length){el.innerHTML='<div class="empty"><div class="e-ic">📭</div><div>Belum ada data.</div></div>';return;}
  el.innerHTML=list.map((r,i)=>{
    const col=r.cat==='SANGAT BAIK'?'var(--green)':r.cat==='PERINGATAN'?'var(--red)':'var(--amber)';
    return `<div class="row"><div class="pos">${i+1}</div><div class="meta"><b title="${r.nama}">${r.nama||r.kode}</b><small>${r.kode} · ${r.ro} RO · ${r.roLow} RO &lt;100</small></div><div class="pv" style="color:${col}">${fmtN(r.nilai)}</div></div>`;
  }).join('');
}

function catIcon(c){return c==='SANGAT BAIK'?'🌟':c==='PERINGATAN'?'⚠️':c==='KURANG'?'🔻':'📭';}
function renderSatker(rows){
  const tb=$('tbSatker');tb.innerHTML='';
  if(!rows.length){$('emptySatker').innerHTML=emptyMsgHtml();return;} $('emptySatker').innerHTML='';
  rows.forEach(r=>{
    const col=r.cat==='SANGAT BAIK'?'var(--green)':r.cat==='PERINGATAN'?'var(--red)':r.cat==='KURANG'?'var(--amber)':'#0891b2';
    const w=Math.min(100,Math.max(0,r.nilai));
    const lapor = r.belumCaput?'<span class="badge b-cyan">📭 Belum Kirim CAPUT</span>'
      : (r.bermasalah?'<span class="badge b-red">🚫 Belum Valid/Konfirmasi</span>':'<span class="badge b-green">✓ Lengkap</span>');
    const tr=document.createElement('tr');tr.className='fade';
    tr.innerHTML=`<td><span class="kode">${r.kode}</span></td><td><div class="satker-name">${r.nama||'-'}</div></td>
      <td>${r.kppn?'<span class="badge b-slate">KPPN '+r.kppn+'</span>':'-'}</td>
      <td class="num">${r.ro}</td><td class="num">${r.roLow}</td>
      <td><div class="prog"><div class="bar"><i style="width:${w}%;background:${col}"></i></div><span class="pv">${fmtN(r.nilai)}</span></div></td>
      <td><span class="badge ${r.badge}">${catIcon(r.cat)} ${r.cat}</span></td><td>${lapor}</td>`;
    tb.appendChild(tr);
  });
}
function getRoLowList(d){
  // Kelompokkan per satker (urut satker berdasarkan nilai IKPA terendah dulu),
  // di dalam tiap satker RO tetap berurutan (kode RO) — tidak loncat-loncat.
  const list=[];
  const satkers=d.rows.slice().sort((a,b)=>a.nilai-b.nilai);
  satkers.forEach(s=>{
    const ros=s.ros.filter(r=>r.nilai<100)
      .slice().sort((a,b)=>kodeRO(a).localeCompare(kodeRO(b),'id',{numeric:true}));
    ros.forEach(r=>list.push({...r,satkerNama:s.nama,satkerKode:s.kode}));
  });
  return list;
}
function ketPenyebab(r){
  const prog = r.progressBlank?'0':fmtN(r.progress);
  const pcro = r.pcroBlank?'belum ditetapkan':fmtN(r.pcro);
  if(r.nilai===0) return `Nilai 0 — Progress RO <b>${prog}</b> dari Target PCRO <b>${pcro}</b> (capaian belum tercapai).`;
  return `Nilai ${fmtN(r.nilai)} (&lt;100) karena Progress RO <b>${prog}</b> belum mencapai Target PCRO <b>${pcro}</b>.`;
}
