<script>
(function(){
"use strict";
var LOGO_URI="https://upload.wikimedia.org/wikipedia/commons/7/73/Logo_kementerian_keuangan_republik_indonesia.png";
var IDX={kode:0,nama:1,kppn:2,es1:3,bulan:4,r51:5,r52:6,r53:7,r57:8,p51:9,p52:10,p53:11,p57:12};
var JENIS=[51,52,53,57];
var MONNAME=['','Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
var RAW=[]; // active dataset

function fmtRp(n){n=Math.round(n||0);var neg=n<0;n=Math.abs(n);return (neg?'-':'')+'Rp '+n.toLocaleString('id-ID');}
function fmtShort(n){var neg=n<0;n=Math.abs(n||0);var s;if(n>=1e12)s=(n/1e12).toFixed(2)+' T';else if(n>=1e9)s=(n/1e9).toFixed(2)+' M';else if(n>=1e6)s=(n/1e6).toFixed(1)+' Jt';else s=n.toLocaleString('id-ID');return (neg?'-':'')+'Rp '+s;}
function pad6(k){k=String(k).replace(/\D/g,'');while(k.length<6)k='0'+k;return k;}

function devJenis(t,s){t=t||0;s=s||0;if(t===0&&s===0)return{has:false,dev:null,t:0,s:0};if(t===0)return{has:true,dev:100,t:0,s:s};return{has:true,dev:Math.abs(t-s)/t*100,t:t,s:s};}

// compute per-satker metrics for a given month
function satkerMonth(r){
  var per={},tT=0,tS=0,devs=[],any=false;
  JENIS.forEach(function(j){
    var t=r[IDX['r'+j]]||0,s=r[IDX['p'+j]]||0;var d=devJenis(t,s);per[j]=d;
    if(d.has){tT+=t;tS+=s;devs.push(d.dev);any=true;}
  });
  if(!any) return null;
  var avg=devs.reduce(function(a,b){return a+b;},0)/devs.length;
  var maxd=Math.max.apply(null,devs);
  // Status berdasar rata-rata deviasi (avg) & deviasi tertinggi (maxd):
  // avg<=5 & semua belanja<=5 -> sangat baik; avg<=5 tapi ada >5 -> baik;
  // avg >5 s.d. 20 -> kurang; avg >20 -> peringatan
  var cat;
  if(avg<=5){ cat = maxd<=5 ? 'sangatbaik' : 'baik'; }
  else if(avg<=20){ cat='kurang'; }
  else { cat='peringatan'; }
  return {per:per,totT:tT,totS:tS,totDev:tT-tS,avg:avg,max:maxd,cat:cat};
}

// index RAW by satker key -> {bulan: rowMetrics}
function buildIndex(){
  var map={};
  RAW.forEach(function(r){
    var kode=pad6(r[IDX.kode]);
    var key=kode+'|'+r[IDX.es1];
    if(!map[key]) map[key]={kode:kode,nama:r[IDX.nama],kppn:r[IDX.kppn],es1:r[IDX.es1],months:{}};
    var m=satkerMonth(r);
    if(m) map[key].months[r[IDX.bulan]]=m;
  });
  return map;
}

var CAT_LABEL={sangatbaik:'Sangat Baik',baik:'Baik',kurang:'Kurang',peringatan:'Peringatan'};
var CAT_BADGE={sangatbaik:'b-green',baik:'b-cyan',kurang:'b-amber',peringatan:'b-red'};
var CAT_ICON={sangatbaik:'✅',baik:'👍',kurang:'⚠️',peringatan:'🚨'};
function devClass(d){if(d==null)return '';return d<=5?'dev-green':(d<=20?'dev-amber':'dev-red');}

var state={bulan:1,cat:'all',sort:'asc',q:''};

// rows for current month
function rowsForMonth(){
  var map=buildIndex();
  var rows=[];
  Object.keys(map).forEach(function(k){
    var sk=map[k];var m=sk.months[state.bulan];
    if(!m) return;
    rows.push({kode:sk.kode,nama:sk.nama,kppn:sk.kppn,es1:sk.es1,m:m});
  });
  return rows;
}

function applyFilter(rows){
  var q=state.q.trim().toLowerCase();
  var out=rows.filter(function(r){
    if(state.cat!=='all' && r.m.cat!==state.cat) return false;
    if(q && r.nama.toLowerCase().indexOf(q)<0 && r.kode.indexOf(q)<0) return false;
    return true;
  });
  out.sort(function(a,b){
    if(state.sort==='nama') return a.nama.localeCompare(b.nama);
    return state.sort==='desc'? b.m.avg-a.m.avg : a.m.avg-b.m.avg;
  });
  return out;
}

// kategori dari nilai deviasi tunggal (untuk tabel kumulatif)
function catFromAvg(v){
  if(v<=5) return 'sangatbaik';
  if(v<=20) return 'kurang';
  return 'peringatan';
}

// baris kumulatif: jumlah rata-rata deviasi bulan 1..state.bulan ÷ nomor bulan periode
function rowsKumulatif(){
  var map=buildIndex();
  var rows=[];
  Object.keys(map).forEach(function(k){
    var sk=map[k];
    var monthly={}, vals=[];
    for(var b=1;b<=state.bulan;b++){
      if(sk.months[b]){ monthly[b]=sk.months[b].avg; vals.push(sk.months[b].avg); }
    }
    if(!vals.length) return; // tidak ada data sampai periode ini
    var sum=vals.reduce(function(a,c){return a+c;},0);
    var kum=sum/state.bulan; // pembagi = nomor bulan periode (mis. bln 5 -> /5)
    rows.push({kode:sk.kode,nama:sk.nama,kppn:sk.kppn,es1:sk.es1,
      monthly:monthly, nbulan:state.bulan, ndata:vals.length, kum:kum, cat:catFromAvg(kum)});
  });
  // filter pencarian & kategori mengikuti kontrol yang sama
  var q=state.q.trim().toLowerCase();
  rows=rows.filter(function(r){
    if(state.cat!=='all' && r.cat!==state.cat) return false;
    if(q && r.nama.toLowerCase().indexOf(q)<0 && r.kode.indexOf(q)<0) return false;
    return true;
  });
  rows.sort(function(a,b){
    if(state.sort==='nama') return a.nama.localeCompare(b.nama);
    return state.sort==='desc'? b.kum-a.kum : a.kum-b.kum;
  });
  return rows;
}

function stat(cls,ic,n,l){return '<div class="stat '+cls+'"><span class="strip"></span><div class="ic">'+ic+'</div><div class="n">'+n+'</div><div class="l">'+l+'</div></div>';}

function render(){
  var all=rowsForMonth();
  var cSangat=all.filter(function(r){return r.m.cat==='sangatbaik';}).length;
  var cBaik=all.filter(function(r){return r.m.cat==='baik';}).length;
  var cKurang=all.filter(function(r){return r.m.cat==='kurang';}).length;
  var cPer=all.filter(function(r){return r.m.cat==='peringatan';}).length;
  document.getElementById('cAll').textContent=all.length;
  document.getElementById('cSangatBaik').textContent=cSangat;
  document.getElementById('cBaik').textContent=cBaik;
  document.getElementById('cKurang').textContent=cKurang;
  document.getElementById('cPeringatan').textContent=cPer;

  var sb=document.getElementById('statsBox');
  sb.innerHTML=stat('s-total','🏢',all.length,'Total Satker (Bln '+state.bulan+')')+
    stat('s-award','✅',cSangat,'Sangat Baik')+
    stat('s-cyan','👍',cBaik,'Baik')+
    stat('s-mid','⚠️',cKurang,'Kurang (5–20%)')+
    stat('s-warn','🚨',cPer,'Peringatan (>20%)');

  var tT=0,tS=0;
  all.forEach(function(r){tT+=r.m.totT;tS+=r.m.totS;});
  var tDev=tT-tS;var pct=tT>0?Math.abs(tDev)/tT*100:0;
  document.getElementById('rekapBulan').textContent='Bulan '+state.bulan+' ('+MONNAME[state.bulan]+')';
  setTxt('rkTarget',fmtShort(tT),fmtRp(tT));
  setTxt('rkSerap',fmtShort(tS),fmtRp(tS));
  setTxt('rkDevNom',fmtShort(tDev),fmtRp(tDev));
  document.getElementById('rkDevPct').textContent=pct.toFixed(2)+'%';
  document.getElementById('rkDevKet').textContent=(pct<=5?'Sangat Baik':(pct<=20?'Kurang':'Peringatan'));

  var rows=applyFilter(all);
  var en=document.getElementById('emptyNote');
  en.style.display=rows.length?'none':'block';
  en.textContent = RAW.length? 'Tidak ada satker yang sesuai filter saat ini.' : '📥 Belum ada data. Unggah file Excel/CSV monitoring RPD Halaman III DIPA pada kotak unggah di atas untuk menampilkan deviasi satker.';
  var html='';
  rows.forEach(function(r,i){
    var pos=i+1;var pcls=pos<=3?'p'+pos:'';
    var cells='';
    JENIS.forEach(function(j){
      var d=r.m.per[j];
      if(d.has){
        cells+='<td class="num gl tgt" title="'+fmtRp(d.t)+'">'+fmtShort(d.t)+'</td>'+
          '<td class="num rls" title="'+fmtRp(d.s)+'">'+fmtShort(d.s)+'</td>'+
          '<td class="dev-cell '+devClass(d.dev)+'">'+d.dev.toFixed(1)+'%</td>';
      } else {
        cells+='<td class="num gl subtle">—</td><td class="num subtle">—</td><td class="num subtle">—</td>';
      }
    });
    html+='<tr>'+
      '<td><span class="rankpos '+pcls+'">'+pos+'</span></td>'+
      '<td><span class="kode">'+r.kode+'</span></td>'+
      '<td class="satker-name">'+r.nama+'</td>'+
      cells+
      '<td class="dev-cell gl '+devClass(r.m.avg)+'">'+r.m.avg.toFixed(2)+'%</td>'+
      '<td><span class="badge '+CAT_BADGE[r.m.cat]+'">'+CAT_ICON[r.m.cat]+' '+CAT_LABEL[r.m.cat]+'</span></td>'+
    '</tr>';
  });
  document.getElementById('tbody').innerHTML=html;

  // footer totals per belanja
  var sums={};JENIS.forEach(function(j){sums[j]={t:0,s:0};});
  var fT=0,fS=0;
  rows.forEach(function(r){
    JENIS.forEach(function(j){var d=r.m.per[j];if(d.has){sums[j].t+=d.t;sums[j].s+=d.s;}});
    fT+=r.m.totT;fS+=r.m.totS;
  });
  var fpct=fT>0?Math.abs(fT-fS)/fT*100:0;
  var fcells='';
  JENIS.forEach(function(j){
    var t=sums[j].t,s=sums[j].s;var dd=t>0?Math.abs(t-s)/t*100:0;
    fcells+='<td class="num gl" title="'+fmtRp(t)+'">'+fmtShort(t)+'</td>'+
      '<td class="num" title="'+fmtRp(s)+'">'+fmtShort(s)+'</td>'+
      '<td class="dev-cell '+devClass(t>0?dd:null)+'">'+(t>0?dd.toFixed(1)+'%':'—')+'</td>';
  });
  document.getElementById('tfoot').innerHTML=rows.length?(
    '<tr><td colspan="3">TOTAL ('+rows.length+' satker)</td>'+fcells+
    '<td class="dev-cell gl '+devClass(fpct)+'">'+fpct.toFixed(2)+'%</td>'+
    '<td></td></tr>'
  ):'';

  renderKum();
}
function setTxt(id,t,title){var e=document.getElementById(id);e.textContent=t;if(title)e.title=title;}

// ====== TABEL PERINGKAT KUMULATIF ======
function renderKum(){
  var nb=state.bulan;
  // header dinamis: hanya bulan 1..nb
  var th='<tr><th>#</th><th>Kode</th><th>Nama Satker</th>';
  for(var b=1;b<=nb;b++){ th+='<th class="num'+(b===1?' grp':'')+'">Dev. '+MONNAME[b].slice(0,3)+'</th>'; }
  th+='<th class="num grp">Pembagi</th><th class="num grp">Dev. Kumulatif</th><th>Status</th></tr>';
  document.getElementById('kumHead').innerHTML=th;

  var rows=rowsKumulatif();
  var en=document.getElementById('kumEmptyNote');
  en.style.display=rows.length?'none':'block';
  en.textContent = RAW.length? 'Tidak ada satker yang sesuai filter saat ini.' : '📥 Belum ada data. Unggah file terlebih dahulu.';

  var html='';
  rows.forEach(function(r,i){
    var pos=i+1;var pcls=pos<=3?'p'+pos:'';
    var mcells='';
    for(var b=1;b<=nb;b++){
      var v=r.monthly[b];
      if(v==null) mcells+='<td class="num subtle'+(b===1?' gl':'')+'">—</td>';
      else mcells+='<td class="dev-cell'+(b===1?' gl':'')+' '+devClass(v)+'">'+v.toFixed(1)+'%</td>';
    }
    html+='<tr>'+
      '<td><span class="rankpos '+pcls+'">'+pos+'</span></td>'+
      '<td><span class="kode">'+r.kode+'</span></td>'+
      '<td class="satker-name">'+r.nama+'</td>'+
      mcells+
      '<td class="num gl" title="'+r.ndata+' bulan berdata">'+r.nbulan+'</td>'+
      '<td class="dev-cell gl '+devClass(r.kum)+'">'+r.kum.toFixed(2)+'%</td>'+
      '<td><span class="badge '+CAT_BADGE[r.cat]+'">'+CAT_ICON[r.cat]+' '+CAT_LABEL[r.cat]+'</span></td>'+
    '</tr>';
  });
  document.getElementById('kumBody').innerHTML=html;

  // footer rata-rata kumulatif seluruh satker tampil
  if(rows.length){
    var avgAll=rows.reduce(function(a,c){return a+c.kum;},0)/rows.length;
    document.getElementById('kumFoot').innerHTML=
      '<tr><td colspan="'+(3+nb)+'">RATA-RATA KUMULATIF ('+rows.length+' satker)</td>'+
      '<td class="num gl"></td>'+
      '<td class="dev-cell gl '+devClass(avgAll)+'">'+avgAll.toFixed(2)+'%</td>'+
      '<td></td></tr>';
  } else { document.getElementById('kumFoot').innerHTML=''; }
}

// ============ PDF ============
// format ringkas untuk cetakan (mis. 1.000.000 -> "1 Jt", tanpa prefix Rp)
function pdfNum(n){
  var neg=n<0;n=Math.abs(n||0);var s;
  if(n===0) s='0';
  else if(n>=1e12) s=(n/1e12).toFixed(2)+' T';
  else if(n>=1e9) s=(n/1e9).toFixed(2)+' M';
  else if(n>=1e6) s=(n/1e6).toFixed(1)+' Jt';
  else if(n>=1e3) s=(n/1e3).toFixed(0)+' Rb';
  else s=Math.round(n).toString();
