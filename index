function markAsKnown() {
  const before = knownRegnos.size;
  allStudents.forEach(r => knownRegnos.add(r.regno));
  saveKnownStudents();
  const added = knownRegnos.size - before;
  showStatus('success', `✅ ${added} siswa ditandai sebagai "sudah diketahui". Total tersimpan: ${knownRegnos.size}`);
  renderResults([]);
}

// ============================================================
// RENDER TABLE
// ============================================================
function renderResults(newRegnos = [], changes = null) {
  const newSet = new Set(newRegnos);
  const area = document.getElementById('resultArea');
  const quotaSummary = document.getElementById('quotaSummary');
  
  if (allStudents.length === 0) {
    area.innerHTML = '<div class="empty">Tidak ada data siswa yang cocok dengan filter. Klik "Fetch Data Terbaru" untuk memulai.</div>';
    quotaSummary.style.display = 'none';
    return;
  }
  
  // Separate verified from unverified
  const verified = allStudents.filter(r => r.verified);
  const unverified = allStudents.filter(r => !r.verified);
  const smpn9_accepted = verified.filter(r => r.is_smpn9);
  const smpn9_rejected = verified.filter(r => !r.is_smpn9);
  
  // Build sets for change detection
  const newInRegnos = new Set((changes?.newIn || []).map(r => r.regno));
  const newOutRegnos = new Set((changes?.newOut || []).map(r => r.regno));
  
  // Sort by peringkat (system's official ranking) if available, else by nilai
  // Tie-breaker: by nilai (descending), then by REGNO (ascending) for deterministic order
  const sortByRank = (a, b) => {
    if (a.peringkat && b.peringkat) {
      if (a.peringkat !== b.peringkat) return a.peringkat - b.peringkat;
      // Same peringkat: tie-break by nilai then REGNO
      const na = parseFloat(a.nilai_akhir) || 0;
      const nb = parseFloat(b.nilai_akhir) || 0;
      if (nb !== na) return nb - na;
      return String(a.regno).localeCompare(String(b.regno));
    }
    if (a.peringkat) return -1;
    if (b.peringkat) return 1;
    return (parseFloat(b.nilai_akhir) || 0) - (parseFloat(a.nilai_akhir) || 0);
  };
  
  // Sort unverified by nilai descending
  unverified.sort((a, b) => (parseFloat(b.nilai_akhir) || 0) - (parseFloat(a.nilai_akhir) || 0));
  
  // Update summary stats
  const newSmpn9Accepted = smpn9_accepted.filter(r => newSet.has(r.regno));
  const newSmpn9Rejected = smpn9_rejected.filter(r => newSet.has(r.regno));
  
  if (quotaSummary) {
    quotaSummary.style.display = 'block';
    const lastAccepted = smpn9_accepted.length > 0 ? smpn9_accepted[smpn9_accepted.length - 1] : null;
    const lastRejected = smpn9_rejected.length > 0 ? smpn9_rejected[0] : null;
    
    document.getElementById('quotaSummaryContent').innerHTML = `
      <div style="display:flex; flex-wrap:wrap; gap:14px;">
        <div><strong>${smpn9_accepted.length}</strong> siswa <span style="color:#16a34a;font-weight:600;">DITERIMA di SMPN 9</span> ${newSmpn9Accepted.length > 0 ? `<small style="background:#16a34a;color:white;padding:2px 6px;border-radius:8px;">+${newSmpn9Accepted.length} baru</small>` : ''}</div>
        <div><strong>${smpn9_rejected.length}</strong> siswa <span style="color:#dc2626;font-weight:600;">Diterima di sekolah lain</span> ${newSmpn9Rejected.length > 0 ? `<small style="background:#dc2626;color:white;padding:2px 6px;border-radius:8px;">+${newSmpn9Rejected.length} baru</small>` : ''}</div>
        <div>Belum diverifikasi: <strong>${unverified.length}</strong></div>
        ${lastAccepted ? `<div>Peringkat terakhir diterima: <strong>#${lastAccepted.peringkat || '?'}</strong> (nilai ${lastAccepted.nilai_akhir})</div>` : ''}
        ${lastRejected ? `<div>Peringkat tertinggi TIDAK: <strong>#${lastRejected.peringkat || '?'}</strong> (nilai ${lastRejected.nilai_akhir})</div>` : ''}
      </div>
    `;
  }
  
  // Build table
  // Show 3 sections: SMPN 9 DITERIMA, DITERIMA DI LAIN, BELUM DIVERIFIKASI
  let html = '';
  
  const renderTableSection = (title, records, showStatus, bgColor, emptyMsg) => {
    if (records.length === 0) {
      return `<div style="margin-top:14px;"><h3 style="background:${bgColor};padding:8px 12px;border-radius:6px;margin:0;font-size:14px;">${title} (0)</h3><div class="empty" style="padding:14px;">${emptyMsg}</div></div>`;
    }
    const sorted = [...records].sort(sortByRank);
    let sectionHtml = `<h3 style="background:${bgColor};padding:8px 12px;border-radius:6px;margin:14px 0 0 0;font-size:14px;">${title} (${sorted.length})</h3>`;
    sectionHtml += '<div style="overflow-x:auto;"><table><thead><tr>';
    sectionHtml += '<th style="width:60px;">Peringkat</th>';
    sectionHtml += '<th style="width:100px;">REGNO</th>';
    sectionHtml += '<th style="width:60px;">Pil</th>';
    sectionHtml += '<th style="width:180px;">Pilihan Diterima</th>';
    sectionHtml += '<th>Nama</th>';
    sectionHtml += '<th>Asal Sekolah</th>';
    sectionHtml += '<th style="width:90px;">Nilai</th>';
    sectionHtml += '<th style="width:140px;">Status</th>';
    sectionHtml += '</tr></thead><tbody>';
    
    sorted.forEach(r => {
      const isNew = newSet.has(r.regno);
      const isKnown = knownRegnos.has(r.regno);
      const isChangedIn = newInRegnos.has(r.regno);
      const isChangedOut = newOutRegnos.has(r.regno);
      const pilBadge = r.pilihan_ke === 1
        ? '<span class="badge pil-1">Pil 1</span>'
        : '<span class="badge pil-2">Pil 2</span>';
      
      let statusParts = [];
      if (showStatus === 'DITERIMA') {
        statusParts.push('<span style="background:#16a34a;color:white;padding:3px 8px;border-radius:10px;font-weight:600;font-size:11px;">✓ DITERIMA</span>');
      } else if (showStatus === 'DITOLAK') {
        statusParts.push('<span style="background:#dc2626;color:white;padding:3px 8px;border-radius:10px;font-weight:600;font-size:11px;">✗ DI SEKOLAH LAIN</span>');
      } else {
        statusParts.push('<span style="background:#94a3b8;color:white;padding:3px 8px;border-radius:10px;font-weight:600;font-size:11px;">⏳ BELUM</span>');
      }
      if (isChangedIn) statusParts.push('<span style="background:#16a34a;color:white;padding:3px 8px;border-radius:10px;font-weight:600;font-size:11px;margin-left:4px;">⬆️ MASUK</span>');
      if (isChangedOut) statusParts.push('<span style="background:#dc2626;color:white;padding:3px 8px;border-radius:10px;font-weight:600;font-size:11px;margin-left:4px;">⬇️ KELUAR</span>');
      if (isNew) statusParts.push('<span class="badge new" style="margin-left:4px;">NEW</span>');
      else if (isKnown && !isChangedIn && !isChangedOut) statusParts.push('<span style="color:#16a34a;font-size:11px;margin-left:4px;">✓</span>');
      
      let rowClass = '';
      if (isChangedIn) rowClass = 'changed-in-row';
      else if (isChangedOut) rowClass = 'changed-out-row';
      else if (isNew) rowClass = 'new-row';
      else if (showStatus === 'DITOLAK') rowClass = 'rejected-row';
      
      const pdText = showStatus === 'DITERIMA'
        ? `<strong style="color:#16a34a;">${r.pilihan_diterima}</strong><br><small style="color:#64748b;">pada PILIHAN ${r.pd_pilihan}</small>`
        : showStatus === 'DITOLAK'
          ? `<strong style="color:#64748b;">${r.pilihan_diterima}</strong><br><small style="color:#64748b;">pada PILIHAN ${r.pd_pilihan}</small>`
          : `<span style="color:#94a3b8;">—</span>`;
      
      const rankText = r.peringkat ? `#${r.peringkat}` : '—';
      
      sectionHtml += `
        <tr class="${rowClass}">
          <td><strong>${rankText}</strong></td>
          <td>${r.regno}</td>
          <td>${pilBadge}</td>
          <td>${pdText}</td>
          <td>${escapeHtml(r.nama)}</td>
          <td>${escapeHtml(r.asal_sekolah)}</td>
          <td><strong>${r.nilai_akhir}</strong></td>
          <td>${statusParts.join(' ')}</td>
        </tr>
      `;
    });
    
    sectionHtml += '</tbody></table></div>';
    return sectionHtml;
  };
  
  // Sort by peringkat
  const sortedAccepted = [...smpn9_accepted].sort(sortByRank);
  const sortedRejected = [...smpn9_rejected].sort(sortByRank);
  
  html += renderTableSection('✅ DITERIMA DI SMPN 9', sortedAccepted, 'DITERIMA', '#dcfce7', 'Klik "Verifikasi & Update Hasil" untuk verifikasi popDetil');
  html += renderTableSection('❌ DITERIMA DI SEKOLAH LAIN', sortedRejected, 'DITOLAK', '#fee2e2', '—');
  html += renderTableSection('⏳ BELUM DIVERIFIKASI', unverified, 'PENDING', '#f1f5f9', 'Semua siswa sudah diverifikasi.');
  
  area.innerHTML = html;
}

// ============================================================
// VERIFY via popDetil + DELTA DETECTION
// ============================================================
async function verifyAllStudents(silent = false) {
  if (allStudents.length === 0) {
    if (!silent) showStatus('warning', '⚠️ Belum ada data. Fetch terlebih dahulu.');
    return;
  }
  
  const btn = document.getElementById('btnVerify');
  if (!silent) {
    btn.disabled = true;
    btn.textContent = '⏳ Verifying...';
    showStatus('info', '🔍 Memverifikasi via popDetil SPMB (1 API call per siswa)...');
  }
  
  const progress = document.getElementById('verifyProgress');
  const bar = document.getElementById('verifyBar');
  const text = document.getElementById('verifyText');
  if (!silent) progress.style.display = 'block';
  
  // Load previously verified from localStorage
  let verifiedCache = {};
  try {
    const data = localStorage.getItem(CONFIG.verifyCacheKey);
    if (data) verifiedCache = JSON.parse(data);
  } catch (e) {}
  
  let verified = 0;
  let smpn9Count = 0;
  let otherCount = 0;
  
  for (let i = 0; i < allStudents.length; i++) {
    const r = allStudents[i];
    
    // Check cache first
    if (verifiedCache[r.regno]) {
      Object.assign(r, verifiedCache[r.regno]);
      verified++;
      if (r.is_smpn9) smpn9Count++; else otherCount++;
      continue;
    }
    
    text.textContent = `Memverifikasi ${i+1}/${allStudents.length}: ${r.nama} (REGNO ${r.regno})...`;
    if (!silent) bar.style.width = `${(i/allStudents.length)*100}%`;
    
    try {
      // Try custom proxy first, then public CORS proxies
      const endpoints = [];
      
      const customProxy = localStorage.getItem(CONFIG.proxyUrlKey);
      if (customProxy && customProxy.trim()) {
        const cleanProxy = customProxy.trim().replace(/\/+$/, '');
        endpoints.push({
          name: 'Custom Proxy',
          url: cleanProxy + '/proxy',
          method: 'POST',
          isCustom: true,
        });
      }
      for (const proxy of CONFIG.corsProxies) {
        endpoints.push({
          name: proxy,
          url: `${proxy}https://spmb.semarangkota.go.id/smp/popDetil`,
          method: 'POST',
        });
      }
      
      let response = null;
      let lastError = null;
      for (const ep of endpoints) {
        try {
          let opts = {};
          if (ep.isCustom) {
            opts = {
              method: 'POST',
              headers: {
                'Content-Type': 'text/plain',
                'X-Proxy-Method': 'POST',
                'X-Proxy-URL': 'https://spmb.semarangkota.go.id/smp/popDetil',
                'X-Proxy-Body': `regno=${r.regno}&opt=${r.opt1}`,
              },
              body: '',
            };
          } else {
            opts = {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: `regno=${r.regno}&opt=${r.opt1}`,
            };
          }
          response = await fetch(ep.url, opts);
          if (response.ok) break;
          response = null;
        } catch (e) {
          lastError = e;
        }
      }
      
      if (!response) throw lastError || new Error('Semua proxy gagal');
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }
      const html = await response.text();
      
      // Parse "Pilihan Diterima" and "Peringkat"
      const pdMatch = html.match(/Pilihan Diterima\s*<\/td>[\s\S]*?<td[^>]*><b>\s*([^<]+?)\s*<\/b>\s*\(\s*pada\s+PILIHAN\s+(\d+)\s*\)/i);
      const prMatch = html.match(/Peringkat\s*<\/td>[\s\S]*?<td[^>]*>\s*(\d+)\s+dari\s+(\d+)/i);
      
      if (pdMatch && prMatch) {
        r.pilihan_diterima = pdMatch[1].trim();
        r.pd_pilihan = parseInt(pdMatch[2]);
        r.peringkat = parseInt(prMatch[1]);
        r.kuota = parseInt(prMatch[2]);
        r.is_smpn9 = /SMP NEGERI 9/i.test(r.pilihan_diterima);
        r.verified = true;
        verified++;
        if (r.is_smpn9) smpn9Count++; else otherCount++;
        
        // Cache it
        verifiedCache[r.regno] = {
          pilihan_diterima: r.pilihan_diterima,
          pd_pilihan: r.pd_pilihan,
          peringkat: r.peringkat,
          kuota: r.kuota,
          is_smpn9: r.is_smpn9,
          verified: true,
        };
        localStorage.setItem(CONFIG.verifyCacheKey, JSON.stringify(verifiedCache));
      } else {
        r.verified = false;
        r.pilihan_diterima = 'BELUM TERSEDIA';
        r.is_smpn9 = false;
      }
    } catch (e) {
      console.warn(`Verify failed for ${r.regno}:`, e);
      r.verified = false;
      r.pilihan_diterima = 'GAGAL';
      r.is_smpn9 = false;
    }
    
    // Update stats every 5
    if ((i+1) % 5 === 0 || i === allStudents.length - 1) {
      updateStats();
      if (!silent) {
        bar.style.width = `${((i+1)/allStudents.length)*100}%`;
        text.textContent = `${verified}/${allStudents.length} diverifikasi | DITERIMA SMPN 9: ${smpn9Count} | DI LAIN: ${otherCount}`;
      } else {
        console.log(`[Auto-Refresh] Verified ${i+1}/${allStudents.length} | SMPN 9: ${smpn9Count} | DI LAIN: ${otherCount}`);
      }
    }
  }
  
  bar.style.width = '100%';
  text.textContent = `✓ Selesai! ${verified}/${allStudents.length} diverifikasi | DITERIMA SMPN 9: ${smpn9Count} | DI LAIN: ${otherCount}`;
  
  // ============================================================
  // DELTA DETECTION: compare with previous state
  // ============================================================
  const changes = detectChanges();
  
  // Save current state as previous for next time
  saveCurrentState();
  
  // Render with new highlighting
  const newRegnos = allStudents.filter(r => !knownRegnos.has(r.regno)).map(r => r.regno);
  renderResults(newRegnos, changes);
  renderChangesPanel(changes);
  
  // Save changes log
  saveChangesLog(changes);
  
  if (changes.hasChanges) {
    if (!silent) {
      showStatus('success', `✅ Verifikasi selesai! 🔔 ${changes.newIn.length} siswa BARU masuk, ${changes.newOut.length} siswa KELUAR dari SMPN 9.`);
    } else {
      // Silent mode for auto-refresh: still show notification but keep it brief
      showStatus('success', `🔔 Auto-refresh: ${changes.newIn.length} masuk, ${changes.newOut.length} keluar, ${changes.newRegistrants.length} pendaftar baru.`);
      // Browser notification
      try {
        if (Notification.permission === 'granted') {
          new Notification('SPMB Monitor — Perubahan Terdeteksi', {
            body: `${changes.newIn.length} masuk, ${changes.newOut.length} keluar, ${changes.newRegistrants.length} baru`,
          });
        }
      } catch (e) {}
    }
  } else if (!silent) {
    showStatus('success', `✅ Verifikasi selesai! Tidak ada perubahan status sejak fetch terakhir.`);
  }
  
  if (!silent) {
    btn.disabled = false;
    btn.textContent = '🔍 Verifikasi & Deteksi Perubahan';
    setTimeout(() => { progress.style.display = 'none'; }, 5000);
  }
}

// ============================================================
// DELTA DETECTION
// ============================================================
function detectChanges() {
  const changes = {
    newIn: [],      // Baru diterima di SMPN 9 (sebelumnya di sekolah lain atau belum ada)
    newOut: [],     // Baru keluar dari SMPN 9 (sekarang di sekolah lain atau tidak)
    newRegistrants: [], // Siswa yang muncul pertama kali
    hasChanges: false,
  };
  
  // Load previous state
  let prevState = {};
  try {
    const data = localStorage.getItem(CONFIG.previousStateKey);
    if (data) prevState = JSON.parse(data);
  } catch (e) {}
  
  const currentRegnos = new Set(allStudents.map(r => r.regno));
  const prevRegnos = new Set(Object.keys(prevState));
  
  // Find new registrants (not in previous)
  allStudents.forEach(r => {
    if (!prevRegnos.has(r.regno)) {
      changes.newRegistrants.push(r);
    }
  });
  
  // Find new IN (current is SMPN 9, previously was not SMPN 9)
  // and new OUT (current is NOT SMPN 9, previously was SMPN 9)
  Object.entries(prevState).forEach(([regno, prev]) => {
    if (!currentRegnos.has(regno)) {
      // Student left the pool (perhaps cancelled registration)
      return;
    }
    const curr = allStudents.find(r => r.regno === regno);
    if (!curr || !curr.verified) return;
    
    const wasSmpn9 = prev.is_smpn9;
    const isSmpn9 = curr.is_smpn9;
    
    if (!wasSmpn9 && isSmpn9) {
      // NEW IN
      changes.newIn.push({
        ...curr,
        previous_school: prev.pilihan_diterima || 'Belum tahu',
      });
    } else if (wasSmpn9 && !isSmpn9) {
      // NEW OUT
      changes.newOut.push({
        ...curr,
        previous_school: 'SMP NEGERI 9',
        now_school: curr.pilihan_diterima,
      });
    } else if (wasSmpn9 && isSmpn9 && prev.pilihan_diterima !== curr.pilihan_diterima) {
      // Status changed (unlikely but possible)
      changes.newOut.push({
        ...curr,
        previous_school: prev.pilihan_diterima,
        now_school: curr.pilihan_diterima,
      });
    }
  });
  
  changes.hasChanges = changes.newIn.length > 0 || changes.newOut.length > 0 || changes.newRegistrants.length > 0;
  return changes;
}

function saveCurrentState() {
  const state = {};
  allStudents.forEach(r => {
    if (r.verified) {
      state[r.regno] = {
        pilihan_diterima: r.pilihan_diterima,
        pd_pilihan: r.pd_pilihan,
        peringkat: r.peringkat,
        kuota: r.kuota,
        is_smpn9: r.is_smpn9,
      };
    }
  });
  localStorage.setItem(CONFIG.previousStateKey, JSON.stringify(state));
}

function saveChangesLog(changes) {
  try {
    let log = [];
    const data = localStorage.getItem(CONFIG.changesKey);
    if (data) log = JSON.parse(data);
    
    if (changes.hasChanges) {
      log.push({
        timestamp: new Date().toISOString(),
        newIn: changes.newIn.map(r => ({ regno: r.regno, nama: r.nama, from: r.previous_school })),
        newOut: changes.newOut.map(r => ({ regno: r.regno, nama: r.nama, from: r.previous_school, to: r.now_school })),
        newRegistrants: changes.newRegistrants.map(r => ({ regno: r.regno, nama: r.nama })),
      });
      // Keep only last 50 entries
      if (log.length > 50) log = log.slice(-50);
      localStorage.setItem(CONFIG.changesKey, JSON.stringify(log));
    }
  } catch (e) {}
}

// ============================================================
// RENDER CHANGES PANEL
// ============================================================
function renderChangesPanel(changes) {
  const panel = document.getElementById('changesPanel');
  const content = document.getElementById('changesContent');
  
  if (!changes || !changes.hasChanges) {
    panel.style.display = 'none';
    return;
  }
  
  let html = '';
  
  if (changes.newIn.length > 0) {
    html += `<div style="margin-bottom:10px;"><strong style="color:#16a34a;">⬆️ BARU MASUK SMPN 9 (${changes.newIn.length} siswa):</strong> Mereka sebelumnya diterima di sekolah lain, sekarang FALL THROUGH ke SMPN 9.</div>`;
    html += '<table style="font-size:12px; margin-top:4px;"><thead><tr>';
    html += '<th>REGNO</th><th>Nama</th><th>Asal SD</th><th>Nilai</th><th>Sebelumnya di</th><th>Sekarang di</th>';
    html += '</tr></thead><tbody>';
    changes.newIn.forEach(r => {
      html += `<tr style="background:#dcfce7;">
        <td><strong>${r.regno}</strong></td>
        <td>${escapeHtml(r.nama)}</td>
        <td>${escapeHtml(r.asal_sekolah)}</td>
        <td><strong>${r.nilai_akhir}</strong></td>
        <td><span style="color:#64748b;">${escapeHtml(r.previous_school)}</span></td>
        <td><strong style="color:#16a34a;">SMP NEGERI 9</strong></td>
      </tr>`;
    });
    html += '</tbody></table>';
  }
  
  if (changes.newOut.length > 0) {
    html += `<div style="margin-top:14px;margin-bottom:10px;"><strong style="color:#dc2626;">⬇️ BARU KELUAR DARI SMPN 9 (${changes.newOut.length} siswa):</strong> Mereka di-geser keluar dari SMPN 9.</div>`;
    html += '<table style="font-size:12px; margin-top:4px;"><thead><tr>';
    html += '<th>REGNO</th><th>Nama</th><th>Asal SD</th><th>Nilai</th><th>Sebelumnya di</th><th>Sekarang di</th>';
    html += '</tr></thead><tbody>';
    changes.newOut.forEach(r => {
      html += `<tr style="background:#fee2e2;">
        <td><strong>${r.regno}</strong></td>
        <td>${escapeHtml(r.nama)}</td>
        <td>${escapeHtml(r.asal_sekolah)}</td>
        <td><strong>${r.nilai_akhir}</strong></td>
        <td><strong style="color:#16a34a;">SMP NEGERI 9</strong></td>
        <td><span style="color:#64748b;">${escapeHtml(r.now_school)}</span></td>
      </tr>`;
    });
    html += '</tbody></table>';
  }
  
  if (changes.newRegistrants.length > 0) {
    html += `<div style="margin-top:14px;"><strong style="color:#4f46e5;">🆕 PENDAFTAR BARU (${changes.newRegistrants.length} siswa):</strong> Siswa yang muncul pertama kali.</div>`;
    html += '<div style="font-size:11px; color:#64748b; margin-top:4px;">';
    changes.newRegistrants.slice(0, 10).forEach(r => {
      html += `<span style="display:inline-block;margin-right:10px;">${r.regno} - ${escapeHtml(r.nama)}</span>`;
    });
    if (changes.newRegistrants.length > 10) html += `<em>...dan ${changes.newRegistrants.length - 10} lainnya</em>`;
    html += '</div>';
  }
  
  content.innerHTML = html;
  panel.style.display = 'block';
}

