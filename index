function doRestore(file){
  if(!file)return;
  const mode=$('rstMode')?.value||'replace';
  if(mode==='replace' && !confirm('⚠️ Mode GANTI SEMUA akan menghapus data saat ini! Lanjutkan?'))return;
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      const bk=JSON.parse(ev.target.result);
      const selQ=$('rsQ')?.checked, selR=$('rsR')?.checked, selU=$('rsU')?.checked;
      
      if(mode==='replace'){
        DB={users:bk.users||DB.users,questions:bk.questions||{},results:bk.results||[]};
        save();initDB();renderHome();toast(`✅ Restore penuh selesai`,'success');
      }else if(mode==='merge'){
        // merge
        if(bk.questions)Object.entries(bk.questions).forEach(([k,v])=>{if(!DB.questions[k])DB.questions[k]=[];DB.questions[k].push(...v);});
        if(bk.results){bk.results.forEach(ur=>{const ex=DB.results.find(r=>r.userId===ur.userId);if(ex)ex.results.push(...ur.results);else DB.results.push(ur);});}
        if(bk.users){bk.users.forEach(u=>{if(!DB.users.find(x=>x.username===u.username))DB.users.push(u);});}
        save();initDB();renderHome();toast('✅ Merge selesai','success');
      }else if(mode==='selective'){
        if(selQ && bk.questions)DB.questions=bk.questions;
        if(selR && bk.results)DB.results=bk.results;
        if(selU && bk.users)DB.users=bk.users;
        save();initDB();renderHome();toast('✅ Restore pilihan selesai','success');
      }
    }catch(err){toast('❌ '+err.message,'error');}
  };
  reader.readAsText(file);
}

