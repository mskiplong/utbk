    <!-- Toast Notification -->
    <div class="toast" id="toast">
        <span id="toastIcon">✅</span>
        <span id="toastMsg">Notification</span>
    </div>

    <script>
        // ===== CONFIGURATION =====
        const services = {
            1: { url: 'https://up.mskiplong.workers.dev', name: 'PENGELOLAAN UP', icon: '☁️' },
            2: { url: 'https://3dipa.mskiplong.workers.dev', name: '3D IPA Viewer', icon: '🎮' },
            3: { url: 'https://cms.mskiplong.workers.dev', name: 'CMS Dashboard', icon: '📝' }
        };

        let currentServiceUrl = '';

        // ===== PARTICLES =====
        function createParticles() {
            const container = document.getElementById('particles');
            const count = window.innerWidth < 768 ? 20 : 40;

            for (let i = 0; i < count; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDuration = (Math.random() * 15 + 10) + 's';
                particle.style.animationDelay = (Math.random() * 15) + 's';
                particle.style.width = (Math.random() * 3 + 1) + 'px';
                particle.style.height = particle.style.width;
                container.appendChild(particle);
            }
        }

        // ===== VIEWER FUNCTIONS =====
        function openViewer(url, title, icon, serviceId) {
            currentServiceUrl = url;

            const overlay = document.getElementById('viewerOverlay');
            const frame = document.getElementById('viewerFrame');
            const loading = document.getElementById('viewerLoading');

            document.getElementById('viewerTitle').textContent = title;
            document.getElementById('viewerIcon').textContent = icon;
            document.getElementById('viewerUrlBar').textContent = '🔒 ' + url.replace('https://', '');

            loading.style.display = 'flex';
            frame.style.opacity = '0';
            frame.src = url;

            frame.onload = function() {
                loading.style.display = 'none';
                frame.style.opacity = '1';
                frame.style.transition = 'opacity 0.3s ease';
                showToast('✅', title + ' berhasil dimuat');
            };

            frame.onerror = function() {
                loading.innerHTML = `
                    <div style="text-align:center;">
                        <div style="font-size:3rem;margin-bottom:15px;">⚠️</div>
                        <p style="color:var(--text-secondary);margin-bottom:15px;">Tidak dapat memuat dalam iframe</p>
                        <button class="action-btn" onclick="openExternal()" style="background:linear-gradient(135deg,var(--accent-1),var(--accent-2));border:none;font-size:0.9rem;">
                            🔗 Buka di Tab Baru
                        </button>
                    </div>
                `;
            };

            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeViewer() {
            const overlay = document.getElementById('viewerOverlay');
            const frame = document.getElementById('viewerFrame');

            overlay.classList.remove('active');
            document.body.style.overflow = '';

            setTimeout(() => {
                frame.src = '';
            }, 300);
        }

        function openExternal() {
            if (currentServiceUrl) {
                window.open(currentServiceUrl, '_blank');
                showToast('🔗', 'Dibuka di tab baru');
            }
        }

        function refreshViewer() {
            const frame = document.getElementById('viewerFrame');
            const loading = document.getElementById('viewerLoading');

            loading.style.display = 'flex';
            loading.innerHTML = '<div class="spinner"></div><p>Memuat ulang...</p>';
            frame.style.opacity = '0';

            frame.src = frame.src;
            showToast('🔄', 'Memuat ulang layanan...');
        }

        // ===== STATUS CHECK =====
        function checkAllStatus() {
            showToast('🔄', 'Memeriksa status semua layanan...');

            let checkedCount = 0;

            Object.values(services).forEach((service, index) => {
                setTimeout(() => {
                    fetch(service.url, { mode: 'no-cors', cache: 'no-cache' })
                        .then(() => {
                            checkedCount++;
                            if (checkedCount === Object.keys(services).length) {
                                showToast('✅', 'Semua layanan berjalan normal!');
                            }
                        })
                        .catch(() => {
                            showToast('⚠️', service.name + ' mungkin tidak tersedia');
                        });
                }, index * 500);
            });
        }

        // ===== TOAST =====
        function showToast(icon, message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastIcon').textContent = icon;
            document.getElementById('toastMsg').textContent = message;

            toast.classList.add('show');

            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // ===== KEYBOARD SHORTCUTS =====
        document.addEventListener('keydown', function(e) {
            // Escape to close viewer
            if (e.key === 'Escape') {
                closeViewer();
            }

            // Alt + 1/2/3 to open services
            if (e.altKey) {
                const num = parseInt(e.key);
                if (services[num]) {
                    e.preventDefault();
                    const s = services[num];
                    openViewer(s.url, s.name, s.icon, num);
                }
            }
        });

        // ===== SCROLL EFFECTS =====
        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Navbar background on scroll
        let lastScroll = 0;
        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            const scrollY = window.scrollY;

            if (scrollY > 50) {
                navbar.style.background = 'rgba(10, 10, 26, 0.9)';
                navbar.style.borderColor = 'rgba(255, 255, 255, 0.15)';
            } else {
                navbar.style.background = 'rgba(255, 255, 255, 0.05)';
                navbar.style.borderColor = 'rgba(255, 255, 255, 0.1)';
            }

            lastScroll = scrollY;
        });

        // ===== MOBILE TOGGLE =====
        function toggleMobileInfo() {
            showToast('ℹ️', '3 layanan aktif — Tap kartu untuk membuka');
        }

        // ===== INTERSECTION OBSERVER FOR ANIMATIONS =====
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animationPlayState = 'running';
                }
            });
        }, observerOptions);

        // ===== CARD MOUSE EFFECT =====
        document.querySelectorAll('.service-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const glow = card.querySelector('.card-glow');
                if (glow) {
                    glow.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.05) 0%, transparent 60%)`;
                    glow.style.opacity = '1';
                }
            });

            card.addEventListener('mouseleave', () => {
                const glow = card.querySelector('.card-glow');
                if (glow) {
                    glow.style.opacity = '0';
                }
            });
        });

        // ===== INIT =====
        document.addEventListener('DOMContentLoaded', () => {
            createParticles();
            document.getElementById('year').textContent = new Date().getFullYear();

            // Welcome toast
            setTimeout(() => {
                showToast('👋', 'Selamat datang di MSKI KPPN PEKALONGAN!');
            }, 1000);
        });

        // ===== SERVICE WORKER REGISTRATION (Optional) =====
        // Uncomment if you want offline support
        /*
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js')
                .then(() => console.log('SW registered'))
                .catch(() => console.log('SW registration failed'));
        }
        */
    </script>

