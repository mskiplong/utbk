// ============================================================
// PRINT & SETTINGS
// ============================================================
function printPage(){
  // 1. Update tanggal header
  ['prt-date','prt-date-dash','prt-date-rank',
   'prt-date-belum','prt-date-pbn'].forEach(id => {
    const el = document.getElementById(id);
    if(el) el.textContent = today();
  });

  // 2. Update info bank & periode
  const bankEl  = document.getElementById('rek-filter-bank');
  const yearEl  = document.getElementById('rek-filter-year');
  const monthEl = document.getElementById('rek-filter-month');
  const prtBank   = document.getElementById('prt-bank');
  const prtPeriod = document.getElementById('prt-period');

  if(prtBank) prtBank.textContent =
    bankEl?.options[bankEl.selectedIndex]?.text || 'Semua Bank';
  if(prtPeriod) prtPeriod.textContent =
    `${monthEl?.options[monthEl.selectedIndex]?.text || 'Semua Bulan'} 
     ${yearEl?.value || ''}`.trim();

  // 3. Paksa tampilkan SEMUA row sebelum print
  const tbody   = document.getElementById('main-tbody');
  const allRows = tbody ? [...tbody.querySelectorAll('tr')] : [];
  
  allRows.forEach(tr => {
    tr._origDisplay = tr.style.display; // simpan state
    tr.style.display = 'table-row';     // tampilkan semua
  });

  // 4. Sembunyikan pagination control
  const pgn = document.getElementById('rek-pgn');
  if(pgn) {
    pgn._origDisplay = pgn.style.display;
    pgn.style.display = 'none';
  }

  // 5. Tunggu DOM render ulang, baru print
  setTimeout(() => {
    window.print();

    // 6. Kembalikan state semula setelah print selesai
    setTimeout(() => {
      allRows.forEach(tr => {
        tr.style.display = tr._origDisplay !== undefined 
          ? tr._origDisplay : '';
        delete tr._origDisplay;
      });

      if(pgn) {
        pgn.style.display = pgn._origDisplay !== undefined 
          ? pgn._origDisplay : '';
        delete pgn._origDisplay;
      }

    }, 800);
  }, 300);
}
function refreshSettings(){
  const db=getDB(),sz=dbSz(),pct=Math.min((sz/(5*1024*1024))*100,100);
  document.getElementById('db-status').innerHTML=`
    <div style="margin-bottom:12px;">
      <div style="display:flex;justify-content:space-between;margin-bottom:4px;"><span class="txt-sm">Storage</span><span class="txt-sm">${(sz/1024).toFixed(1)} KB / ~5 MB</span></div>
      <div class="prog"><div class="prog-b ${pct>80?'prog-or':'prog-bl'}" style="width:${pct}%"></div></div>
    </div>
    ${[['File Terupload',(db.sources||[]).length],['Raw Data Rows',(db.rawData||[]).length],['Baris Rekap',(db.rekap||[]).length],['Satker RUH',(db.ruh||[]).length]].map(([l,v])=>`
      <div style="display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid var(--b1);">
        <span class="txt-sm txt-m">${l}</span><span class="txt-sm fw7">${v.toLocaleString()}</span>
      </div>`).join('')}
  `;
}
function doBackup(){
  const d={db:getDB(),v:3,ts:new Date().toISOString()};
  dlBlob(JSON.stringify(d,null,2),`CMS_VA_Backup_${tstamp()}.json`,'application/json');
