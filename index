function doSave(){
  const bankLabel=getBankLabel();const db=getDB();
  if(!db.sources)db.sources=[];if(!db.rawData)db.rawData=[];
  const processed=[];let err=0;
  G.sheetData.forEach((row,i)=>{
    try{
      const rec={_bank:bankLabel,_year:G.year,_month:G.month,_dtype:G.dtype,_id:`${bankLabel}_${G.year}_${G.month}_${i}`};
      FIELDS.forEach(f=>{
        const srcH=G.mapping[f.key],idx=srcH?G.headers.indexOf(srcH):-1;
        let v=idx>=0?row[idx]:'';
        if(f.type==='number')v=pN(v);else v=String(v||'').trim();
        rec[f.key]=v;
      });
      processed.push(rec);
    }catch(e){err++;}
  });
  db.rawData=(db.rawData||[]).filter(r=>!(r._bank===bankLabel&&r._year===G.year&&r._month===G.month&&r._dtype===G.dtype));
  db.rawData=db.rawData.concat(processed);
  db.sources=(db.sources||[]).filter(s=>!(s.bank===bankLabel&&s.year===G.year&&s.month===G.month&&s.dtype===G.dtype));
  db.sources.push({id:`${bankLabel}_${G.year}_${G.month}_${G.dtype}`,bank:bankLabel,year:G.year,month:G.month,dtype:G.dtype,name:G.impFile,rows:processed.length,date:new Date().toLocaleDateString('id-ID'),mapping:{...G.mapping}});
  setDB(db);
  addLog('s',`✅ ${processed.length} baris disimpan!`);
  if(err)addLog('w',`${err} baris error`);
  toast(`${processed.length} data berhasil disimpan!`,'success');
  setTimeout(()=>{buildRekap();refreshDash();},500);
}

