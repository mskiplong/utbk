function renderPerbandingan(){
  const db=getDB();const ruh=db.ruh||[];const rek=G.rekapData.length?G.rekapData:db.rekap||[];
  const bank=document.getElementById('pbn-bank').value;const year=document.getElementById('pbn-year').value;
