<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CMS - Monitoring System KPPN Pekalongan</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
--bg:#0a0f1e;--card:#111827;--panel:#1a2235;
--b1:#1f2d45;--b2:#243347;
--t1:#e8edf5;--t2:#8897ae;--t3:#4a5568;
--blue:#3b82f6;--green:#10b981;--red:#ef4444;
--orange:#f59e0b;--purple:#8b5cf6;--cyan:#06b6d4;
--pink:#ec4899;--bg1:rgba(59,130,246,0.1);
}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--t1);min-height:100vh;}
.sidebar{position:fixed;left:0;top:0;width:238px;height:100vh;background:var(--card);border-right:1px solid var(--b1);display:flex;flex-direction:column;z-index:200;transition:transform 0.3s;}
.logo{padding:16px 15px;border-bottom:1px solid var(--b1);}
.logo h2{font-size:0.9rem;color:var(--blue);font-weight:700;}
.logo small{font-size:0.63rem;color:var(--t3);}
.nav{flex:1;overflow-y:auto;padding:5px 0;}
.ns{padding:9px 13px 2px;font-size:0.6rem;text-transform:uppercase;letter-spacing:1.4px;color:var(--t3);}
.na{display:flex;align-items:center;gap:8px;padding:8px 13px;cursor:pointer;color:var(--t2);font-size:0.79rem;border-left:3px solid transparent;transition:all 0.2s;}
.na:hover{background:var(--panel);color:var(--t1);}
.na.on{background:var(--bg1);color:var(--blue);border-left-color:var(--blue);}
.na .ic{font-size:0.88rem;width:16px;text-align:center;}
.nb{margin-left:auto;background:var(--blue);color:#fff;font-size:0.58rem;padding:1px 5px;border-radius:9px;min-width:18px;text-align:center;}
.nb.rd{background:var(--red);}
.sf{padding:9px 13px;border-top:1px solid var(--b1);font-size:0.65rem;color:var(--t3);}
.main{margin-left:238px;min-height:100vh;display:flex;flex-direction:column;}
.topbar{position:sticky;top:0;z-index:100;background:rgba(10,15,30,0.97);backdrop-filter:blur(10px);border-bottom:1px solid var(--b1);padding:0 18px;height:50px;display:flex;align-items:center;justify-content:space-between;}
.tb-l{display:flex;align-items:center;gap:10px;}
.tb-title{font-size:0.88rem;font-weight:600;}
.tb-bc{font-size:0.68rem;color:var(--t3);}
.tb-r{display:flex;align-items:center;gap:8px;}
.clk{font-size:0.73rem;color:var(--t2);font-family:monospace;}
.pc{flex:1;padding:18px;}
.sec{display:none;}.sec.on{display:block;}
.card{background:var(--panel);border:1px solid var(--b1);border-radius:10px;overflow:hidden;margin-bottom:16px;}
.ch{padding:12px 17px;border-bottom:1px solid var(--b1);display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;}
.ch h3{font-size:0.84rem;font-weight:600;display:flex;align-items:center;gap:6px;}
.cb{padding:17px;}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.ga{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:12px;}
.mb4{margin-bottom:14px;}.mb6{margin-bottom:18px;}.mt4{margin-top:12px;}.mt6{margin-top:18px;}
.sc{background:var(--panel);border:1px solid var(--b1);border-radius:10px;padding:13px 15px;position:relative;overflow:hidden;transition:transform 0.2s;cursor:default;}
.sc:hover{transform:translateY(-2px);}
.sc.bl{border-top:2px solid var(--blue);}.sc.gr{border-top:2px solid var(--green);}
.sc.rd{border-top:2px solid var(--red);}.sc.or{border-top:2px solid var(--orange);}
.sc.pu{border-top:2px solid var(--purple);}.sc.cy{border-top:2px solid var(--cyan);}
.sc.pk{border-top:2px solid var(--pink);}
.sc-lbl{font-size:0.63rem;color:var(--t3);text-transform:uppercase;letter-spacing:0.6px;margin-bottom:5px;}
.sc-val{font-size:1.25rem;font-weight:700;line-height:1;}
.sc-sub{font-size:0.62rem;color:var(--t3);margin-top:4px;}
.sc-ic{position:absolute;top:11px;right:11px;font-size:1.25rem;opacity:0.28;}
.btn{display:inline-flex;align-items:center;gap:5px;padding:7px 13px;border:none;border-radius:7px;cursor:pointer;font-size:0.77rem;font-weight:600;transition:all 0.2s;white-space:nowrap;}
.btn:active{transform:scale(0.97);}
.bxs{padding:3px 7px;font-size:0.67rem;border-radius:5px;}
.bsm{padding:5px 10px;font-size:0.74rem;border-radius:6px;}
.blg{padding:10px 18px;font-size:0.84rem;}
.bp{background:var(--blue);color:#fff;}.bp:hover{background:#2563eb;}
.bs{background:var(--green);color:#fff;}.bs:hover{background:#059669;}
.bd{background:var(--red);color:#fff;}.bd:hover{background:#dc2626;}
.bw{background:var(--orange);color:#111;}.bw:hover{background:#d97706;}
.bpu{background:var(--purple);color:#fff;}.bpu:hover{background:#7c3aed;}
.bcy{background:var(--cyan);color:#111;}.bcy:hover{background:#0891b2;}
.bg2{background:transparent;border:1px solid var(--b2);color:var(--t2);}.bg2:hover{border-color:var(--blue);color:var(--blue);background:var(--bg1);}
.bgr{display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
.fl{display:block;font-size:0.71rem;color:var(--t2);margin-bottom:4px;font-weight:500;}
.fc{width:100%;padding:7px 10px;background:var(--bg);border:1px solid var(--b2);border-radius:7px;color:var(--t1);font-size:0.77rem;outline:none;transition:border-color 0.2s;}
.fc:focus{border-color:var(--blue);}
.fc::placeholder{color:var(--t3);}
select.fc option{background:var(--panel);}
.fg{margin-bottom:11px;}
.fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:10px;}
.tbl-outer{overflow-x:auto;max-height:72vh;overflow-y:auto;border-radius:7px;border:1px solid var(--b1);}
.tbl-main{border-collapse:collapse;font-size:0.71rem;min-width:1900px;width:100%;}
.tbl-main thead tr:first-child th{padding:7px 9px;text-align:center;font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.45px;position:sticky;top:0;z-index:10;border:1px solid var(--b1);white-space:nowrap;}
.tbl-main thead tr:nth-child(2) th{padding:6px 9px;text-align:center;font-size:0.61rem;font-weight:600;text-transform:uppercase;letter-spacing:0.35px;position:sticky;top:31px;z-index:9;border:1px solid var(--b1);white-space:nowrap;}
.hg-no{background:#0f172a;color:var(--t3);}
.hg-info{background:#0f1e35;color:var(--cyan);}
.hg-ba{background:#131d30;color:#67e8f9;}
.hg-esl{background:#0e1628;color:#c4b5fd;}
.hg-kwl{background:#10162a;color:#93c5fd;}
.hg-sk{background:#0f1e35;color:var(--t1);}
.hg-induk{background:#0c1c1c;color:#6ee7b7;}
.hg-va{background:#1a1525;color:#fdba74;}
.hg-cms{background:#0e1828;color:#60a5fa;}
.hg-dbt{background:#130e28;color:#a78bfa;}
.hg-tel{background:#0c1a18;color:#34d399;}
.hg-st{background:#0e1020;color:var(--t2);}
.hg-info2{background:#0a1929;color:#a5f3fc;}
.hg-ba2{background:#091525;color:#67e8f9;}
.hg-esl2{background:#080b22;color:#ddd6fe;}
.hg-kwl2{background:#080e22;color:#bfdbfe;}
.hg-sk2{background:#091525;color:#e2e8f0;}
.hg-induk2{background:#081818;color:#a7f3d0;}
.hg-va2{background:#120e20;color:#fed7aa;}
.hg-cms2{background:#080d20;color:#93c5fd;}
.hg-dbt2{background:#0a0820;color:#c4b5fd;}
.hg-tel2{background:#06130f;color:#6ee7b7;}
.tbl-main tbody td{padding:6px 9px;border:1px solid var(--b1);color:var(--t2);white-space:nowrap;vertical-align:middle;}
.tbl-main tbody tr:hover td{background:rgba(59,130,246,0.05);color:var(--t1);}
.tbl-main tbody tr:nth-child(even) td{background:rgba(0,0,0,0.12);}
.tbl-main tbody tr:nth-child(even):hover td{background:rgba(59,130,246,0.05);}
.row-belum td{background:rgba(239,68,68,0.06)!important;}
.row-belum:hover td{background:rgba(239,68,68,0.12)!important;}
.td-no{text-align:center;color:var(--t3);font-size:0.66rem;width:32px;}
.td-code{text-align:center;font-family:monospace;font-size:0.68rem;}
.td-r{text-align:right;font-family:monospace;}
.td-c{text-align:center;}
.td-money{text-align:right;font-family:monospace;font-weight:600;}
.td-cnt{text-align:center;font-family:monospace;font-weight:700;}
.saldo-pos{color:var(--green);}
.saldo-neg{color:var(--red);}
.saldo-z{color:var(--t3);}
.badge{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:20px;font-size:0.62rem;font-weight:700;}
.b-ok{background:rgba(16,185,129,0.15);color:#34d399;border:1px solid rgba(16,185,129,0.25);}
.b-err{background:rgba(239,68,68,0.15);color:#f87171;border:1px solid rgba(239,68,68,0.25);}
.b-wrn{background:rgba(245,158,11,0.15);color:#fbbf24;border:1px solid rgba(245,158,11,0.25);}
.b-inf{background:rgba(6,182,212,0.15);color:#22d3ee;border:1px solid rgba(6,182,212,0.25);}
.b-pu{background:rgba(139,92,246,0.15);color:#a78bfa;border:1px solid rgba(139,92,246,0.25);}
.b-new{background:rgba(59,130,246,0.15);color:#93c5fd;border:1px solid rgba(59,130,246,0.25);}
.b-pk{background:rgba(236,72,153,0.15);color:#f472b6;border:1px solid rgba(236,72,153,0.25);}
.st-aktif{display:inline-block;padding:2px 8px;border-radius:10px;font-size:0.63rem;font-weight:700;background:rgba(16,185,129,0.15);color:#34d399;border:1px solid rgba(16,185,129,0.3);}
.st-tutup{display:inline-block;padding:2px 8px;border-radius:10px;font-size:0.63rem;font-weight:700;background:rgba(239,68,68,0.15);color:#f87171;border:1px solid rgba(239,68,68,0.3);}
.st-belum{display:inline-block;padding:2px 8px;border-radius:10px;font-size:0.63rem;font-weight:700;background:rgba(239,68,68,0.2);color:#fca5a5;border:1px solid rgba(239,68,68,0.4);}
.rank{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;font-size:0.65rem;font-weight:700;}
.rank-1{background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;}
.rank-2{background:linear-gradient(135deg,#94a3b8,#64748b);color:#fff;}
.rank-3{background:linear-gradient(135deg,#f97316,#ea580c);color:#fff;}
.rank-n{background:var(--b2);color:var(--t2);}
/* Rank badge clickable untuk top 3 */
.rank-clickable{cursor:pointer;transition:transform 0.2s,box-shadow 0.2s;width:28px;height:28px;font-size:0.75rem;}
.rank-clickable:hover{transform:scale(1.2);box-shadow:0 0 10px rgba(245,158,11,0.5);}
.upload-z{border:2px dashed var(--b2);border-radius:11px;padding:32px 20px;text-align:center;cursor:pointer;transition:all 0.3s;background:rgba(0,0,0,0.15);}
.upload-z:hover,.upload-z.dg{border-color:var(--blue);background:var(--bg1);}
.upload-z .ui{font-size:2.3rem;margin-bottom:10px;opacity:0.6;}
.stepper{display:flex;align-items:center;margin-bottom:18px;overflow-x:auto;padding-bottom:3px;}
.sti{display:flex;align-items:center;gap:6px;flex-shrink:0;}
.stc{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;border:2px solid var(--b1);color:var(--t3);transition:all 0.3s;}
.sti.done .stc{background:var(--green);border-color:var(--green);color:#fff;}
.sti.active .stc{background:var(--blue);border-color:var(--blue);color:#fff;box-shadow:0 0 0 3px rgba(59,130,246,0.2);}
.stl{font-size:0.7rem;color:var(--t3);}
.sti.active .stl{color:var(--blue);font-weight:600;}
.sti.done .stl{color:var(--green);}
.stline{flex:1;height:2px;background:var(--b1);margin:0 6px;min-width:20px;}
.stline.done{background:var(--green);}
.det-row{display:grid;grid-template-columns:1fr 26px 1fr;gap:7px;align-items:center;padding:6px 10px;border-bottom:1px solid var(--b1);}
.det-row:last-child{border-bottom:none;}
.det-std{padding:5px 9px;background:rgba(0,0,0,0.22);border-radius:6px;}
.det-std .sn{font-size:0.76rem;font-weight:600;color:var(--t1);}
.det-std .sk{font-size:0.61rem;color:var(--t3);font-family:monospace;}
.det-arr{text-align:center;color:var(--blue);font-size:0.9rem;}
.cbar{flex:1;height:4px;background:var(--b1);border-radius:2px;overflow:hidden;}
.cf{height:100%;border-radius:2px;transition:width 0.5s;}
.cf-hi{background:var(--green);}.cf-md{background:var(--orange);}.cf-lo{background:var(--red);}
.logp{background:#060d1a;border:1px solid var(--b1);border-radius:8px;padding:10px;font-family:monospace;font-size:0.7rem;max-height:170px;overflow-y:auto;}
.ll{padding:2px 0;}.lts{color:var(--t3);margin-right:5px;}
.li{color:var(--cyan);}.ls{color:var(--green);}.lw{color:var(--orange);}.le{color:var(--red);}
.prog{width:100%;height:4px;background:var(--b1);border-radius:2px;overflow:hidden;}
.prog-b{height:100%;border-radius:2px;transition:width 0.4s;}
.prog-bl{background:linear-gradient(90deg,var(--blue),var(--cyan));}
.prog-gr{background:var(--green);}
.prog-or{background:var(--orange);}
.pgn{display:flex;justify-content:space-between;align-items:center;padding-top:11px;flex-wrap:wrap;gap:6px;}
.pgi{font-size:0.7rem;color:var(--t3);}
.pgb{display:flex;gap:3px;}
.pb{width:27px;height:27px;border:1px solid var(--b2);background:transparent;color:var(--t2);border-radius:5px;cursor:pointer;font-size:0.7rem;display:flex;align-items:center;justify-content:center;transition:all 0.2s;}
.pb:hover,.pb.on{background:var(--blue);border-color:var(--blue);color:#fff;}
.pb:disabled{opacity:0.3;cursor:default;}
.mo{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:500;align-items:center;justify-content:center;padding:15px;}
.mo.show{display:flex;}
.md{background:var(--panel);border:1px solid var(--b2);border-radius:13px;width:100%;max-width:820px;max-height:88vh;display:flex;flex-direction:column;animation:fu 0.25s ease;}
.md.sml{max-width:450px;}.md.xlg{max-width:96vw;}
.mh{padding:13px 17px;border-bottom:1px solid var(--b1);display:flex;justify-content:space-between;align-items:center;}
.mh h3{font-size:0.88rem;}
.mc{background:none;border:none;color:var(--t3);font-size:1.25rem;cursor:pointer;padding:3px;}.mc:hover{color:var(--red);}
.mb2{padding:17px;overflow-y:auto;flex:1;}
.mf{padding:11px 17px;border-top:1px solid var(--b1);display:flex;justify-content:flex-end;gap:7px;}
@keyframes fu{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}
.tstack{position:fixed;top:15px;right:15px;z-index:1000;display:flex;flex-direction:column;gap:6px;pointer-events:none;}
.toast{padding:10px 14px;border-radius:8px;font-size:0.77rem;font-weight:500;min-width:240px;max-width:330px;pointer-events:all;animation:tin 0.25s ease;display:flex;align-items:center;gap:7px;}
.t-ok{background:#064e3b;border:1px solid var(--green);color:#a7f3d0;}
.t-err{background:#7f1d1d;border:1px solid var(--red);color:#fca5a5;}
.t-inf{background:#0c2461;border:1px solid var(--blue);color:#93c5fd;}
.t-wrn{background:#78350f;border:1px solid var(--orange);color:#fde68a;}
@keyframes tin{from{opacity:0;transform:translateX(100%)}to{opacity:1;transform:translateX(0)}}
.chip{display:inline-block;padding:2px 7px;border-radius:20px;font-size:0.61rem;background:var(--b1);color:var(--t2);margin:2px;}
.txt-g{color:var(--green);}.txt-r{color:var(--red);}.txt-o{color:var(--orange);}.txt-c{color:var(--cyan);}.txt-pk{color:var(--pink);}
.txt-m{color:var(--t3);}.txt-sm{font-size:0.73rem;}.txt-xs{font-size:0.65rem;}.fw7{font-weight:700;}
.empty{text-align:center;padding:32px 16px;color:var(--t3);}
.empty .ei{font-size:2.3rem;margin-bottom:9px;opacity:0.38;}
.empty h3{font-size:0.88rem;color:var(--t2);margin-bottom:5px;}
.empty p{font-size:0.77rem;}
.dv{height:1px;background:var(--b1);margin:13px 0;}
.fb{display:flex;justify-content:space-between;align-items:center;}
.info-box{background:var(--bg);border:1px solid var(--b1);border-radius:7px;padding:10px 13px;}
.dd{position:relative;display:inline-block;}
.ddm{display:none;position:absolute;right:0;top:100%;background:var(--panel);border:1px solid var(--b2);border-radius:8px;min-width:155px;z-index:300;overflow:hidden;margin-top:3px;box-shadow:0 8px 25px rgba(0,0,0,0.45);}
.dd:hover .ddm{display:block;}
.ddi{padding:8px 13px;cursor:pointer;font-size:0.77rem;color:var(--t2);display:flex;align-items:center;gap:7px;}
.ddi:hover{background:var(--b1);color:var(--t1);}
.ovl{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:150;}.ovl.show{display:block;}
.mtgl{display:none;background:none;border:1px solid var(--b1);color:var(--t1);padding:6px 8px;border-radius:7px;cursor:pointer;}
@media(max-width:860px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.mtgl{display:flex;}.g2,.g3,.g4{grid-template-columns:1fr}}
.bp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:10px;}
.bp-tile{padding:13px 11px;border:2px solid var(--b2);border-radius:10px;text-align:center;cursor:pointer;transition:all 0.2s;position:relative;}
.bp-tile:hover{border-color:var(--blue);background:var(--bg1);}
.bp-tile.sel{border-color:var(--blue);background:var(--bg1);}
.bp-tile.sel::after{content:'✓';position:absolute;top:5px;right:8px;font-size:0.72rem;color:var(--blue);}
.bp-tile .ti{font-size:1.5rem;margin-bottom:6px;}
.bp-tile .tn{font-size:0.76rem;font-weight:700;}
.bp-tile .tc3{font-size:0.63rem;color:var(--t3);margin-top:2px;}
.bp-bar{height:3px;border-radius:2px;margin-top:6px;background:var(--b1);overflow:hidden;}
.bp-bar-f{height:100%;border-radius:2px;}
.month-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;}
.month-btn{padding:7px 4px;border:1px solid var(--b2);border-radius:7px;text-align:center;cursor:pointer;font-size:0.72rem;color:var(--t2);transition:all 0.2s;background:transparent;}
.month-btn:hover{border-color:var(--blue);color:var(--blue);}
.month-btn.on{background:var(--blue);border-color:var(--blue);color:#fff;font-weight:700;}
.month-btn.has-data{border-color:var(--green);color:var(--green);}
.month-btn.has-data.on{background:var(--green);color:#fff;}
.upload-list{display:flex;flex-direction:column;gap:7px;}
.up-item{display:flex;align-items:center;justify-content:space-between;padding:9px 12px;background:var(--bg);border:1px solid var(--b1);border-radius:8px;gap:10px;}
.up-item .ui-info{display:flex;align-items:center;gap:9px;flex:1;min-width:0;}
.up-item .ui-icon{font-size:1.3rem;flex-shrink:0;}
.up-item .ui-name{font-size:0.78rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.up-item .ui-meta{font-size:0.65rem;color:var(--t3);}
.ruh-item{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:var(--bg);border:1px solid var(--b1);border-radius:7px;margin-bottom:6px;}
.ruh-kode{font-family:monospace;font-size:0.77rem;color:var(--cyan);font-weight:700;width:80px;flex-shrink:0;}
.ruh-nama{flex:1;font-size:0.78rem;padding:0 10px;}
.ruh-info{font-size:0.65rem;color:var(--t3);}
.rank-tbl{width:100%;border-collapse:collapse;font-size:0.77rem;}
.rank-tbl th{padding:8px 11px;background:rgba(0,0,0,0.28);color:var(--t3);font-size:0.65rem;text-transform:uppercase;letter-spacing:0.5px;border:1px solid var(--b1);}
.rank-tbl td{padding:7px 11px;border:1px solid var(--b1);color:var(--t2);}
