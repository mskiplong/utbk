function filterRekap(){
  const kw=(document.getElementById('rek-search')?.value||'').toLowerCase();
  const bank=document.getElementById('rek-filter-bank')?.value||'';
  const year=document.getElementById('rek-filter-year')?.value||'';
  const month=document.getElementById('rek-filter-month')?.value||'';
  const status=document.getElementById('rek-filter-status')?.value||'';
  G.rekapDisp=G.rekapData.filter(r=>{
