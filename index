function runDetect(){
  if(!G.headers.length)return;
  const res=autoDetect(G.headers,G.sheetData);
  G.mapping={};G.confidence={};
  Object.entries(res).forEach(([k,v])=>{if(v?.col){G.mapping[k]=v.col;G.confidence[k]=v.conf;}});
  renderDetectUI();
  renderMapPreview();
}

function renderDetectUI(){
  const mk=Object.keys(G.mapping).length,tot=FIELDS.length;
  const avgC=mk?Math.round(Object.values(G.confidence).reduce((a,b)=>a+b,0)/mk):0;
  const score=Math.round((mk/tot)*60+(avgC/100)*40);
  const scol=score>=75?'var(--green)':score>=50?'var(--orange)':'var(--red)';
  const hi=FIELDS.filter(f=>G.mapping[f.key]&&G.confidence[f.key]>=80).length;
  const miss=FIELDS.filter(f=>!G.mapping[f.key]).length;
  document.getElementById('det-summary').innerHTML=`
