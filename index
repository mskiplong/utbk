      : `⚠️ Local Proxy responded tapi tanpa tabel: ${text.length} chars`);
    console.log(`[Diagnose] Local proxy: ${hasTable ? 'OK' : 'NO TABLE'}`);
  } catch (e) {
    results.push(`❌ Local Python Proxy TIDAK berjalan. Jalankan "python3 spmb-proxy.py" di terminal.`);
    console.warn(`[Diagnose] Local proxy not running:`, e.message);
  }
  
  // Test 2: Public CORS proxies
  for (const proxy of CONFIG.corsProxies) {
    try {
      const response = await fetch(proxy, { method: 'GET' });
      results.push(`✅ CORS Proxy ${proxy}: HTTP ${response.status}`);
    } catch (e) {
      results.push(`❌ CORS Proxy ${proxy}: ${e.message.substring(0, 80)}`);
    }
  }
  
  // Test 3: Try SPMB fetch via available proxy
  try {
    const { text, source } = await fetchSpmbData(309, 3, 1, 10);
    const rowsMatch = (text.match(/<tr[^>]*>/g) || []).length - 1;
    results.push(`✅ SPMB fetch OK via: ${source} (${rowsMatch} rows)`);
  } catch (e) {
    results.push(`❌ SPMB fetch gagal: ${e.message.substring(0, 150)}`);
  }
  
  // Test 4: localStorage status
  const known = localStorage.getItem(CONFIG.storageKey);
  const cache = localStorage.getItem(CONFIG.verifyCacheKey);
  const prev = localStorage.getItem(CONFIG.previousStateKey);
  results.push(`ℹ️ localStorage: known=${known ? JSON.parse(known).length : 0}, cache=${cache ? Object.keys(JSON.parse(cache)).length : 0}, prev=${prev ? Object.keys(JSON.parse(prev)).length : 0}`);
  
  // Test 5: AllStudents state
  results.push(`ℹ️ allStudents saat ini: ${allStudents.length} siswa`);
  
  // Show results
  const summary = results.join('\n');
  console.log('=== Diagnose Results ===\n' + summary);
  
  alert('🔧 Hasil Diagnose:\n\n' + summary + '\n\nLihat Console (F12) untuk detail.');
  showStatus('info', '🔧 Diagnose selesai. Lihat Console atau alert di atas.');
}

