function backupAll(){dl(JSON.stringify({version:'3.0',date:new Date().toISOString(),...DB},null,2),`snbtpro_backup_${new Date().toISOString().split('T')[0]}.json`,'application/json');toast('✅ Backup diunduh','success');}

function doRestore(file){
  if(!file)return;
  if(!confirm('⚠️ Data saat ini akan ditimpa! Lanjutkan?'))return;
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      const bk=JSON.parse(ev.target.result);
      if(bk.users&&bk.ptnData&&bk.questions){
        DB={users:bk.users||[],questions:bk.questions||{},ptnData:bk.ptnData||[],results:bk.results||[]};
        save();initDB();renderHome();
        toast(`✅ Restore OK — ${Object.values(DB.questions).flat().length} soal, ${DB.ptnData.length} PTN`,'success');
      }else if(bk.questions&&bk.ptn){
        const newQ={};
        Object.entries(bk.questions).forEach(([sec,qs])=>{
          if(!Array.isArray(qs)||!qs.length)return;
          const match=SUBS.find(s=>s.name===sec||s.name.toLowerCase()===sec.toLowerCase()||s.code===sec);
          const key=match?match.name:sec;
          if(!newQ[key])newQ[key]=[];
          qs.forEach(q=>{if(!['easy','medium','hard'].includes(q.difficulty))q.difficulty='medium';newQ[key].push(q);});
        });
        const newPTN=(bk.ptn||[]).filter(p=>p.ptn&&p.prodi&&p.pg);
        DB.questions={...DB.questions,...newQ};
        DB.ptnData=[...DB.ptnData,...newPTN].filter((p,i,a)=>a.findIndex(x=>x.ptn===p.ptn&&x.prodi===p.prodi)===i);
        save();initDB();renderHome();
        toast(`✅ Import OK — ${Object.values(newQ).flat().length} soal, ${newPTN.length} PTN baru`,'success');
      }else{toast('❌ Format tidak dikenali','error');}
    }catch(err){toast('❌ '+err.message,'error');}
  };
  reader.readAsText(file);
}

