    return`<tr><td style="color:var(--tx2);font-size:10px">${globalIdx+1}</td><td style="max-width:320px"><div style="font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:300px">${q.question}</div></td><td><span class="badge d${diff[0]}" style="font-size:9px">${diff}</span></td><td><span class="badge bg-green" style="font-size:10px">${q.answer}</span></td><td><div class="tact"><button class="btn btn-w btn-sm" onclick="openSoalModal(${globalIdx},'${secName}')">✏ Ubah</button><button class="btn btn-d btn-sm" onclick="delSoal('${secName}',${globalIdx})">🗑</button></div></td></tr>`;
  }).join('')}</tbody></table>`;
}

