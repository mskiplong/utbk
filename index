    // FETCH LATEST DATA
    // ============================================================
    const allResults = [];
    const fetchErrors = [];
    
    for (const rstatus of [1, 2]) {
      try {
        const { text } = await fetchSpmbData(fsekolah, 3, rstatus);
        const records = parseTable(text);
        console.log(`[SPMB Monitor] Fetched rstatus=${rstatus}: ${records.length} rows`);
        allResults.push(...records.map(r => ({ ...r, pilihan_ke: rstatus })));
      } catch (e) {
        console.warn(`Failed to fetch rstatus=${rstatus}:`, e);
        fetchErrors.push(`rstatus=${rstatus}: ${e.message}`);
      }
    }
    
    // ============================================================
    // BUG FIX: Jangan timpa jika fetch gagal total
    // ============================================================
    if (allResults.length === 0) {
      const errMsg = fetchErrors.length > 0 
        ? `Gagal fetch data: ${fetchErrors.join('; ')}. Data lama TIDAK ditimpa.` 
        : 'Fetch berhasil tapi data kosong. Cek filter threshold atau CORS proxy.';
      console.error('[SPMB Monitor]', errMsg);
      if (!silent) {
        showStatus('error', '❌ ' + errMsg);
        // Show diagnostic info
        setTimeout(() => {
          if (confirm('Fetch gagal. Ingin melihat cara troubleshooting?')) {
            alert('Langkah troubleshooting:\n\n' +
                  '1. Buka Console (F12) untuk lihat error detail\n' +
                  '2. Cek koneksi internet\n' +
                  '3. CORS proxy (cors.eu.org) mungkin sedang down\n' +
                  '4. Coba klik tombol ini lagi beberapa saat kemudian\n' +
                  '5. Data lama Anda AMAN, tidak terhapus');
          }
        }, 500);
      } else {
        console.warn('[Auto-Refresh] Fetch failed:', errMsg);
      }
      return; // CRITICAL: Don't overwrite allStudents!
    }
    
    // Filter by threshold
    const newAllStudents = allResults.filter(r => {
      const nilai = parseFloat(r.nilai_akhir);
      return !isNaN(nilai) && nilai > threshold;
    });
    
    if (newAllStudents.length === 0 && allResults.length > 0) {
      const warnMsg = `Ada ${allResults.length} baris dari SPMB tapi SEMUA tersaring oleh threshold (${threshold}). Coba turunkan threshold.`;
      console.warn('[SPMB Monitor]', warnMsg);
      if (!silent) showStatus('warning', '⚠️ ' + warnMsg);
      // Still overwrite so user sees the change
    }
    
    // ============================================================
    // CLEANUP: Hapus cache entry untuk REGNO yang tidak ada lagi
    // (Hanya jika data baru tidak kosong)
    // ============================================================
    const currentRegnos = new Set(newAllStudents.map(r => r.regno));
    const removedCount = allStudents.length - newAllStudents.length;
    
    // Update knownRegnos: hapus yang tidak ada di data baru
    if (newAllStudents.length > 0) {
      const removedKnown = [];
      for (const regno of knownRegnos) {
        if (!currentRegnos.has(regno)) {
          knownRegnos.delete(regno);
          removedKnown.push(regno);
        }
      }
      saveKnownStudents();
      if (removedKnown.length > 0) {
        console.log(`[SPMB Monitor] Cleaned ${removedKnown.length} REGNO from knownRegnos`);
      }
      
      // Update verifiedCache: hapus entry untuk REGNO yang tidak ada
      try {
        const cacheData = localStorage.getItem(CONFIG.verifyCacheKey);
        if (cacheData) {
          const cache = JSON.parse(cacheData);
          let cacheRemoved = 0;
          Object.keys(cache).forEach(regno => {
            if (!currentRegnos.has(regno)) {
              delete cache[regno];
              cacheRemoved++;
            }
          });
          if (cacheRemoved > 0) {
            localStorage.setItem(CONFIG.verifyCacheKey, JSON.stringify(cache));
            console.log(`[SPMB Monitor] Cleaned ${cacheRemoved} stale entries from verifiedCache`);
          }
        }
      } catch (e) {}
      
      // Update previousState: hapus entry untuk REGNO yang tidak ada
      try {
        const prevData = localStorage.getItem(CONFIG.previousStateKey);
        if (prevData) {
          const prev = JSON.parse(prevData);
          let prevRemoved = 0;
          Object.keys(prev).forEach(regno => {
            if (!currentRegnos.has(regno)) {
              delete prev[regno];
              prevRemoved++;
            }
          });
          if (prevRemoved > 0) {
            localStorage.setItem(CONFIG.previousStateKey, JSON.stringify(prev));
            console.log(`[SPMB Monitor] Cleaned ${prevRemoved} stale entries from previousState`);
          }
        }
      } catch (e) {}
    }
    
    // ============================================================
    // OVERWRITE: Replace allStudents with latest data
    // ============================================================
    allStudents = newAllStudents;
    
    // Save current fetch timestamp
    localStorage.setItem(CONFIG.lastFetchKey, new Date().toISOString());
    document.getElementById('statLastFetch').textContent = new Date().toLocaleString('id-ID');
    
    // Detect new (vs known)
    const newStudents = allStudents.filter(r => !knownRegnos.has(r.regno));
    
    updateStats();
    renderResults(newStudents.map(s => s.regno));
    
    if (newStudents.length > 0) {
      if (!silent) {
        showStatus('success', `✨ Data terbaru: ${allStudents.length} siswa (${removedCount} dihapus dari data lama). ${newStudents.length} siswa BARU.`);
      }
      // Optional: alert + sound for auto mode
      if (silent && newStudents.length > 0) {
        try { new Notification('SPMB Monitor', { body: `${newStudents.length} siswa baru terdeteksi!` }); } catch (e) {}
      }
    } else if (!silent) {
      showStatus('success', `✅ Data terbaru dimuat: ${allStudents.length} siswa. ${removedCount} siswa hilang dari data lama.`);
    }
    
  } catch (e) {
    console.error(e);
    if (!silent) showStatus('error', '❌ Gagal fetch: ' + e.message);
    else console.warn('[Auto-Refresh] Fetch error:', e.message);
  } finally {
    if (!silent) {
      btn.disabled = false;
      btn.textContent = '🔄 Fetch Data Terbaru';
    }
  }
}

// ============================================================
// PARSE HTML TABLE
// ============================================================
function parseTable(html) {
  const records = [];
  
  if (!html || typeof html !== 'string') {
    console.warn('[parseTable] Empty or non-string html');
    return records;
  }
  
  // Find table - try multiple patterns
  let tableMatch = html.match(/<table[^>]*class="stdtable[^"]*"[^>]*>([\s\S]*?)<\/table>/);
  
  if (!tableMatch) {
    // Try alternative: any table with REGNO class
    tableMatch = html.match(/<table[^>]*>([\s\S]*?)<\/table>/);
    if (tableMatch) {
      console.warn('[parseTable] stdtable class not found, using generic table match');
    }
  }
  
  if (!tableMatch) {
    console.warn('[parseTable] No table found in HTML');
    return records;
  }
  
  const rows = tableMatch[1].match(/<tr[^>]*>([\s\S]*?)<\/tr>/g) || [];
  console.log(`[parseTable] Found ${rows.length} rows (including header)`);
  
  for (let i = 0; i < rows.length; i++) {
    if (i === 0) continue; // skip header
    const row = rows[i];
    const cells = [];
    const cellMatches = row.match(/<t[dh][^>]*>([\s\S]*?)<\/t[dh]>/g) || [];
    for (const cell of cellMatches) {
      const text = cell.replace(/<[^>]+>/g, '').trim();
      cells.push(text);
    }
    if (cells.length === 0 || !cells.some(c => c)) continue;
    
    const opt1Match = row.match(/class="opt1"[^>]*>([^<]+)</);
    const regnoMatch = row.match(/class="REGNO"[^>]*>([^<]+)</);
    
    // Validate essential fields
    const regno = regnoMatch ? regnoMatch[1] : null;
    if (!regno) continue; // Skip rows without REGNO
    
    records.push({
      no: cells[0] || '',
      regno: regno,
      nama: cells[2] || '',
      asal_sekolah: cells[3] || '',
      nilai_akhir: cells[4] || '',
      pil: cells[5] || '',
      opt1: opt1Match ? opt1Match[1] : 'N/A',
    });
  }
  
  console.log(`[parseTable] Extracted ${records.length} valid records`);
  return records;
}

