  const {doc,W}=pdfBase('Satker Belum Kirim CAPUT (Capaian Output)');
  const body=list.map((r,i)=>[i+1,r.kode,r.nama||'-',r.kppn||'-',r.ro,r.konfBlank,'Belum Kirim CAPUT']);
  commonTable(doc,['No','Kode','Nama Satker','KPPN','Jumlah RO','RO Belum Status','Status'],body,null,{0:{halign:'center',cellWidth:9},4:{halign:'center'},5:{halign:'center'}});
  pdfFinish(doc,W);doc.save('Belum_Kirim_CAPUT_bln'+d.bln+'.pdf');
